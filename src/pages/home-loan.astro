---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Navigation/Breadcrumbs.astro';
import EMICalculator from '../components/Finance/EMICalculator';
import FAQAccordion from '../components/FAQ/FAQAccordion.astro';
import ReraVerificationCard from '../components/Trust/ReraVerificationCard.astro';

export const prerender = true;

const approvedBanks = [
  { name: "State Bank of India", badge: "Preferred Nationalized Lender", rate: "8.35%*", tenure: "Up to 30 Years" },
  { name: "HDFC Bank", badge: "Fast-Track Digital Sanction", rate: "8.40%*", tenure: "Up to 30 Years" },
  { name: "ICICI Bank", badge: "Instant Online Processing", rate: "8.45%*", tenure: "Up to 30 Years" },
  { name: "Axis Bank", badge: "Special Tech Professional Scheme", rate: "8.50%*", tenure: "Up to 30 Years" },
  { name: "Bank of Baroda", badge: "Lowest Processing Fee", rate: "8.40%*", tenure: "Up to 30 Years" },
  { name: "Kotak Mahindra Bank", badge: "HNI Priority Processing", rate: "8.55%*", tenure: "Up to 25 Years" }
];

const taxBenefits = [
  {
    section: "Section 24(b)",
    title: "Interest Repayment Deduction",
    limit: "Up to ₹2,00,000 / Year",
    description: "Deduct up to ₹2 Lakhs annually on the interest component of your home loan for a self-occupied residential property."
  },
  {
    section: "Section 80C",
    title: "Principal Repayment Deduction",
    limit: "Up to ₹1,50,000 / Year",
    description: "Claim tax deduction on the principal repayment amount along with stamp duty and registration charges under the Section 80C umbrella."
  },
  {
    section: "Joint Home Loan",
    title: "Dual Co-Borrower Advantage",
    limit: "Up to ₹7,00,000 / Year Combined",
    description: "When co-borrowing with a spouse, both applicants can claim individual deductions (up to ₹4 Lakhs on interest + ₹3 Lakhs on principal)."
  }
];

const homeLoanFaqs = [
  {
    question: "Which major banks have approved Mantra Meridian Riverside Balewadi?",
    answer: "Mantra Meridian Riverside is pre-approved for home loans by all major nationalized and private banking institutions, including State Bank of India (SBI), HDFC Bank, ICICI Bank, Axis Bank, Bank of Baroda, and Kotak Mahindra Bank. Approved Project Financial (APF) numbers are available through our dedicated loan desk."
  },
  {
    question: "What is the maximum loan-to-value (LTV) ratio available for flats in Balewadi?",
    answer: "As per Reserve Bank of India (RBI) guidelines: Loans up to ₹30 Lakhs receive up to 90% LTV; loans between ₹30 Lakhs and ₹75 Lakhs receive up to 80% LTV; loans above ₹75 Lakhs receive up to 75% LTV. Buyers can secure flexible funding based on income eligibility and credit profile."
  },
  {
    question: "Can NRIs apply for home loans for Mantra Meridian Riverside?",
    answer: "Yes. Leading banks (SBI, HDFC, ICICI) extend specialized NRI home loan products for Indian expatriates residing in the UAE, USA, UK, Singapore, and Europe, with repayment permitted through NRE or NRO accounts."
  },
  {
    question: "Does Mantra Properties assist buyers with home loan documentation?",
    answer: "Yes. Our in-house Banking & Financial Advisory Desk manages end-to-end processing: document collection, bank coordination, legal search reporting, APF linkage, and fastest loan sanction approval without additional charges."
  }
];

const homeLoanSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FinancialService",
      "@id": "https://mantrameridianriverside.com/home-loan/#service",
      "name": "Mantra Meridian Riverside Home Loan Advisory Desk",
      "description": "Pre-approved banking partnerships, loan eligibility assistance, and EMI calculation for Mantra Meridian Balewadi.",
      "telephone": "+91 20 6708 2699",
      "areaServed": "IN"
    }
  ]
};
---

<BaseLayout
  title="Home Loan & Bank Approvals | Mantra Meridian Riverside Balewadi"
  description="Approved banks (SBI, HDFC, ICICI), APF details, home loan tax benefits (Sec 24 & 80C), and interactive EMI calculator for Mantra Meridian Balewadi Pune."
  keywords="Mantra Meridian home loan, approved banks Mantra Meridian Balewadi, SBI pre approved projects Balewadi, home loan EMI calculator Pune, Section 24 home loan tax benefit"
  customSchema={homeLoanSchema}
>
  <div class="pt-32 pb-24 px-6 md:px-12 max-w-7xl mx-auto space-y-16">
    
    <Breadcrumbs items={[{ name: "Home Loan & Bank Approvals" }]} />

    {/* Hero Header */}
    <div class="max-w-3xl space-y-4">
      <span class="label-architectural text-xs text-champagne">FINANCIAL ADVISORY • TIER-1 BANK APF</span>
      <h1 class="font-serif text-5xl sm:text-7xl text-architectural-white font-normal leading-tight">
        Home Loan Desk.<br />
        <span class="text-champagne font-light italic font-serif">Pre-Approved Capital Partnerships.</span>
      </h1>
      <p class="text-xs sm:text-sm text-concrete leading-relaxed">
        Secure preferential home loan interest rates, accelerated single-window sanctions, and dedicated banking desk assistance across India’s leading financial institutions.
      </p>
    </div>

    {/* Approved Banks Grid */}
    <div class="space-y-6">
      <div class="border-b border-white/10 pb-4">
        <span class="label-architectural text-xs text-champagne">INSTITUTIONAL TRUST</span>
        <h2 class="font-serif text-3xl md:text-4xl text-architectural-white mt-1">Approved Banking Institutions</h2>
        <p class="text-xs text-concrete/80 mt-1">Pre-cleared project titles ensuring rapid disbursement and minimal paperwork.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {approvedBanks.map((bank) => (
          <div class="p-6 bg-obsidian-card border border-white/10 space-y-4 hover:border-champagne/40 transition-colors">
            <div class="flex justify-between items-start">
              <h3 class="font-serif text-xl text-architectural-white">{bank.name}</h3>
              <span class="text-[9px] font-mono uppercase px-2 py-0.5 bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                Approved
              </span>
            </div>
            <p class="text-xs text-champagne font-mono">{bank.badge}</p>
            <div class="pt-3 border-t border-white/5 flex justify-between text-xs font-mono text-concrete/70">
              <span>Indicative Rate: <strong class="text-architectural-white">{bank.rate}</strong></span>
              <span>{bank.tenure}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* Standalone Interactive EMI Calculator */}
    <div class="space-y-6">
      <div class="border-b border-white/10 pb-4">
        <span class="label-architectural text-xs text-champagne">INTERACTIVE VALUATION</span>
        <h2 class="font-serif text-3xl md:text-4xl text-architectural-white mt-1">Loan EMI &amp; Amortization Calculator</h2>
        <p class="text-xs text-concrete/80 mt-1">Simulate your monthly outflows across customizable loan amounts and tenure horizons.</p>
      </div>
      <EMICalculator client:load />
    </div>

    {/* Section: Tax Deductions & Co-Borrower Strategies */}
    <div class="space-y-8">
      <div class="border-b border-white/10 pb-4">
        <span class="label-architectural text-xs text-champagne">FISCAL OPTIMIZATION</span>
        <h2 class="font-serif text-3xl md:text-4xl text-architectural-white mt-1">Tax Incentives on Residential Acquisition</h2>
        <p class="text-xs text-concrete/80 mt-1">Maximize your post-tax returns under the Indian Income Tax Act 1961.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {taxBenefits.map((tax) => (
          <div class="p-6 bg-obsidian-card border border-white/10 space-y-3">
            <span class="text-xs font-mono text-champagne uppercase tracking-widest">{tax.section}</span>
            <h3 class="font-serif text-lg text-architectural-white">{tax.title}</h3>
            <span class="block font-mono text-sm text-emerald-400 font-semibold">{tax.limit}</span>
            <p class="text-xs text-concrete/80 leading-relaxed">{tax.description}</p>
          </div>
        ))}
      </div>
    </div>

    {/* Pre-Approval Consultation CTA */}
    <div class="p-8 md:p-12 bg-gradient-to-r from-obsidian-card via-obsidian-deep to-obsidian-card border border-champagne/30 flex flex-col lg:flex-row items-center justify-between gap-8">
      <div class="space-y-3 max-w-2xl">
        <span class="label-architectural text-xs text-champagne">LOAN ELIGIBILITY DESK</span>
        <h3 class="font-serif text-2xl md:text-3xl text-architectural-white">
          Check Your Pre-Approved Sanction Limit
        </h3>
        <p class="text-xs text-concrete/80 leading-relaxed">
          Connect with our dedicated banking relationship managers to evaluate your income eligibility, APF fast-track status, and bespoke rate concessions.
        </p>
      </div>
      <div class="shrink-0 flex flex-col sm:flex-row gap-4">
        <a
          href="https://wa.me/912067082699?text=Hello%20Mantra%20Meridian%20Banking%20Desk%2C%20I%20would%20like%20to%20check%20my%20home%20loan%20eligibility%20and%20APF%20details."
          target="_blank"
          rel="noopener noreferrer"
          class="btn-luxury text-xs px-6 py-3 whitespace-nowrap flex items-center gap-2"
        >
          <span>CONNECT WITH BANKING DESK</span>
          <span>↗</span>
        </a>
        <a href="/mantra-meridian-riverside/price/" class="btn-luxury-outline text-xs px-6 py-3 whitespace-nowrap">
          ITEMIZED COST SHEET
        </a>
      </div>
    </div>

    {/* Frequently Asked Questions */}
    <div class="space-y-6 pt-6">
      <div class="border-b border-white/10 pb-4">
        <span class="label-architectural text-xs text-champagne">FAQ &amp; ADVISORY</span>
        <h2 class="font-serif text-3xl text-architectural-white mt-1">Home Loan Inquiries</h2>
      </div>
      <FAQAccordion customFaqs={homeLoanFaqs} />
    </div>

    {/* MahaRERA Compliance */}
    <ReraVerificationCard />

  </div>
</BaseLayout>
