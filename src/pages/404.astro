---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projectData } from '../data/project';

export const prerender = true;
---

<BaseLayout
  title="Page Not Found (404) | Mantra Meridian Riverside Balewadi"
  description="The architectural page you are looking for has been relocated or does not exist. Explore luxury 2, 3, 4 BHK residences at Mantra Meridian Riverside Balewadi."
>
  <section class="min-h-[80vh] flex items-center justify-center pt-28 pb-20 px-6 md:px-12 relative overflow-hidden bg-obsidian-deep">
    
    {/* Subtle Background Glow */}
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-champagne/5 rounded-full blur-3xl pointer-events-none -z-10" />

    <div class="max-w-3xl mx-auto text-center space-y-8">
      
      {/* 404 Code Badge */}
      <div class="glass-pill inline-flex items-center gap-2.5 px-4 py-1.5 border border-champagne/40 text-champagne shadow-glow">
        <span class="w-2 h-2 rounded-full bg-champagne animate-pulse" />
        <span class="label-architectural text-[11px] tracking-[0.22em] text-champagne font-mono">
          ERROR CODE 404 • ARCHITECTURAL ROUTE UNCHARTED
        </span>
      </div>

      <div class="space-y-3">
        <h1 class="font-display text-6xl sm:text-8xl md:text-9xl text-gradient-pearl font-normal leading-none tracking-tight">
          404
        </h1>
        <p class="font-serif text-2xl sm:text-3xl text-champagne-light italic font-light">
          The Requested Sanctuary Could Not Be Found.
        </p>
        <p class="text-xs sm:text-sm text-concrete max-w-xl mx-auto leading-relaxed pt-2">
          The link you followed may have been updated or relocated. You can navigate back to our primary residential formats, architectural blueprints, or connect with our concierge desk.
        </p>
      </div>

      {/* Quick Navigation Portfolio */}
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-4 text-left">
        <a
          href="/mantra-meridian-riverside/residences"
          class="p-4 bg-obsidian-card border border-white/10 hover:border-champagne/50 transition-all group"
        >
          <span class="text-[10px] font-mono text-champagne block uppercase tracking-wider">01. FORMATS</span>
          <span class="font-serif text-sm text-architectural-white group-hover:text-champagne-light transition-colors">Residences &amp; Duplexes</span>
        </a>
        <a
          href="/mantra-meridian-riverside/floor-plans"
          class="p-4 bg-obsidian-card border border-white/10 hover:border-champagne/50 transition-all group"
        >
          <span class="text-[10px] font-mono text-champagne block uppercase tracking-wider">02. BLUEPRINTS</span>
          <span class="font-serif text-sm text-architectural-white group-hover:text-champagne-light transition-colors">Floor Plans</span>
        </a>
        <a
          href="/mantra-meridian-riverside/price"
          class="p-4 bg-obsidian-card border border-white/10 hover:border-champagne/50 transition-all group"
        >
          <span class="text-[10px] font-mono text-champagne block uppercase tracking-wider">03. COMMERCIAL</span>
          <span class="font-serif text-sm text-architectural-white group-hover:text-champagne-light transition-colors">Pricing &amp; Cost Sheet</span>
        </a>
        <a
          href="/mantra-meridian-riverside/amenities"
          class="p-4 bg-obsidian-card border border-white/10 hover:border-champagne/50 transition-all group"
        >
          <span class="text-[10px] font-mono text-champagne block uppercase tracking-wider">04. LIFESTYLE</span>
          <span class="font-serif text-sm text-architectural-white group-hover:text-champagne-light transition-colors">30+ Amenity Atlas</span>
        </a>
        <a
          href="/mantra-meridian-riverside/location"
          class="p-4 bg-obsidian-card border border-white/10 hover:border-champagne/50 transition-all group"
        >
          <span class="text-[10px] font-mono text-champagne block uppercase tracking-wider">05. CORRIDOR</span>
          <span class="font-serif text-sm text-architectural-white group-hover:text-champagne-light transition-colors">Location Intelligence</span>
        </a>
        <a
          href="/balewadi"
          class="p-4 bg-obsidian-card border border-white/10 hover:border-champagne/50 transition-all group"
        >
          <span class="text-[10px] font-mono text-champagne block uppercase tracking-wider">06. MICROMARKET</span>
          <span class="font-serif text-sm text-architectural-white group-hover:text-champagne-light transition-colors">Balewadi Guide</span>
        </a>
      </div>

      {/* Primary Action Buttons */}
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
        <a
          href="/"
          class="w-full sm:w-auto px-7 py-3 text-xs tracking-[0.16em] uppercase font-bold bg-champagne text-obsidian hover:bg-champagne-light transition-all shadow-glow"
        >
          Return to Sanctuary Home
        </a>
        <a
          href={`https://wa.me/${projectData.contact.whatsapp.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(projectData.contact.whatsappEnquiryText)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-7 py-3 text-xs tracking-[0.16em] uppercase font-bold border border-champagne/40 text-champagne hover:bg-champagne/10 transition-all flex items-center justify-center gap-2"
        >
          <span>Chat with Concierge</span>
          <span>↗</span>
        </a>
      </div>

    </div>
  </section>
</BaseLayout>
