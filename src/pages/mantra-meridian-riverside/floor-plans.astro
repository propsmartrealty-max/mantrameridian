---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FloorPlanViewer from '../../components/FloorPlan/FloorPlanViewer';
import ReraVerificationCard from '../../components/Trust/ReraVerificationCard.astro';
import FAQAccordion from '../../components/FAQ/FAQAccordion.astro';
import Breadcrumbs from '../../components/Navigation/Breadcrumbs.astro';
import { residencesData } from '../../data/residences';
import { floorPlanKeywords } from '../../data/keywords';

export const prerender = true;

const floorPlanSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      "name": "Mantra Meridian Riverside Sanctioned Floor Plans & Layouts",
      "numberOfItems": residencesData.length,
      "itemListElement": residencesData.map((res, idx) => ({
        "@type": "FloorPlan",
        "position": idx + 1,
        "@id": `https://mantrameridianriverside.com/mantra-meridian-riverside/${res.slug}/#floorplan`,
        "name": `${res.name} Architectural Floor Plan`,
        "description": res.overview,
        "numberOfBedrooms": res.type,
        "numberOfBathroomsTotal": res.bathrooms,
        "floorSize": {
          "@type": "QuantitativeValue",
          "value": res.carpetAreaRange,
          "unitCode": "FTK"
        },
        "layoutImage": "https://mantrameridianriverside.com/assets/mantra-meridian-hero.webp",
        "amenityFeature": res.architecturalHighlights.map((h) => ({
          "@type": "LocationFeatureSpecification",
          "name": h,
          "value": true
        })),
        "offers": {
          "@type": "Offer",
          "price": res.slug === '2-bhk' ? '8500000' : res.slug === '3-bhk' ? '12800000' : res.slug === '3-bhk-duplex' ? '18500000' : '24000000',
          "priceCurrency": "INR",
          "availability": "https://schema.org/InStock",
          "url": `https://mantrameridianriverside.com/mantra-meridian-riverside/${res.slug}/`
        }
      }))
    }
  ]
};
---

<BaseLayout
  title="Floor Plans & Unit Layouts | Mantra Meridian Riverside Balewadi"
  description="Explore official architectural floor plans & sanctioned MahaRERA unit layouts for 2, 3, 4 BHK & 3 BHK Duplex residences at Mantra Meridian Riverside, Balewadi."
  keywords={floorPlanKeywords}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(floorPlanSchema)} />
  <div class="pt-32 pb-24 px-6 md:px-12 max-w-7xl mx-auto space-y-16">
    
    <Breadcrumbs items={[{ name: "Floor Plans" }]} />

    <div class="max-w-3xl space-y-4">
      <span class="label-architectural text-xs text-champagne">ARCHITECTURAL BLUEPRINTS</span>
      <h1 class="font-serif text-5xl sm:text-7xl text-architectural-white font-normal leading-tight">
        Mantra Meridian Floor Plans &amp;<br />
        <span class="text-champagne font-light italic">Sanctioned Unit Layouts.</span>
      </h1>
      <p class="text-xs sm:text-sm text-concrete leading-relaxed">
        Spacious 2, 3 and 4 BHK residences and exclusive 3 BHK duplex apartments nestled along the Mula River. Explore interactive architectural room dimensions and official MahaRERA sanctioned unit plans.
      </p>
    </div>

    {/* Interactive Floor Plan Viewer Island */}
    <FloorPlanViewer client:load defaultResidenceId="3bhk" />

    {/* Statutory RERA Notice */}
    <ReraVerificationCard />

    {/* FAQ */}
    <div class="space-y-6">
      <div>
        <span class="label-architectural text-xs text-champagne">MEASUREMENT QUESTIONS</span>
        <h2 class="font-serif text-3xl text-architectural-white mt-1">Floor Plan FAQs</h2>
      </div>
      <FAQAccordion category="configurations" />
    </div>

  </div>
</BaseLayout>
