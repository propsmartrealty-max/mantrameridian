---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CinematicHero from '../../components/Hero/CinematicHero.astro';
import ArchitecturalDataStrip from '../../components/Stats/ArchitecturalDataStrip.astro';
import ProjectSnapshotMatrix from '../../components/Project/ProjectSnapshotMatrix.astro';
import RiversideManifesto from '../../components/Story/RiversideManifesto.astro';
import RiversideExperience from '../../components/Riverside/RiversideExperience.astro';
import FloorPlanViewer from '../../components/FloorPlan/FloorPlanViewer';
import AmenityAtlas from '../../components/Amenity/AmenityAtlas';
import LocationIntelligence from '../../components/Location/LocationIntelligence';
import ReraVerificationCard from '../../components/Trust/ReraVerificationCard.astro';
import FAQAccordion from '../../components/FAQ/FAQAccordion.astro';
import ClientReviews from '../../components/Reviews/ClientReviews.astro';
import Breadcrumbs from '../../components/Navigation/Breadcrumbs.astro';
import EMICalculator from '../../components/Finance/EMICalculator';
import { residencesData } from '../../data/residences';
import { defaultMetaKeywords } from '../../data/keywords';
import { aggregateRatingData } from '../../data/reviews';

export const prerender = true;

const pageKeywords = [
  "Mantra Meridian Riverside",
  "Mantra Meridian Riverside Balewadi",
  "Mantra Meridian Riverside Pune",
  "Mantra Riverside Balewadi",
  "Mantra Meridian Balewadi",
  "Mantra Balewadi",
  "Mantra Riverside",
  "Mantra Properties Balewadi",
  "Luxury flats Balewadi Pune",
  "2 BHK Balewadi",
  "3 BHK Balewadi",
  "4 BHK Balewadi",
  "Riverfront apartments Pune",
  "Mula River apartments Balewadi",
  "Luxury apartments West Pune",
  ...defaultMetaKeywords,
];

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://mantrameridianriverside.com/mantra-meridian-riverside/#webpage",
      "url": "https://mantrameridianriverside.com/mantra-meridian-riverside/",
      "name": "Mantra Meridian Riverside — Official Project Portal | Balewadi, Pune",
      "isPartOf": { "@id": "https://mantrameridianriverside.com/#website" },
      "about": { "@id": "https://mantrameridianriverside.com/#project" },
      "description": "Official portal of Mantra Meridian Riverside — an 8-acre luxury riverfront development in Balewadi, Pune. 2, 3, 4 BHK and Duplex residences from ₹1.29 Cr*. MahaRERA P52100045688.",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mantrameridianriverside.com/" },
          { "@type": "ListItem", "position": 2, "name": "Mantra Meridian Riverside", "item": "https://mantrameridianriverside.com/mantra-meridian-riverside/" }
        ]
      }
    },
    {
      "@type": "ApartmentComplex",
      "@id": "https://mantrameridianriverside.com/#project",
      "name": "Mantra Meridian Riverside",
      "alternateName": [
        "Mantra Meridian Riverside Balewadi",
        "Mantra Riverside Balewadi",
        "Mantra Meridian Balewadi",
        "Mantra Balewadi",
        "MMR Balewadi"
      ],
      "description": "An 8-acre luxury riverfront residential development in Balewadi, Pune, situated along the Mula River. Offering 2 BHK, 3 BHK, 3 BHK Duplex, and 4 BHK premium residences with 500-metre riverside boardwalk, sky duplexes, and world-class amenities.",
      "url": "https://mantrameridianriverside.com/mantra-meridian-riverside/",
      "numberOfRooms": "2, 3, 4 BHK",
      "numberOfBathroomsTotal": "2-4",
      "floorSize": { "@type": "QuantitativeValue", "minValue": 721, "maxValue": 2200, "unitCode": "FTK" },
      "amenityFeature": [
        { "@type": "LocationFeatureSpecification", "name": "500m Riverside Boardwalk", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Infinity Pool", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Sky Clubhouse", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "MahaRERA Approved", "value": true }
      ],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Balewadi, Baner Road",
        "addressLocality": "Balewadi",
        "addressRegion": "Pune",
        "postalCode": "411045",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 18.5679,
        "longitude": 73.7889
      },
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "INR",
        "lowPrice": 12900000,
        "highPrice": 35000000,
        "offerCount": 450,
        "availability": "https://schema.org/InStock"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": aggregateRatingData.ratingValue,
        "reviewCount": aggregateRatingData.reviewCount,
        "bestRating": 5,
        "worstRating": 1
      },
      "identifier": [
        { "@type": "PropertyValue", "name": "MahaRERA", "value": "P52100045688" }
      ],
      "developer": {
        "@type": "Organization",
        "@id": "https://mantrameridianriverside.com/#organization",
        "name": "Mantra Properties"
      }
    }
  ]
};
---

<BaseLayout
  title="Mantra Meridian Riverside | Official Portal | Balewadi Pune | 2, 3, 4 BHK from ₹1.29 Cr*"
  description="Mantra Meridian Riverside is an 8-acre luxury riverfront development in Balewadi, Pune. Explore 2 BHK, 3 BHK, 4 BHK and Duplex residences from ₹1.29 Cr*. 500m riverside boardwalk. MahaRERA P52100045688."
  keywords={pageKeywords}
  customSchema={customSchema}
>
  <div class="pt-28 pb-4 px-6 md:px-12 max-w-7xl mx-auto">
    <Breadcrumbs items={[{ name: "Mantra Meridian Riverside" }]} />
  </div>

  {/* Cinematic Hero */}
  <CinematicHero />

  {/* Architectural Data Strip */}
  <ArchitecturalDataStrip />

  {/* Project Snapshot Factsheet */}
  <ProjectSnapshotMatrix highlightKeyword="Mantra Meridian Riverside" />

  {/* Project Story */}
  <RiversideManifesto />

  {/* Residences Navigator */}
  <section id="residences" class="w-full py-24 bg-obsidian border-b border-white/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12 space-y-12">
      <div class="max-w-2xl space-y-3">
        <span class="label-architectural text-xs text-champagne">CURATED LIVING FORMATS</span>
        <h2 class="font-display text-4xl sm:text-6xl text-architectural-white font-normal leading-tight">
          Residences at<br />
          <span class="text-champagne font-light italic font-serif">Mantra Meridian Riverside.</span>
        </h2>
        <p class="text-sm text-concrete leading-relaxed">
          Choose from 2 BHK, 3 BHK, 3 BHK Sky Duplex, and 4 BHK riverfront residences — each crafted for maximum light, air, and panoramic Mula River views.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {residencesData.map((res) => (
          <div class="card-beige-luxury border-animated-beam p-6 sm:p-8 flex flex-col justify-between space-y-6">
            <div class="space-y-4">
              <div class="relative aspect-[16/10] overflow-hidden">
                <img
                  src={res.renderImage}
                  alt={`${res.name} at Mantra Meridian Riverside Balewadi`}
                  class="w-full h-full object-cover brightness-95 hover:scale-105 transition-transform duration-700"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute top-3 left-3 badge-beige font-mono text-[10px]">{res.type}</div>
                <div class="absolute bottom-3 right-3 badge-beige font-mono text-xs text-champagne">{res.carpetAreaRange}</div>
              </div>
              <h3 class="font-serif text-2xl text-architectural-white">{res.name}</h3>
              <p class="text-xs text-concrete leading-relaxed">{res.subtitle}</p>
            </div>
            <div class="pt-4 border-t border-white/10 flex items-center justify-between">
              <span class="text-xs font-mono text-champagne">{res.balconyType}</span>
              <a href={`/mantra-meridian-riverside/${res.slug}/`} class="btn-luxury text-xs">
                VIEW RESIDENCE →
              </a>
            </div>
          </div>
        ))}
      </div>

      <div class="flex flex-wrap gap-4 pt-4">
        <a href="/mantra-meridian-riverside/floor-plans/" class="btn-luxury text-xs">FLOOR PLANS →</a>
        <a href="/mantra-meridian-riverside/price/" class="btn-luxury-outline text-xs">PRICING & COST SHEET</a>
        <a href="/mantra-meridian-riverside/residences/" class="btn-luxury-outline text-xs">ALL RESIDENCES</a>
      </div>
    </div>
  </section>

  {/* Floor Plans */}
  <section id="floor-plans" class="w-full py-24 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12 space-y-8">
      <div class="max-w-2xl space-y-3">
        <span class="label-architectural text-xs text-champagne">SPATIAL INTELLIGENCE</span>
        <h2 class="font-serif text-3xl sm:text-5xl text-architectural-white font-normal">
          Floor Plans & Configurations
        </h2>
        <p class="text-xs sm:text-sm text-concrete leading-relaxed">
          Precision-engineered layouts optimised for natural light, cross-ventilation, and river views.
        </p>
      </div>
      <FloorPlanViewer client:visible />
      <div class="pt-4">
        <a href="/mantra-meridian-riverside/floor-plans/" class="btn-luxury text-xs">EXPLORE ALL FLOOR PLANS →</a>
      </div>
    </div>
  </section>

  {/* Amenities */}
  <section id="amenities" class="w-full py-24 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12 space-y-8">
      <div class="max-w-2xl space-y-3">
        <span class="label-architectural text-xs text-champagne">RESORT-STYLE LIVING</span>
        <h2 class="font-serif text-3xl sm:text-5xl text-architectural-white font-normal">
          World-Class Amenities
        </h2>
      </div>
      <AmenityAtlas client:visible />
      <div class="pt-4">
        <a href="/mantra-meridian-riverside/amenities/" class="btn-luxury text-xs">ALL AMENITIES →</a>
      </div>
    </div>
  </section>

  {/* Riverside Experience */}
  <div id="riverside">
    <RiversideExperience />
  </div>

  {/* Location */}
  <section id="location" class="w-full py-24 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12 space-y-8">
      <div class="max-w-2xl space-y-3">
        <span class="label-architectural text-xs text-champagne">STRATEGIC LOCATION</span>
        <h2 class="font-serif text-3xl sm:text-5xl text-architectural-white font-normal">
          Balewadi — The New Centre of West Pune
        </h2>
        <p class="text-xs sm:text-sm text-concrete leading-relaxed">
          12 min to Hinjewadi IT Park · 8 min to Baner · 18 min to Pune Airport · NH-48 access
        </p>
      </div>
      <LocationIntelligence client:visible />
      <div class="pt-4">
        <a href="/mantra-meridian-riverside/location/" class="btn-luxury text-xs">FULL LOCATION MAP →</a>
      </div>
    </div>
  </section>

  {/* EMI Calculator */}
  <section id="emi" class="w-full py-24 bg-obsidian border-b border-white/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12 space-y-8">
      <div class="max-w-2xl space-y-3">
        <span class="label-architectural text-xs text-champagne">FINANCIAL PLANNING</span>
        <h2 class="font-serif text-3xl sm:text-5xl text-architectural-white font-normal">
          EMI Calculator
        </h2>
        <p class="text-xs sm:text-sm text-concrete leading-relaxed">
          Starting from ₹1.29 Cr* — estimate your monthly EMI instantly.
        </p>
      </div>
      <EMICalculator client:visible />
      <div class="pt-4">
        <a href="/mantra-meridian-riverside/price/" class="btn-luxury text-xs">VIEW FULL PRICING →</a>
      </div>
    </div>
  </section>

  {/* Reviews */}
  <ClientReviews />

  {/* MahaRERA */}
  <ReraVerificationCard />

  {/* FAQs */}
  <FAQAccordion />

  {/* Quick Navigation Hub */}
  <section class="w-full py-20 border-t border-white/10 bg-obsidian">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="max-w-2xl mb-10 space-y-2">
        <span class="label-architectural text-xs text-champagne">NAVIGATE THE PROJECT</span>
        <h2 class="font-serif text-3xl text-architectural-white font-normal">Explore Mantra Meridian Riverside</h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
        {[
          { label: "Price List", href: "/mantra-meridian-riverside/price/" },
          { label: "Floor Plans", href: "/mantra-meridian-riverside/floor-plans/" },
          { label: "Residences", href: "/mantra-meridian-riverside/residences/" },
          { label: "Gallery", href: "/mantra-meridian-riverside/gallery/" },
          { label: "Amenities", href: "/mantra-meridian-riverside/amenities/" },
          { label: "Masterplan", href: "/mantra-meridian-riverside/masterplan/" },
          { label: "Location", href: "/mantra-meridian-riverside/location/" },
          { label: "RERA", href: "/mantra-meridian-riverside/rera/" },
          { label: "2 BHK", href: "/mantra-meridian-riverside/2-bhk/" },
          { label: "3 BHK", href: "/mantra-meridian-riverside/3-bhk/" },
          { label: "3 BHK Duplex", href: "/mantra-meridian-riverside/3-bhk-duplex/" },
          { label: "4 BHK", href: "/mantra-meridian-riverside/4-bhk/" },
        ].map((link) => (
          <a
            href={link.href}
            class="card-beige-luxury p-4 text-center text-xs font-mono text-champagne tracking-widest uppercase hover:bg-champagne/10 transition-colors"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
