---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LocationIntelligence from '../../components/Location/LocationIntelligence';
import InfrastructureGrowthRadar from '../../components/Location/InfrastructureGrowthRadar.astro';
import Breadcrumbs from '../../components/Navigation/Breadcrumbs.astro';
import { locationDestinations } from '../../data/location';
import { locationKeywordsList } from '../../data/keywords';

export const prerender = true;
---

<BaseLayout
  title="Mantra Riverside Balewadi Location | Mantra Meridian Balewadi Connectivity Radar"
  description="Exact location intelligence for Mantra Riverside Balewadi and Mantra Meridian Balewadi. Situated along Mula River, 5 mins from Balewadi High Street, planned Wakad bridge & Hinjewadi IT Park."
  keywords={locationKeywordsList}
>
  <div class="pt-32 pb-24 px-6 md:px-12 max-w-7xl mx-auto space-y-16">
    
    <Breadcrumbs items={[{ name: "Mantra Riverside Balewadi Location" }]} />

    <div class="max-w-3xl space-y-4">
      <span class="label-architectural text-xs text-champagne">WEST PUNE CONNECTIVITY • MANTRA RIVERSIDE BALEWADI</span>
      <h1 class="font-serif text-5xl sm:text-7xl text-architectural-white font-normal leading-tight">
        Mantra Riverside Balewadi.<br />
        <span class="text-champagne font-light italic">Mantra Meridian Location Radar.</span>
      </h1>
      <p class="text-xs sm:text-sm text-concrete leading-relaxed">
        Nestled along Balewadi Village Road steps away from the Mula River. Mantra Meridian Balewadi and Mantra Riverside is an 8-acre premium development situated 5 minutes from Balewadi High Street, close to the proposed metro, and seamlessly linked to Wakad via a planned bridge.
      </p>
    </div>

    {/* Location Intelligence Interactive Map Island */}
    <LocationIntelligence client:load />

    {/* Complete Connectivity Grid */}
    <div class="space-y-8">
      <div class="border-b border-white/10 pb-4">
        <span class="label-architectural text-xs text-champagne">VERIFIED TRANSIT MATRIX</span>
        <h2 class="font-serif text-3xl text-architectural-white mt-1">Distances &amp; Travel Times</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {locationDestinations.map((dest) => (
          <div class="p-5 bg-obsidian-card border border-white/10 space-y-3">
            <div class="flex items-center justify-between">
              <span class="label-architectural text-[9px] text-champagne">{dest.categoryLabel}</span>
              <span class="text-xs font-mono text-champagne font-semibold">{dest.driveTimeMins}</span>
            </div>
            <h3 class="font-serif text-lg text-architectural-white">{dest.name}</h3>
            <p class="text-xs text-concrete/80 leading-relaxed">{dest.description}</p>
            <div class="pt-3 border-t border-white/5 flex items-center justify-between text-[10px] font-mono text-concrete/60">
              <span>Distance: {dest.distanceKm}</span>
              <span>Updated: {dest.lastUpdated}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* Transformational Infrastructure & Appreciation Radar */}
    <InfrastructureGrowthRadar />

  </div>
</BaseLayout>
