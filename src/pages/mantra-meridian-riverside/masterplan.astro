---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MasterplanExplorer from '../../components/Masterplan/MasterplanExplorer';
import ReraVerificationCard from '../../components/Trust/ReraVerificationCard.astro';
import Breadcrumbs from '../../components/Navigation/Breadcrumbs.astro';
import { masterplanZones } from '../../data/masterplan';
import { masterplanKeywords } from '../../data/keywords';

export const prerender = true;

const masterplanSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Place",
      "@id": "https://mantrameridianriverside.com/mantra-meridian-riverside/masterplan/#estate",
      "name": "Mantra Meridian Riverside 8-Acre Masterplan",
      "description": "Comprehensive 8-acre riverside masterplan featuring 4 iconic towers, 75%+ open green spaces, 20,000 sq.ft. clubhouse, and 500m Mula river promenade in Balewadi, Pune.",
      "hasMap": "https://mantrameridianriverside.com/mantra-meridian-riverside/masterplan/",
      "containsPlace": masterplanZones.map((zone) => ({
        "@type": "Place",
        "name": zone.name,
        "description": `${zone.tagline}. Category: ${zone.category}`,
        "additionalProperty": {
          "@type": "PropertyValue",
          "name": "Phase Details",
          "value": zone.details.availableUnits || zone.details.completionPhase
        }
      }))
    }
  ]
};
---

<BaseLayout
  title="8-Acre Masterplan & Riverside Layout | Mantra Meridian Riverside Balewadi"
  description="Explore the 8-acre riverside masterplan of Mantra Meridian in Balewadi, Pune. Iconic high-rise towers, 75%+ landscaped open spaces, and 500m Mula promenade."
  keywords={masterplanKeywords}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(masterplanSchema)} />
  <div class="pt-32 pb-24 px-6 md:px-12 max-w-7xl mx-auto space-y-16">
    
    <Breadcrumbs items={[{ name: "8-Acre Masterplan" }]} />

    <div class="max-w-3xl space-y-4">
      <span class="label-architectural text-xs text-champagne">ESTATE BLUEPRINT</span>
      <h1 class="font-serif text-5xl sm:text-7xl text-architectural-white font-normal leading-tight">
        Mantra Meridian 8-Acre<br />
        <span class="text-champagne font-light italic">Riverside Masterplan.</span>
      </h1>
      <p class="text-xs sm:text-sm text-concrete leading-relaxed">
        The masterplan for Mantra Meridian Riverside coordinates four iconic living towers, a 20,000 sq.ft. multi-level clubhouse, tournament sports facilities, and 75%+ open green landscapes along the banks of the Mula river.
      </p>
    </div>

    {/* Masterplan Explorer Island */}
    <MasterplanExplorer client:load />

    {/* Zoning Breakdown */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 pt-6">
      {masterplanZones.slice(0, 4).map((zone) => (
        <div class="p-6 bg-obsidian-card border border-white/10 space-y-3">
          <span class="label-architectural text-[9px] text-champagne">{zone.category.toUpperCase()}</span>
          <h3 class="font-serif text-xl text-architectural-white">{zone.name}</h3>
          <p class="text-xs text-concrete/80 leading-relaxed">{zone.tagline}</p>
          <div class="pt-2 text-[10px] font-mono text-champagne">
            {zone.details.availableUnits || zone.details.completionPhase}
          </div>
        </div>
      ))}
    </div>

    <ReraVerificationCard />

  </div>
</BaseLayout>
