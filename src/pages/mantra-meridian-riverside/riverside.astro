---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RiversideExperience from '../../components/Riverside/RiversideExperience.astro';
import DesignPhilosophy from '../../components/Architecture/DesignPhilosophy.astro';
import Breadcrumbs from '../../components/Navigation/Breadcrumbs.astro';
import { riversideKeywords } from '../../data/keywords';

export const prerender = true;

const riversideSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Place", "Park"],
      "@id": "https://mantrameridianriverside.com/mantra-meridian-riverside/riverside/#riverside-sanctuary",
      "name": "Mantra Riverside — Mula Riverfront Promenade & Boardwalk",
      "description": "500-metre private riverfront boardwalk and biophilic landscaped promenade bordering the Mula River in Balewadi, Pune.",
      "url": "https://mantrameridianriverside.com/mantra-meridian-riverside/riverside/",
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 18.5848136,
        "longitude": 73.7751313
      },
      "amenityFeature": [
        {
          "@type": "LocationFeatureSpecification",
          "name": "500m Riverfront Boardwalk",
          "value": true
        },
        {
          "@type": "LocationFeatureSpecification",
          "name": "Reflexology Zen Pathways",
          "value": true
        },
        {
          "@type": "LocationFeatureSpecification",
          "name": "Riparian Microclimate Buffer Zone",
          "value": true
        }
      ]
    }
  ]
};
---

<BaseLayout
  title="Mantra Riverside Balewadi | Luxury Riverfront Residences by Mantra Properties"
  description="Explore Mantra Riverside Balewadi by Mantra Properties. 8-acre waterfront estate featuring 500m Mula river boardwalk, 2, 3, 4 BHK luxury residences, and green sanctuary views in Balewadi, Pune."
  keywords={riversideKeywords}
  customSchema={riversideSchema}
>
  <div class="pt-32 pb-12 px-6 md:px-12 max-w-7xl mx-auto space-y-16">
    
    <Breadcrumbs items={[{ name: "Mantra Riverside" }]} />

    <div class="max-w-3xl space-y-4">
      <span class="label-architectural text-xs text-champagne">WHERE NATURE MEETS URBAN SOPHISTICATION</span>
      <h1 class="font-serif text-5xl sm:text-7xl text-architectural-white font-normal leading-tight">
        Mantra Riverside Balewadi |<br />
        <span class="text-champagne font-light italic">Luxury Riverfront Residences.</span>
      </h1>
      <p class="text-xs sm:text-sm text-concrete leading-relaxed">
        Nestled steps from the Mula River in Balewadi, Mantra Riverside at Mantra Meridian is an 8-acre premium development designed for those who seek a harmonious blend of natural riparian tranquility and contemporary urban luxury.
      </p>
    </div>
  </div>

  <RiversideExperience />
  <DesignPhilosophy />
</BaseLayout>
