---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQAccordion from '../components/FAQ/FAQAccordion.astro';

export const prerender = true;

const micromarkets = [
  {
    name: "Balewadi",
    role: "The Riverside & High-Street Luxury Sanctuary",
    pros: "Masterplanned 8-acre estates like Meridian, direct river frontage, Balewadi High Street dining, lower commercial congestion.",
    profile: "Ideal for senior corporate leaders, CXOs, and families seeking space and biophilic calm."
  },
  {
    name: "Baner",
    role: "The Corporate & Financial Core",
    pros: "High commercial density, corporate headquarters, extensive retail, rapid highway access.",
    profile: "High energy, higher traffic density, suited for commercial offices and high-density apartments."
  },
  {
    name: "Hinjewadi",
    role: "The Global IT & Tech Engine",
    pros: "400+ multinational tech campuses, massive employment generation, direct access to Pune Expressway.",
    profile: "Predominantly industrial & IT campus environment; tech executives often prefer residing in Balewadi."
  },
  {
    name: "Wakad",
    role: "High-Density Residential Hub",
    pros: "Phoenix Mall of the Millennium, extensive mid-market residential developments, family amenities.",
    profile: "Densely populated residential hub with strong commercial retail."
  }
];
---

<BaseLayout
  title="West Pune Luxury Real Estate Guide | Balewadi, Baner, Hinjewadi | Meridian"
  description="Authoritative guide to West Pune real estate. Compare Balewadi, Baner, Hinjewadi, and Wakad. Why Mantra Meridian Riverside is West Pune's premier address."
  keywords="West Pune real estate, Balewadi vs Baner, luxury flats in West Pune, flats near Hinjewadi, flats in Balewadi, Mantra Meridian Riverside, Wakad bridge Balewadi"
>
  <div class="pt-32 pb-24 px-6 md:px-12 max-w-7xl mx-auto space-y-20">
    
    <div class="max-w-3xl space-y-4">
      <span class="label-architectural text-xs text-champagne">REGIONAL INTELLIGENCE</span>
      <h1 class="font-serif text-5xl sm:text-7xl text-architectural-white font-normal leading-tight">
        The Western Edge<br />
        <span class="text-champagne font-light italic">of Pune.</span>
      </h1>
      <p class="text-xs sm:text-sm text-concrete leading-relaxed">
        West Pune represents India's most dynamic corridor of technology wealth, intellectual capital, and infrastructure expansion. Understand how the interconnected nodes of Balewadi, Baner, and Hinjewadi shape residential value.
      </p>
    </div>

    {/* Regional Corridor Map Card */}
    <div class="p-8 md:p-12 bg-obsidian-card border border-champagne/20 space-y-8">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-white/10 pb-6">
        <div>
          <span class="label-architectural text-xs text-champagne">STRATEGIC CORRIDOR</span>
          <h2 class="font-serif text-3xl text-architectural-white mt-1">The West Pune Golden Triangle</h2>
        </div>
        <span class="text-xs font-mono text-champagne">MUMBAI–BENGALURU CORRIDOR (NH 48)</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {micromarkets.map((m) => (
          <div class="p-5 bg-obsidian-surface border border-white/10 space-y-3">
            <span class="font-serif text-2xl text-architectural-white">{m.name}</span>
            <div class="text-xs text-champagne font-mono">{m.role}</div>
            <p class="text-xs text-concrete/80 leading-relaxed pt-1">{m.pros}</p>
            <div class="pt-3 border-t border-white/5 text-[11px] text-concrete/60 font-mono">
              {m.profile}
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* Editorial Comparison: Baner vs Balewadi */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-6 space-y-6">
        <span class="label-architectural text-xs text-champagne">COMPARATIVE ANALYSIS</span>
        <h2 class="font-serif text-4xl text-architectural-white leading-tight">
          Balewadi vs Baner:<br />
          Where Should Luxury Homebuyers Invest?
        </h2>
        <p class="text-xs sm:text-sm text-concrete leading-relaxed">
          While Baner developed early as West Pune's commercial pioneer, it has reached severe land constraints and vehicular saturation. Balewadi has succeeded it as the luxury residential destination of choice, offering large 8-acre parcels, 75%+ open green spaces, and rare riverfront frontages at developments like Mantra Meridian Riverside.
        </p>
        <div class="pt-2">
          <a href="/meridian/residences" class="btn-luxury text-xs">
            VIEW MERIDIAN RESIDENCES →
          </a>
        </div>
      </div>

      <div class="lg:col-span-6 overflow-hidden border border-white/10 shadow-luxury aspect-[4/3]">
        <img
          src="https://www.mantraproperties.in/assets/images/properties/mantra-meridian-gallery-106076887.webp"
          alt="Mantra Meridian Riverside West Pune Architecture"
          class="w-full h-full object-cover"
        />
      </div>
    </div>

    {/* Frequently Asked Questions */}
    <div class="space-y-6">
      <div>
        <span class="label-architectural text-xs text-champagne">WEST PUNE QUESTIONS</span>
        <h2 class="font-serif text-3xl text-architectural-white mt-1">Regional Real Estate FAQs</h2>
      </div>
      <FAQAccordion limit={6} />
    </div>

  </div>
</BaseLayout>
