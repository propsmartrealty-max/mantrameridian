---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Navigation/Breadcrumbs.astro';
import FAQAccordion from '../components/FAQ/FAQAccordion.astro';
import ReraVerificationCard from '../components/Trust/ReraVerificationCard.astro';
import { brandPermutations } from '../data/keywords';

export const prerender = true;

interface HubCategory {
  title: string;
  tagline: string;
  badge: string;
  items: {
    title: string;
    href: string;
    description: string;
    meta: string;
    highlight?: boolean;
  }[];
}

const directoryCategories: HubCategory[] = [
  {
    title: "01. Typologies & Sky Mansions",
    tagline: "Ultra-luxury riverfront residences engineered with acoustic isolation and volumetric height",
    badge: "LIVING SPACES",
    items: [
      {
        title: "2 BHK Contemporary Riverside Residences",
        href: "/mantra-meridian-riverside/2-bhk/",
        description: "815 sq.ft. carpet area featuring zero-dead-space ergonomics, cross-ventilated living salon, and private river sundeck.",
        meta: "From ₹1.29 Cr* • Balewadi Riverfront"
      },
      {
        title: "3 BHK Premium Riverside Residences",
        href: "/mantra-meridian-riverside/3-bhk/",
        description: "1,180 sq.ft. carpet area with master suite isolation, expansive kitchen realm, and wide waterfront verandas.",
        meta: "From ₹1.75 Cr* • Prime Waterfront View"
      },
      {
        title: "Signature 3 BHK Sky Duplexes",
        href: "/duplex/",
        description: "1,660 sq.ft. duplex format with dramatic 20-foot vertical ceiling void, cantilevered floating stair, and dual living tiers.",
        meta: "From ₹2.25 Cr* • 20-Ft Ceiling Grandeur",
        highlight: true
      },
      {
        title: "4 BHK Grand Riverside Estates",
        href: "/mantra-meridian-riverside/4-bhk/",
        description: "2,050 sq.ft. carpet area boasting dual master suites, private elevator foyer, staff quarters, and 270-degree panorama.",
        meta: "From ₹2.85 Cr* • Ultra-Spacious Sanctuary"
      },
      {
        title: "Penthouse & Sky Villa Collection",
        href: "/penthouse/",
        description: "1,660 to 2,180 sq.ft. apex penthouses occupying the topmost residential tiers with wrap-around entertainer terraces.",
        meta: "From ₹2.25 Cr* – ₹3.50 Cr*+ • Top Tier Living",
        highlight: true
      },
      {
        title: "Complete Architectural Floor Plans",
        href: "/mantra-meridian-riverside/floor-plans/",
        description: "High-resolution downloadable floor plan blueprints for every 2, 3, 3 Duplex, and 4 BHK unit configuration.",
        meta: "All Configurations • Sanctioned Dimensions"
      }
    ]
  },
  {
    title: "02. Micro-Market & Growth Corridors",
    tagline: "Macroeconomic drivers, capital escalation indexes, and rental yields in West Pune",
    badge: "CORRIDOR INTELLIGENCE",
    items: [
      {
        title: "Balewadi Real Estate Hub",
        href: "/balewadi/",
        description: "Comprehensive micromarket dossier: 2020-2028 price escalations, rental yields of 4.2-4.8%, and High Street retail pulse.",
        meta: "₹9,800 - ₹13,500/sqft • High Capital Velocity",
        highlight: true
      },
      {
        title: "Hinjewadi Tech Executive Corridor",
        href: "/hinjewadi/",
        description: "Strategic commute corridor guide: 12 minutes (7.8 km) to Rajiv Gandhi Infotech Park Phase 1 via proposed Wakad bridge.",
        meta: "12 Mins Commute • Tech Leadership Housing"
      },
      {
        title: "Baner Luxury Upgrade Guide",
        href: "/baner/",
        description: "Comparative migration analysis: why Baner residents are transitioning to Balewadi's 8-acre continuous riverfront acreage.",
        meta: "3.5 km Distance • Low Density Alternative"
      },
      {
        title: "Mahalunge Hi-Tech Corridor",
        href: "/mahalunge/",
        description: "Boutique waterfront serenity versus dense 100-acre mega-townships along the Mula River corridor.",
        meta: "Boutique vs Mega-Township • June 2028 Handover"
      },
      {
        title: "West Pune Luxury Corridor Analysis",
        href: "/west-pune/",
        description: "Macro-regional synthesis covering the Baner-Balewadi-Hinjewadi golden economic triangle and infrastructure catalysts.",
        meta: "Regional Overview • Infrastructure Catalysts"
      },
      {
        title: "Pune Citywide Real Estate Index",
        href: "/pune-real-estate/",
        description: "Citywide benchmark contrasting West Pune capital trends with East Pune (Kharadi/Kalyani Nagar) and Central Pune.",
        meta: "Citywide Analysis • Appreciation Trends"
      }
    ]
  },
  {
    title: "03. Financial Architecture & Global Advisory",
    tagline: "Transparent pricing models, all-inclusive cost sheet breakdowns, and international NRI support",
    badge: "FINANCIAL TOOLS",
    items: [
      {
        title: "Price & All-Inclusive Cost Sheet",
        href: "/mantra-meridian-riverside/price/",
        description: "Interactive real-time cost sheet estimator computing base price, stamp duty (7%), registration, and GST schedules.",
        meta: "₹85 L* to ₹2.40 Cr* • Real-Time Cost Estimator",
        highlight: true
      },
      {
        title: "Home Loan & Bank APF Approval Hub",
        href: "/home-loan/",
        description: "Pre-approved home loan guide featuring official APF numbers from SBI, HDFC, ICICI, and Axis Bank with live EMI calculator.",
        meta: "SBI & HDFC Pre-Approved • Live EMI Model"
      },
      {
        title: "Global NRI Investment Desk",
        href: "/nri-desk/",
        description: "Specialized advisory for Gulf, US, and UK expatriates featuring live USD/AED/GBP/EUR currency converter and FEMA compliance.",
        meta: "Multi-Currency Converter • FEMA Guidelines",
        highlight: true
      }
    ]
  },
  {
    title: "04. Engineering, Milestones & Due Diligence",
    tagline: "Uncompromising legal integrity, structural milestone tracking, and competitive benchmarks",
    badge: "DUE DILIGENCE",
    items: [
      {
        title: "Project Comparison Hub",
        href: "/compare/",
        description: "Analytical benchmarking comparing Mantra Meridian Riverside with Kolte Patil 24K Altura, Kasturi Balmoral, and ANP Universe.",
        meta: "8 Acres vs 3 Acres • Unbiased Comparison",
        highlight: true
      },
      {
        title: "Construction Status & Milestones",
        href: "/construction-status/",
        description: "Live construction tracker detailing piling, podium excavation, structural RCC schedules, and June 2028 handover progress.",
        meta: "MahaRERA June 2028 • Milestone Progress"
      },
      {
        title: "MahaRERA Statutory Compliance",
        href: "/mantra-meridian-riverside/rera/",
        description: "Official registration details for MahaRERA No. P52100045688, title certificates, quarterly progress reports, and encumbrance filings.",
        meta: "MahaRERA P52100045688 • Verified Legal Title"
      },
      {
        title: "Document Library & Official Brochure",
        href: "/mantra-meridian-riverside/documents/",
        description: "Download verified PDF collaterals including the high-resolution master brochure, sanctioned layout sheets, and bank certificates.",
        meta: "Instant PDF Downloads • Sanctioned Plans"
      }
    ]
  },
  {
    title: "05. Estate Masterplan & Riverfront Living",
    tagline: "An 8-acre continuous waterfront realm curated with 30+ lifestyle amenities and a 500m boardwalk",
    badge: "MASTERPLAN & AMENITIES",
    items: [
      {
        title: "The 8-Acre Masterplan",
        href: "/mantra-meridian-riverside/masterplan/",
        description: "Architectural zoning blueprint detailing the 4 residential high-rise towers, multi-tier podium, and 75%+ green open spaces.",
        meta: "8 Contiguous Acres • 4 Iconic Towers"
      },
      {
        title: "The Riverside Story",
        href: "/mantra-meridian-riverside/riverside/",
