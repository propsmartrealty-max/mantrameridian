---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReraVerificationCard from '../../components/Trust/ReraVerificationCard.astro';
import DocumentCentre from '../../components/Documents/DocumentCentre.astro';
import FAQAccordion from '../../components/FAQ/FAQAccordion.astro';
import { projectData } from '../../data/project';

export const prerender = true;
---

<BaseLayout
  title="MahaRERA Compliance & Verification | Mantra Meridian Riverside"
  description="Official MahaRERA registration P52100045688 details for Mantra Meridian Riverside, Balewadi. Verified compliance documents, land title, and government approval records."
>
  <div class="pt-32 pb-24 px-6 md:px-12 max-w-7xl mx-auto space-y-16">
    
    <div class="max-w-3xl space-y-4">
      <span class="label-architectural text-xs text-champagne">STATUTORY COMPLIANCE &amp; TRUST</span>
      <h1 class="font-serif text-5xl sm:text-7xl text-architectural-white font-normal leading-tight">
        MahaRERA<br />
        <span class="text-champagne font-light italic">Compliance &amp; Verification.</span>
      </h1>
      <p class="text-xs sm:text-sm text-concrete leading-relaxed">
        At Mantra Properties, transparency is our foundation. Mantra Meridian Riverside is officially registered with the Maharashtra Real Estate Regulatory Authority. All project documentation, environmental clearances, and sanctioned layout plans are matters of verified public record.
      </p>
    </div>

    {/* Big RERA Card */}
    <ReraVerificationCard />

    {/* Verification Steps Guide */}
    <div class="p-8 bg-obsidian-card border border-white/10 space-y-6">
      <h2 class="font-serif text-2xl text-architectural-white">How to Verify on MahaRERA Official Portal</h2>
      
      <ol class="space-y-4 text-xs text-concrete">
        <li class="flex items-start gap-3">
          <span class="w-6 h-6 rounded-full bg-champagne/10 border border-champagne text-champagne flex items-center justify-center font-mono text-[11px] shrink-0">1</span>
          <div>
            <strong class="text-architectural-white block">Visit the Maharashtra RERA Portal</strong>
            Navigate to <a href={projectData.reraRegistrationUrl} target="_blank" rel="noopener noreferrer" class="text-champagne hover:underline">maharera.mahaonline.gov.in</a> and select the "Registered Projects" tab.
          </div>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-6 h-6 rounded-full bg-champagne/10 border border-champagne text-champagne flex items-center justify-center font-mono text-[11px] shrink-0">2</span>
          <div>
            <strong class="text-architectural-white block">Search Registration Number</strong>
            Enter the verified project registration number: <code class="text-champagne font-mono bg-obsidian px-2 py-0.5 border border-white/10">{projectData.reraNumber}</code>.
          </div>
        </li>
        <li class="flex items-start gap-3">
          <span class="w-6 h-6 rounded-full bg-champagne/10 border border-champagne text-champagne flex items-center justify-center font-mono text-[11px] shrink-0">3</span>
          <div>
            <strong class="text-architectural-white block">Inspect Certified Disclosures</strong>
            Review sanctioned building plans, carpet area schedules, encumbrance certificates, and CA quarterly progress filings.
          </div>
        </li>
      </ol>
    </div>

    {/* Document Centre */}
    <DocumentCentre />

    {/* RERA FAQs */}
    <div class="space-y-6">
      <div>
        <span class="label-architectural text-xs text-champagne">REGULATORY QUESTIONS</span>
        <h2 class="font-serif text-3xl text-architectural-white mt-1">MahaRERA FAQs</h2>
      </div>
      <FAQAccordion category="rera" />
    </div>

  </div>
</BaseLayout>
