---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AmenityAtlas from '../../components/Amenity/AmenityAtlas';
import { amenityChapters } from '../../data/amenities';

export const prerender = true;
---

<BaseLayout
  title="Mantra Meridian Amenities | 30+ Curated Spaces & Clubhouse Balewadi"
  description="Discover 30+ curated lifestyle amenities across 8 chapters at Mantra Meridian Riverside, Balewadi. Temperature-controlled infinity pool, 20,000 sq.ft. pavilion & riverside promenade."
  keywords="Mantra Meridian amenities, luxury amenities Balewadi, apartments with infinity pool Balewadi, clubhouse Balewadi, tennis court apartments Pune, cinema hall in society Pune"
>
  <div class="pt-32 pb-24 px-6 md:px-12 max-w-7xl mx-auto space-y-20">
    
    <div class="max-w-3xl space-y-4">
      <span class="label-architectural text-xs text-champagne">CURATED LIFESTYLE INFRASTRUCTURE</span>
      <h1 class="font-serif text-5xl sm:text-7xl text-architectural-white font-normal leading-tight">
        Feel Like Royalty &amp;<br />
        <span class="text-champagne font-light italic">Live Like One.</span>
      </h1>
      <p class="text-xs sm:text-sm text-concrete leading-relaxed">
        A majestic experience for the new age. Discover over 30 curated spaces dedicated to restorative wellness, competitive sport, private entertaining, and tranquil riverside nature.
      </p>
    </div>

    {/* Amenity Atlas Interactive Island */}
    <AmenityAtlas client:load />

    {/* Exhaustive Amenity Schedule */}
    <div class="space-y-12">
      <div class="border-b border-white/10 pb-4">
        <span class="label-architectural text-xs text-champagne">EXHAUSTIVE SCHEDULE</span>
        <h2 class="font-serif text-3xl text-architectural-white mt-1">All Curated Spaces by Chapter</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {amenityChapters.map((chapter) => (
          <div class="p-6 bg-obsidian-card border border-white/10 space-y-4">
            <span class="label-architectural text-[10px] text-champagne">{chapter.title}</span>
            <h3 class="font-serif text-xl text-architectural-white">{chapter.subtitle}</h3>
            <ul class="space-y-2 text-xs text-concrete/80 pt-2 border-t border-white/5">
              {chapter.items.map((item) => (
                <li class="flex items-center justify-between py-1 border-b border-white/5">
                  <span class="font-medium text-architectural-white">{item.name}</span>
                  <span class="text-[10px] font-mono text-champagne">{item.locationOnSite}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

  </div>
</BaseLayout>
