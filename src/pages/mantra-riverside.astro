---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Navigation/Breadcrumbs.astro';
import ProjectSnapshotMatrix from '../components/Project/ProjectSnapshotMatrix.astro';
import RiversideExperience from '../components/Riverside/RiversideExperience.astro';
import DesignPhilosophy from '../components/Architecture/DesignPhilosophy.astro';
import FAQAccordion from '../components/FAQ/FAQAccordion.astro';
import ReraVerificationCard from '../components/Trust/ReraVerificationCard.astro';
import { residencesData } from '../data/residences';

export const prerender = true;

const pageKeywords = [
  "Mantra Riverside",
  "Mantra Riverside Balewadi",
  "Mantra Meridian Riverside",
  "Mantra Riverside Pune",
  "Riverside Balewadi Mantra",
  "Mantra Properties Riverside",
  "Luxury Riverside Apartments Balewadi",
  "Mula Riverfront Flats Pune",
  "2 BHK Mantra Riverside",
  "3 BHK Mantra Riverside",
  "4 BHK Mantra Riverside"
];

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "RealEstateListing",
      "@id": "https://mantrameridianriverside.com/mantra-riverside/#listing",
      "name": "Mantra Riverside Balewadi Luxury Residences",
      "description": "8-acre luxury riverfront development by Mantra Properties along the Mula River in Balewadi, Pune. Offering 2, 3, 4 BHK apartments and sky duplexes.",
      "url": "https://mantrameridianriverside.com/mantra-riverside/",
      "datePosted": "2026-01-01",
      "validThrough": "2028-06-30",
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "INR",
        "lowPrice": "8500000",
        "highPrice": "24000000",
        "offerCount": "450",
        "availability": "https://schema.org/InStock",
        "seller": {
          "@type": "RealEstateAgent",
          "@id": "https://mantrameridianriverside.com/#organization"
        }
      }
    }
  ]
};
---

<BaseLayout
  title="Mantra Riverside | Luxury Riverfront Residences Balewadi by Mantra Properties"
  description="Official portal for Mantra Riverside by Mantra Properties in Balewadi, Pune. 8-acre luxury riverfront development offering 2, 3, 4 BHK residences along the tranquil Mula river boardwalk. MahaRERA P52100045688."
  keywords={pageKeywords}
  customSchema={customSchema}
>
  <div class="pt-32 pb-16 px-6 md:px-12 max-w-7xl mx-auto space-y-12">
    <Breadcrumbs items={[{ name: "Mantra Riverside" }]} />

    <div class="max-w-4xl space-y-5">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-champagne/10 border border-champagne/30 text-champagne text-xs font-mono tracking-widest uppercase">
        <span class="w-2 h-2 rounded-full bg-champagne animate-pulse"></span>
        <span>RIVERFRONT SANCTUARY • MANTRA RIVERSIDE</span>
      </div>
      
      <h1 class="font-display text-4xl sm:text-6xl md:text-7xl text-architectural-white font-normal leading-tight">
        Mantra Riverside.<br />
        <span class="text-champagne font-light italic font-serif">Riverfront Luxury Living in Balewadi.</span>
      </h1>

      <p class="text-sm sm:text-base text-concrete leading-relaxed max-w-3xl">
        Welcome to <strong>Mantra Riverside</strong> at Mantra Meridian Balewadi—an exclusive 8-acre sanctuary crafted along the perennial banks of the Mula River. Experience biophilic architecture, unhindered riparian vistas, and luxury 2, 3 &amp; 4 BHK residences designed for elevated living in West Pune.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a href="#residences" class="btn-luxury text-xs">
          EXPLORE RESIDENCES →
        </a>
        <a href="/mantra-meridian-riverside/price/" class="btn-luxury-outline text-xs">
          CHECK PRICING &amp; COST SHEET
        </a>
      </div>
    </div>
  </div>

  {/* Above-the-fold Quick Project Snapshot */}
  <ProjectSnapshotMatrix highlightKeyword="Mantra Riverside" />

  {/* Riverside Experience Feature */}
  <RiversideExperience />

  {/* Residence Formats Grid */}
  <section id="residences" class="w-full py-24 bg-obsidian border-b border-white/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12 space-y-12">
      <div class="max-w-2xl space-y-3">
        <span class="label-architectural text-xs text-champagne">MANTRA RIVERSIDE LIVING FORMATS</span>
        <h2 class="font-serif text-3xl sm:text-5xl text-architectural-white font-normal">
          Curated Waterfront Residences
        </h2>
        <p class="text-xs sm:text-sm text-concrete leading-relaxed">
          Every home at Mantra Riverside is calibrated to maximize cross-ventilation, natural sunlight, and soothing waterfront panoramas.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {residencesData.map((res) => (
          <div class="card-beige-luxury border-animated-beam p-6 sm:p-8 flex flex-col justify-between space-y-6">
            <div class="space-y-4">
              <div class="relative aspect-[16/10] overflow-hidden">
                <img
                  src={res.renderImage}
                  alt={`${res.name} at Mantra Riverside Balewadi`}
                  class="w-full h-full object-cover filter brightness-95 hover:scale-105 transition-transform duration-700"
                />
                <div class="absolute top-3 left-3 badge-beige font-mono text-[10px]">
                  {res.type}
                </div>
                <div class="absolute bottom-3 right-3 badge-beige font-mono text-xs text-champagne">
                  {res.carpetAreaRange}
                </div>
              </div>

              <h3 class="font-serif text-2xl text-architectural-white">{res.name}</h3>
              <p class="text-xs text-concrete leading-relaxed">{res.subtitle}</p>
            </div>

            <div class="pt-4 border-t border-white/10 flex items-center justify-between">
              <span class="text-xs font-mono text-champagne">{res.balconyType}</span>
              <a href={`/mantra-meridian-riverside/${res.slug}/`} class="btn-luxury text-xs">
                VIEW DETAILS →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Design & Architectural Philosophy */}
  <DesignPhilosophy />

  {/* MahaRERA Statutory Verification */}
  <ReraVerificationCard />

  {/* Dedicated FAQs */}
  <FAQAccordion />
</BaseLayout>
