---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Navigation/Breadcrumbs.astro';
import ProjectSnapshotMatrix from '../components/Project/ProjectSnapshotMatrix.astro';
import LocationIntelligence from '../components/Location/LocationIntelligence';
import InfrastructureGrowthRadar from '../components/Location/InfrastructureGrowthRadar.astro';
import FAQAccordion from '../components/FAQ/FAQAccordion.astro';
import ReraVerificationCard from '../components/Trust/ReraVerificationCard.astro';
import { residencesData } from '../data/residences';

export const prerender = true;

const pageKeywords = [
  "Mantra Balewadi",
  "Mantra Meridian Balewadi",
  "Mantra Riverside Balewadi",
  "Mantra Properties Balewadi",
  "Mantra Balewadi Pune",
  "New Launch Mantra Balewadi",
  "Flats in Balewadi by Mantra",
  "Luxury Apartments in Balewadi",
  "2 BHK Mantra Balewadi",
  "3 BHK Mantra Balewadi",
  "Balewadi High Street Flats"
];

const customSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "RealEstateListing",
      "@id": "https://mantrameridianriverside.com/mantra-balewadi/#listing",
      "name": "Mantra Balewadi - Mantra Meridian & Mantra Riverside",
      "description": "8-acre luxury residential development by Mantra Properties near Balewadi High Street, Pune. Premium 2, 3, 4 BHK homes.",
      "url": "https://mantrameridianriverside.com/mantra-balewadi/",
      "datePosted": "2026-01-01",
      "validThrough": "2028-06-30",
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "INR",
        "lowPrice": "8500000",
        "highPrice": "24000000",
        "offerCount": "450",
        "availability": "https://schema.org/InStock",
        "seller": {
          "@type": "RealEstateAgent",
          "@id": "https://mantrameridianriverside.com/#organization"
        }
      }
    }
  ]
};
---

<BaseLayout
  title="Mantra Balewadi | Mantra Meridian & Mantra Riverside Luxury Apartments"
  description="Explore Mantra Balewadi: Mantra Properties' landmark 8-acre development featuring Mantra Meridian and Mantra Riverside. Premium 2, 3, 4 BHK apartments near Balewadi High Street, Pune. MahaRERA P52100045688."
  keywords={pageKeywords}
  customSchema={customSchema}
>
  <div class="pt-32 pb-16 px-6 md:px-12 max-w-7xl mx-auto space-y-12">
    <Breadcrumbs items={[{ name: "Mantra Balewadi" }]} />

    <div class="max-w-4xl space-y-5">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-champagne/10 border border-champagne/30 text-champagne text-xs font-mono tracking-widest uppercase">
        <span class="w-2 h-2 rounded-full bg-champagne animate-pulse"></span>
        <span>PRIME WEST PUNE • MANTRA BALEWADI</span>
      </div>
      
      <h1 class="font-display text-4xl sm:text-6xl md:text-7xl text-architectural-white font-normal leading-tight">
        Mantra Balewadi.<br />
        <span class="text-champagne font-light italic font-serif">Mantra Meridian &amp; Riverside Residences.</span>
      </h1>

      <p class="text-sm sm:text-base text-concrete leading-relaxed max-w-3xl">
        <strong>Mantra Balewadi</strong> represents the gold standard of modern urban living in West Pune. Positioned along Balewadi Village Road near Balewadi High Street, this 8-acre integrated development by Mantra Properties features <strong>Mantra Meridian</strong> and <strong>Mantra Riverside</strong>, delivering world-class 2, 3 &amp; 4 BHK riverfront homes.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <a href="#configurations" class="btn-luxury text-xs">
          EXPLORE CONFIGURATIONS →
        </a>
        <a href="/mantra-meridian-riverside/location/" class="btn-luxury-outline text-xs">
          EXPLORE LOCATION ADVANTAGES
        </a>
      </div>
    </div>
  </div>

  {/* Above-the-fold Quick Project Snapshot */}
  <ProjectSnapshotMatrix highlightKeyword="Mantra Balewadi" />

  {/* Micromarket Growth & Infrastructure Radar */}
  <InfrastructureGrowthRadar />

  {/* Balewadi Interactive Location Intelligence */}
  <LocationIntelligence client:visible />

  {/* Residence Formats Grid */}
  <section id="configurations" class="w-full py-24 bg-obsidian border-b border-white/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12 space-y-12">
      <div class="max-w-2xl space-y-3">
        <span class="label-architectural text-xs text-champagne">RESIDENCES AT MANTRA BALEWADI</span>
        <h2 class="font-serif text-3xl sm:text-5xl text-architectural-white font-normal">
          Available Formats &amp; Carpet Areas
        </h2>
        <p class="text-xs sm:text-sm text-concrete leading-relaxed">
          Select from meticulously planned layouts offering expansive living rooms, king-sized bedrooms, and panoramic river or city skyline views.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {residencesData.map((res) => (
          <div class="card-beige-luxury border-animated-beam p-6 sm:p-8 flex flex-col justify-between space-y-6">
            <div class="space-y-4">
              <div class="relative aspect-[16/10] overflow-hidden">
                <img
                  src={res.renderImage}
                  alt={`${res.name} at Mantra Balewadi`}
                  class="w-full h-full object-cover filter brightness-95 hover:scale-105 transition-transform duration-700"
                />
                <div class="absolute top-3 left-3 badge-beige font-mono text-[10px]">
                  {res.type}
                </div>
                <div class="absolute bottom-3 right-3 badge-beige font-mono text-xs text-champagne">
                  {res.carpetAreaRange}
                </div>
              </div>

              <h3 class="font-serif text-2xl text-architectural-white">{res.name}</h3>
              <p class="text-xs text-concrete leading-relaxed">{res.subtitle}</p>
            </div>

            <div class="pt-4 border-t border-white/10 flex items-center justify-between">
              <span class="text-xs font-mono text-champagne">{res.balconyType}</span>
              <a href={`/mantra-meridian-riverside/${res.slug}/`} class="btn-luxury text-xs">
                VIEW DETAILS →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* MahaRERA Statutory Verification */}
  <ReraVerificationCard />

  {/* Dedicated FAQs */}
  <FAQAccordion />
</BaseLayout>
