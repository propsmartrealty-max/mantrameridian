---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Navigation/Breadcrumbs.astro';
import { TYPOLOGIES, LOCATIONS, INTENTS, TOTAL_PROGRAMMATIC_PAGES, buildProgrammaticSlug } from '../../data/programmatic-seo-matrix';

export const prerender = true;

const title = "Mantra Meridian Residences Directory [10,400 Portals] Balewadi";
const description = `✓ Official Directory: 10,400 Verified Real Estate Intelligence Portals for Mantra Meridian Riverside Balewadi. 2, 3, 4 BHK & Duplexes from ₹1.29 Cr*. MahaRERA P52100045688.`;

// Curated high-intent featured micro-market portals for immediate search crawl discovery
const featuredPortals = [
  // 2 BHK Hubs
  { typIdx: 0, locIdx: 0, intIdx: 0, label: '2 BHK in Balewadi — Price Breakdown & Cost Sheet' },
  { typIdx: 0, locIdx: 1, intIdx: 1, label: '2 BHK near Balewadi High Street — Floor Plans & Carpet' },
  { typIdx: 0, locIdx: 6, intIdx: 5, label: '2 BHK near Hinjewadi Phase 1 — Payment Schedule & Bank Loan' },
  { typIdx: 0, locIdx: 9, intIdx: 8, label: '2 BHK near Mahalunge Hi-Tech City — Investment Forecast' },
  { typIdx: 0, locIdx: 11, intIdx: 0, label: '2 BHK near Wakad Millennium Corridor — Price Cost Sheet' },
  
  // 3 BHK Hubs
  { typIdx: 1, locIdx: 0, intIdx: 0, label: '3 BHK in Balewadi — Price Breakdown & Cost Sheet' },
  { typIdx: 1, locIdx: 1, intIdx: 1, label: '3 BHK near Balewadi High Street — Floor Plans & Carpet' },
  { typIdx: 1, locIdx: 3, intIdx: 2, label: '3 BHK near Baner Luxury Enclave — MahaRERA & Possession' },
  { typIdx: 1, locIdx: 6, intIdx: 7, label: '3 BHK near Hinjewadi IT Park — Booking Concierge Desk' },
  { typIdx: 1, locIdx: 19, intIdx: 12, label: '3 BHK along Mula River Boardwalk — River-Facing Units' },

  // 3 BHK Sky Duplex Hubs
  { typIdx: 2, locIdx: 0, intIdx: 3, label: '3 BHK Sky Duplex in Balewadi — Sample Flat 3D Video Tour' },
  { typIdx: 2, locIdx: 1, intIdx: 11, label: '3 BHK Sky Duplex near Balewadi High Street — Italian Marble Specs' },
  { typIdx: 2, locIdx: 3, intIdx: 0, label: '3 BHK Sky Duplex near Baner — Pricing & Cost Sheet' },
  { typIdx: 2, locIdx: 11, intIdx: 13, label: '3 BHK Sky Duplex near Wakad — Vastu Sanctioned Layouts' },
  { typIdx: 2, locIdx: 19, intIdx: 12, label: '3 BHK Sky Duplex with River Promenade Deck — 20ft Ceilings' },

  // 4 BHK Grand Estates Hubs
  { typIdx: 3, locIdx: 0, intIdx: 0, label: '4 BHK Grand Estates in Balewadi — Pricing Schedule' },
  { typIdx: 3, locIdx: 1, intIdx: 14, label: '4 BHK Grand Estates near High Street — Biometric Security & Private Foyer' },
  { typIdx: 3, locIdx: 3, intIdx: 1, label: '4 BHK Grand Estates near Baner — Sanctioned Blueprints' },
  { typIdx: 3, locIdx: 17, intIdx: 8, label: '4 BHK Grand Estates in West Pune — Capital Appreciation 2026-2030' },

  // Penthouse & Sky Villa Hubs
  { typIdx: 4, locIdx: 0, intIdx: 12, label: 'Penthouse & Sky Villas in Balewadi — 270° Riparian River Views' },
  { typIdx: 4, locIdx: 3, intIdx: 11, label: 'Penthouse & Sky Villas near Baner — Ultra-Luxury Marble & Decks' },
  { typIdx: 4, locIdx: 16, intIdx: 16, label: 'Penthouse Collection for NRI Investors — Dual-Currency Wealth Desk' },
  { typIdx: 4, locIdx: 17, intIdx: 0, label: 'West Pune Crown Sky Villas — Launch Pricing & Allocations' }
].map((item) => ({
  slug: buildProgrammaticSlug(item.typIdx, item.locIdx, item.intIdx),
  label: item.label
}));

const propertiesSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://mantrameridianriverside.com/properties/#directory",
      "name": "Mantra Meridian Riverside Programmatic Real Estate Directory",
      "description": description,
      "url": "https://mantrameridianriverside.com/properties/"
    }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  customSchema={propertiesSchema}
>
  <div class="pt-32 pb-24 px-6 md:px-12 max-w-7xl mx-auto space-y-16">
    
    <Breadcrumbs items={[{ name: 'Properties Directory' }]} />

    <header class="space-y-4 max-w-4xl">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-champagne animate-pulse"></span>
        <span class="label-architectural text-xs text-champagne">PROGRAMMATIC REAL ESTATE REPOSITORY</span>
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl text-architectural-white font-normal leading-tight">
        Mantra Meridian Riverside<br />
        <span class="text-champagne font-light italic">Residences Directory.</span>
      </h1>
      <p class="text-sm sm:text-base text-concrete leading-relaxed">
        Comprehensive real estate directory indexing all {TOTAL_PROGRAMMATIC_PAGES} verified configurations, floor plan layouts, localized distance radars, and official pricing breakdowns across Balewadi, Baner, and West Pune.
      </p>
    </header>

    {/* Typologies Section with Deep-Link Graph */}
    <section class="space-y-6">
      <div class="border-b border-white/10 pb-4">
        <span class="label-architectural text-xs text-champagne">RESIDENCE FORMATS</span>
        <h2 class="font-serif text-2xl sm:text-3xl text-architectural-white mt-1">Living Formats & Typologies</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {TYPOLOGIES.map((t, tIdx) => (
          <div class="p-6 bg-obsidian-card border border-white/10 space-y-4 rounded flex flex-col justify-between">
            <div class="space-y-2">
              <h3 class="font-serif text-xl text-architectural-white">{t.name}</h3>
              <div class="flex justify-between items-center text-xs font-mono text-champagne">
                <span>Carpet: {t.carpet}</span>
                <span>{t.price}</span>
              </div>
              <p class="text-xs text-concrete/80 leading-relaxed">{t.descriptor}</p>
            </div>
            
            <div class="pt-2 border-t border-white/5 space-y-1">
              <span class="text-[10px] font-mono uppercase tracking-widest text-champagne/80">Explore in Top Hubs:</span>
              <div class="flex flex-wrap gap-1.5 pt-1">
                {[0, 1, 6, 9].map((lIdx) => (
                  <a
                    href={`/properties/${buildProgrammaticSlug(tIdx, lIdx, 0)}/`}
                    class="px-2 py-1 bg-obsidian-surface border border-white/5 hover:border-champagne/40 rounded text-[11px] text-concrete hover:text-champagne transition-colors"
                  >
                    {LOCATIONS[lIdx].name.split(',')[0]}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* Micro-Market Corridors Section with Deep-Link Graph */}
    <section class="space-y-6">
      <div class="border-b border-white/10 pb-4">
        <span class="label-architectural text-xs text-champagne">CONNECTIVITY & TRANSIT RADAR</span>
        <h2 class="font-serif text-2xl sm:text-3xl text-architectural-white mt-1">Key Micro-Markets & Distances</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        {LOCATIONS.map((loc, lIdx) => (
          <div class="p-4 bg-obsidian-surface border border-white/5 hover:border-champagne/30 rounded space-y-2 flex flex-col justify-between transition-colors">
            <div>
              <div class="text-xs font-medium text-architectural-white">{loc.name}</div>
              <div class="text-[11px] font-mono text-champagne mt-0.5">{loc.distanceFromSite}</div>
              <div class="text-[10px] text-concrete/60 font-mono">{loc.travelTime} drive</div>
            </div>
            <div class="flex flex-wrap gap-1 pt-1 border-t border-white/5">
              {[0, 1, 2].map((tIdx) => (
                <a
                  href={`/properties/${buildProgrammaticSlug(tIdx, lIdx, 0)}/`}
                  class="text-[10px] font-mono px-1.5 py-0.5 bg-white/5 hover:bg-champagne/20 text-concrete hover:text-champagne rounded transition-colors"
                >
                  {tIdx === 0 ? '2BHK' : tIdx === 1 ? '3BHK' : 'Duplex'}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* Featured High-Intent Micro-Market Portals */}
    <section class="space-y-6">
      <div class="border-b border-white/10 pb-4">
        <span class="label-architectural text-xs text-champagne">FEATURED INTELLIGENCE RADARS</span>
        <h2 class="font-serif text-2xl sm:text-3xl text-architectural-white mt-1">Featured Micro-Market Portals</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {featuredPortals.map((portal) => (
          <a
            href={`/properties/${portal.slug}/`}
            class="p-4 bg-obsidian-surface border border-white/10 hover:border-champagne/60 rounded transition-all group flex flex-col justify-between"
          >
            <span class="font-serif text-sm text-architectural-white group-hover:text-champagne transition-colors">
              {portal.label}
            </span>
            <span class="text-[10px] font-mono text-champagne/80 mt-3 flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
              <span>View Portal Specifications</span>
              <span>→</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    {/* Strategic Buyer Planning Tools & Intent Portals */}
    <section class="space-y-6">
      <div class="border-b border-white/10 pb-4">
        <span class="label-architectural text-xs text-champagne">VERIFIED BUYER TOOLS</span>
        <h2 class="font-serif text-2xl sm:text-3xl text-architectural-white mt-1">Intelligence & Planning Formats</h2>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
        {INTENTS.slice(0, 12).map((intent, iIdx) => (
          <a
            href={`/properties/${buildProgrammaticSlug(1, 0, iIdx)}/`}
            class="p-3 bg-obsidian-surface border border-white/5 hover:border-champagne/40 rounded transition-all group flex flex-col justify-between"
          >
            <span class="text-xs text-architectural-white group-hover:text-champagne transition-colors line-clamp-1">
              {intent.name}
            </span>
            <span class="text-[10px] font-mono text-champagne/70 mt-2">
              {intent.actionHook} →
            </span>
          </a>
        ))}
      </div>
    </section>

    {/* Partitioned Sitemaps Directory */}
    <section class="p-8 bg-obsidian-card border border-champagne/20 space-y-4">
      <div class="text-xs font-mono uppercase tracking-widest text-champagne">
        SEARCH ENGINE PROGRAMMATIC SITEMAP INDICES (10,400 PORTALS)
      </div>
      <p class="text-xs text-concrete/80">
        Google Search Console and Bing Webmaster partitioned sitemaps covering all 10,400 indexed residential portals:
      </p>
      <div class="flex flex-wrap gap-3 pt-2">
        <a href="/sitemaps/properties-1.xml" class="px-3 py-1.5 bg-obsidian-surface border border-white/10 text-xs text-concrete hover:text-champagne hover:border-champagne transition-colors font-mono">
          properties-1.xml (URLs 1–1,000)
        </a>
        <a href="/sitemaps/properties-2.xml" class="px-3 py-1.5 bg-obsidian-surface border border-white/10 text-xs text-concrete hover:text-champagne hover:border-champagne transition-colors font-mono">
          properties-2.xml (URLs 1,001–2,000)
        </a>
        <a href="/sitemaps/properties-3.xml" class="px-3 py-1.5 bg-obsidian-surface border border-white/10 text-xs text-concrete hover:text-champagne hover:border-champagne transition-colors font-mono">
          properties-3.xml (URLs 2,001–3,000)
        </a>
        <a href="/sitemaps/properties-4.xml" class="px-3 py-1.5 bg-obsidian-surface border border-white/10 text-xs text-concrete hover:text-champagne hover:border-champagne transition-colors font-mono">
          properties-4.xml (URLs 3,001–4,000)
        </a>
        <a href="/sitemaps/properties-5.xml" class="px-3 py-1.5 bg-obsidian-surface border border-white/10 text-xs text-concrete hover:text-champagne hover:border-champagne transition-colors font-mono">
          properties-5.xml (URLs 4,001–5,000)
        </a>
        <a href="/sitemaps/properties-6.xml" class="px-3 py-1.5 bg-obsidian-surface border border-white/10 text-xs text-concrete hover:text-champagne hover:border-champagne transition-colors font-mono">
          properties-6.xml (URLs 5,001–6,000)
        </a>
        <a href="/sitemaps/properties-7.xml" class="px-3 py-1.5 bg-obsidian-surface border border-white/10 text-xs text-concrete hover:text-champagne hover:border-champagne transition-colors font-mono">
          properties-7.xml (URLs 6,001–7,000)
        </a>
        <a href="/sitemaps/properties-8.xml" class="px-3 py-1.5 bg-obsidian-surface border border-white/10 text-xs text-concrete hover:text-champagne hover:border-champagne transition-colors font-mono">
          properties-8.xml (URLs 7,001–8,000)
        </a>
        <a href="/sitemaps/properties-9.xml" class="px-3 py-1.5 bg-obsidian-surface border border-white/10 text-xs text-concrete hover:text-champagne hover:border-champagne transition-colors font-mono">
          properties-9.xml (URLs 8,001–9,000)
        </a>
        <a href="/sitemaps/properties-10.xml" class="px-3 py-1.5 bg-obsidian-surface border border-white/10 text-xs text-concrete hover:text-champagne hover:border-champagne transition-colors font-mono">
          properties-10.xml (URLs 9,001–10,000)
        </a>
        <a href="/sitemaps/properties-11.xml" class="px-3 py-1.5 bg-obsidian-surface border border-white/10 text-xs text-concrete hover:text-champagne hover:border-champagne transition-colors font-mono">
          properties-11.xml (URLs 10,001–10,400)
        </a>
      </div>
    </section>

  </div>
</BaseLayout>
