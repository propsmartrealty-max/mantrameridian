---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Navigation/Breadcrumbs.astro';
import FAQAccordion from '../../components/FAQ/FAQAccordion.astro';
import ReraVerificationCard from '../../components/Trust/ReraVerificationCard.astro';
import { resolveProgrammaticSlug } from '../../data/programmatic-seo-matrix';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/404');
}

const data = resolveProgrammaticSlug(slug);
if (!data) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// Dynamic Financial Calculations for Information Gain
const numericPrice = data.priceNumeric || 12900000;
const downPaymentAmount = Math.round(numericPrice * 0.20);
const loanAmount = Math.round(numericPrice * 0.80);
// EMI calculation at 8.5% annual interest over 20 years (240 months)
const monthlyRate = 0.085 / 12;
const totalMonths = 240;
const emiFactor = Math.pow(1 + monthlyRate, totalMonths);
const estimatedEmiMonthly = Math.round((loanAmount * monthlyRate * emiFactor) / (emiFactor - 1));

const formatIndianCurrency = (amount: number) => {
  return '₹' + amount.toLocaleString('en-IN');
};

const downPaymentDisplay = formatIndianCurrency(downPaymentAmount);
const loanAmountDisplay = formatIndianCurrency(loanAmount);
const estimatedEmiDisplay = formatIndianCurrency(estimatedEmiMonthly) + '/month*';

// Commute & Transit Radar Data
const transitDestinations = [
  { destination: 'Balewadi High Street', distance: '1.2 km', driveTime: '3-4 mins', transitType: 'Prime Lifestyle & Commercial Hub' },
  { destination: 'Hinjewadi Rajiv Gandhi IT Park (Phase 1)', distance: '5.8 km', driveTime: '10-12 mins', transitType: 'Tech Employment Center' },
  { destination: 'Pune Metro Line 3 (Balewadi Stadium Station)', distance: '1.5 km', driveTime: '4 mins', transitType: 'Rapid Mass Transit' },
  { destination: 'Mumbai-Pune Expressway (Dehu Road Plaza)', distance: '9.2 km', driveTime: '12-14 mins', transitType: 'Inter-City Expressway' },
  { destination: 'The Orchid School / Bharati Vidyapeeth', distance: '2.1 km', driveTime: '5 mins', transitType: 'Premier Education Hub' },
  { destination: 'Jupiter Hospital & Multi-Specialty Baner', distance: '3.4 km', driveTime: '7-8 mins', transitType: 'Healthcare Corridor' },
];

// Edge caching headers for Cloudflare Cache API (caches.default) with 30-day resilience
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=86400, stale-while-revalidate=604800, stale-if-error=2592000');
Astro.response.headers.set('Cache-Tag', 'mantra-properties-programmatic, html-pages, mantra-meridian');
Astro.response.headers.set('X-Robots-Tag', 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1');
---

<BaseLayout
  title={data.title}
  description={data.metaDescription}
  customSchema={data.schema}
>
  <div class="pt-32 pb-24 px-6 md:px-12 max-w-7xl mx-auto space-y-16">
    
    <Breadcrumbs items={data.breadcrumbs} />

    {/* Hero Section */}
    <header class="space-y-6">
      <div class="flex flex-wrap items-center gap-3">
        <span class="px-3 py-1 bg-champagne/10 border border-champagne/30 text-champagne text-[11px] font-mono tracking-widest uppercase">
          {data.locationName}
        </span>
        <span class="px-3 py-1 bg-white/5 border border-white/10 text-concrete text-[11px] font-mono tracking-widest uppercase">
          {data.typologyName}
        </span>
        <span class="px-3 py-1 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-[11px] font-mono tracking-widest uppercase">
          MahaRERA P52100045688
        </span>
      </div>

      <div class="space-y-4 max-w-4xl">
        <h1 class="font-serif text-4xl sm:text-6xl text-architectural-white font-normal leading-tight">
          {data.h1Title}
        </h1>
        <p class="font-serif text-xl sm:text-2xl text-champagne font-light italic">
          {data.heroHeadline}
        </p>
        <p class="text-sm sm:text-base text-concrete leading-relaxed">
          {data.summaryText}
        </p>
      </div>
    </header>

    {/* Snapshot Highlights Cards */}
    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="p-6 bg-obsidian-card border border-champagne/30 space-y-2">
        <span class="text-[10px] font-mono uppercase tracking-widest text-champagne">CONSIDERATION</span>
        <div class="font-serif text-3xl text-architectural-white font-medium">{data.priceDisplay}</div>
        <p class="text-xs text-concrete/80">All-inclusive installment schedule available upon enquiry.</p>
      </div>

      <div class="p-6 bg-obsidian-card border border-white/10 space-y-2">
        <span class="text-[10px] font-mono uppercase tracking-widest text-concrete/70">SANCTIONED CARPET AREA</span>
        <div class="font-serif text-3xl text-architectural-white font-medium">{data.carpetArea}</div>
        <p class="text-xs text-concrete/80">RERA-certified usable layout with zero space wastage.</p>
      </div>

      <div class="p-6 bg-obsidian-card border border-white/10 space-y-2">
        <span class="text-[10px] font-mono uppercase tracking-widest text-concrete/70">STATUTORY POSSESSION</span>
        <div class="font-serif text-3xl text-architectural-white font-medium">June 2028</div>
        <p class="text-xs text-concrete/80">Advanced Mivan monocoque structural engineering.</p>
      </div>
    </section>

    {/* Detailed Architectural Feature Matrix */}
    <section class="p-8 md:p-12 bg-obsidian-surface border border-white/10 space-y-8">
      <div class="border-b border-white/10 pb-4">
        <span class="label-architectural text-xs text-champagne">SPECIFICATIONS & RADAR</span>
        <h2 class="font-serif text-2xl sm:text-3xl text-architectural-white mt-1">Property Specifications & Strategic Advantage</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {data.highlights.map((item) => (
          <div class="flex items-start gap-3 p-4 bg-obsidian-card border border-white/5">
            <span class="text-champagne font-mono text-base">✦</span>
            <span class="text-xs sm:text-sm text-concrete leading-relaxed">{item}</span>
          </div>
        ))}
      </div>
    </section>

    {/* Dynamic Financial Snapshot & Indicative EMI Matrix */}
    <section class="p-8 md:p-12 bg-obsidian-surface border border-champagne/20 space-y-8">
      <div class="border-b border-white/10 pb-4 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
        <div>
          <span class="label-architectural text-xs text-champagne">FINANCIAL ARCHITECTURE</span>
          <h2 class="font-serif text-2xl sm:text-3xl text-architectural-white mt-1">Indicative Investment & EMI Breakdown</h2>
        </div>
        <div class="text-xs font-mono text-champagne/90 bg-champagne/10 border border-champagne/30 px-3 py-1.5 self-start md:self-auto">
          MahaRERA Sanctioned Milestones
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-5 bg-obsidian-card border border-white/5 space-y-1">
          <span class="text-[10px] font-mono uppercase tracking-widest text-concrete/70">BASE PRICING</span>
          <div class="font-serif text-2xl text-architectural-white font-medium">{data.priceDisplay}</div>
          <p class="text-[11px] text-concrete/80">Inclusive of designated car parking space.</p>
        </div>

        <div class="p-5 bg-obsidian-card border border-white/5 space-y-1">
          <span class="text-[10px] font-mono uppercase tracking-widest text-concrete/70">EST. DOWN PAYMENT (20%)</span>
          <div class="font-serif text-2xl text-architectural-white font-medium">{downPaymentDisplay}*</div>
          <p class="text-[11px] text-concrete/80">Staggered milestone construction-linked plan.</p>
        </div>

        <div class="p-5 bg-obsidian-card border border-white/5 space-y-1">
          <span class="text-[10px] font-mono uppercase tracking-widest text-concrete/70">EST. BANK LOAN (80%)</span>
          <div class="font-serif text-2xl text-architectural-white font-medium">{loanAmountDisplay}*</div>
          <p class="text-[11px] text-concrete/80">Pre-approved by SBI, HDFC, ICICI, Axis Bank.</p>
        </div>

        <div class="p-5 bg-obsidian-card border border-champagne/30 space-y-1">
          <span class="text-[10px] font-mono uppercase tracking-widest text-champagne">EST. MONTHLY EMI</span>
          <div class="font-serif text-2xl text-champagne font-medium">{estimatedEmiDisplay}</div>
          <p class="text-[11px] text-concrete/80">Computed @ 8.5% p.a. over 20-year tenure.</p>
        </div>
      </div>

      <div class="pt-2 flex flex-wrap items-center justify-between gap-4 border-t border-white/5">
        <p class="text-xs text-concrete/70 max-w-2xl leading-relaxed">
          *Indicative calculations for financial planning. Applicable stamp duty (6%), registration charges, and GST are calculated at actuals per government norms.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/mantra-meridian-riverside/price/" class="btn-luxury text-xs">
            VIEW COST SHEET →
          </a>
          <a href="/home-loan/" class="px-5 py-2.5 border border-white/20 text-xs text-architectural-white hover:border-champagne hover:text-champagne transition-colors font-mono">
            BANK PRE-APPROVALS
          </a>
        </div>
      </div>
    </section>

    {/* Localized Transit & Commute Radar Matrix */}
    <section class="p-8 md:p-12 bg-obsidian-surface border border-white/10 space-y-8">
      <div class="border-b border-white/10 pb-4 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
        <div>
          <span class="label-architectural text-xs text-champagne">TRANSIT CORRIDOR INTELLIGENCE</span>
          <h2 class="font-serif text-2xl sm:text-3xl text-architectural-white mt-1">Commute Radar from Mantra Meridian Balewadi</h2>
        </div>
        <div class="text-xs font-mono text-concrete/80">
          GPS Coordinates: 18.5775° N, 73.7667° E
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-white/10 text-[11px] font-mono uppercase tracking-wider text-champagne">
              <th class="py-3 px-4">Strategic Landmark / Hub</th>
              <th class="py-3 px-4">Distance</th>
              <th class="py-3 px-4">Typical Drive Time</th>
              <th class="py-3 px-4">Corridor Function</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 text-xs text-concrete">
            {transitDestinations.map((node) => (
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-3.5 px-4 font-medium text-architectural-white">{node.destination}</td>
                <td class="py-3.5 px-4 font-mono text-champagne">{node.distance}</td>
                <td class="py-3.5 px-4 font-mono">{node.driveTime}</td>
                <td class="py-3.5 px-4 text-concrete/80">{node.transitType}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-4 pt-2 border-t border-white/5">
        <p class="text-xs text-concrete/70">
          Direct signal-free arterial connectivity via Balewadi High Street Link Road and Mahalunge Mula River Bridge.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/mantra-meridian-riverside/location/" class="px-5 py-2.5 bg-obsidian-card border border-white/10 hover:border-champagne text-xs text-architectural-white hover:text-champagne transition-colors font-mono">
            EXPLORE LOCATION MAP
          </a>
          <a href="/directions/" class="px-5 py-2.5 bg-obsidian-card border border-white/10 hover:border-champagne text-xs text-architectural-white hover:text-champagne transition-colors font-mono">
            GET 1-CLICK GPS DIRECTIONS →
          </a>
        </div>
      </div>
    </section>

    {/* Visual Archive Preview */}
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-6 space-y-6">
        <span class="label-architectural text-xs text-champagne">RIPARIAN SANCTUARY</span>
        <h2 class="font-serif text-3xl sm:text-4xl text-architectural-white leading-tight">
          Riverfront Living at<br />
          Mantra Meridian Balewadi.
        </h2>
        <p class="text-xs sm:text-sm text-concrete leading-relaxed">
          Spread across 8 contiguous acres along the tranquil Mula River, Mantra Meridian Riverside blends expansive natural green realms with rapid transit access to Balewadi High Street (3 mins) and Rajiv Gandhi Infotech Park, Hinjewadi (10 mins).
        </p>
        <div class="flex flex-wrap gap-4 pt-2">
          <a href="/mantra-meridian-riverside/price/" class="btn-luxury text-xs">
            VIEW COST SHEET →
          </a>
          <a href="/mantra-meridian-riverside/floor-plans/" class="px-6 py-3 border border-white/20 text-xs text-architectural-white hover:border-champagne hover:text-champagne transition-colors font-mono">
            FLOOR PLANS PDF
          </a>
        </div>
      </div>

      <div class="lg:col-span-6 overflow-hidden border border-white/10 shadow-luxury aspect-[4/3]">
        <img
          src="/assets/mantra-meridian-hero.webp"
          alt={`${data.typologyName} at Mantra Meridian Riverside Balewadi`}
          width="800"
          height="600"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover"
        />
      </div>
    </section>

    {/* Frequently Asked Questions */}
    <section class="space-y-6">
      <div class="border-b border-white/10 pb-4">
        <span class="label-architectural text-xs text-champagne">VERIFIED PROPERTY INTELLIGENCE</span>
        <h2 class="font-serif text-2xl sm:text-3xl text-architectural-white mt-1">Frequently Asked Questions</h2>
      </div>
      <FAQAccordion customFaqs={data.faqs} />
    </section>

    {/* Statutory RERA Verification Card */}
    <ReraVerificationCard />

    {/* Contextual Programmatic Mesh: 12 Direct Reciprocal Graph Links */}
    <section class="space-y-8 p-8 bg-obsidian-card border border-champagne/20 rounded">
      <div class="border-b border-white/10 pb-4">
        <span class="label-architectural text-xs text-champagne">RECIPROCAL REAL ESTATE NETWORK</span>
        <h2 class="font-serif text-2xl sm:text-3xl text-architectural-white mt-1">Explore Related Configurations & Locations</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {/* Sibling Typologies */}
        <div class="space-y-3">
          <h3 class="text-xs font-mono uppercase tracking-widest text-champagne">
            Other Typologies in {data.locationName.split(',')[0]}
          </h3>
          <div class="space-y-2">
            {data.relatedTypologies?.map((item) => (
              <a
                href={`/properties/${item.slug}/`}
                class="block p-3 bg-obsidian-surface border border-white/5 hover:border-champagne/50 rounded transition-all group"
              >
                <div class="text-xs font-medium text-architectural-white group-hover:text-champagne transition-colors">
                  {item.name}
                </div>
                <div class="flex justify-between items-center text-[11px] font-mono text-concrete/70 mt-1">
                  <span>{item.carpet}</span>
                  <span class="text-champagne">{item.price}</span>
                </div>
              </a>
            ))}
          </div>
        </div>

        {/* Sibling Locations */}
        <div class="space-y-3">
          <h3 class="text-xs font-mono uppercase tracking-widest text-champagne">
            {data.typologyName} Across West Pune
          </h3>
          <div class="space-y-2">
            {data.relatedLocations?.map((item) => (
              <a
                href={`/properties/${item.slug}/`}
                class="block p-3 bg-obsidian-surface border border-white/5 hover:border-champagne/50 rounded transition-all group"
              >
                <div class="text-xs font-medium text-architectural-white group-hover:text-champagne transition-colors">
                  {item.name}
                </div>
                <div class="text-[11px] font-mono text-concrete/70 mt-1">
                  Distance: {item.distance}
                </div>
              </a>
            ))}
          </div>
        </div>

        {/* Sibling Intents */}
        <div class="space-y-3">
          <h3 class="text-xs font-mono uppercase tracking-widest text-champagne">
            Planning & Verification Portals
          </h3>
          <div class="space-y-2">
            {data.relatedIntents?.map((item) => (
              <a
                href={`/properties/${item.slug}/`}
                class="block p-3 bg-obsidian-surface border border-white/5 hover:border-champagne/50 rounded transition-all group"
              >
                <div class="text-xs font-medium text-architectural-white group-hover:text-champagne transition-colors">
                  {item.name}
                </div>
                <div class="text-[10px] font-mono text-champagne/80 mt-1 flex items-center gap-1">
                  <span>Access Verified Data</span>
                  <span>→</span>
                </div>
              </a>
            ))}
          </div>
        </div>

        {/* Authoritative Resource Hubs */}
        <div class="space-y-3">
          <h3 class="text-xs font-mono uppercase tracking-widest text-champagne">
            Project Authority Hubs
          </h3>
          <div class="space-y-2">
            {data.relatedComparisons?.map((item) => (
              <a
                href={item.url}
                class="block p-3 bg-obsidian-surface border border-white/5 hover:border-champagne/50 rounded transition-all group"
              >
                <div class="text-xs font-medium text-architectural-white group-hover:text-champagne transition-colors">
                  {item.name}
                </div>
                <div class="text-[10px] font-mono text-emerald-400/90 mt-1 flex items-center gap-1">
                  <span>Official Verified</span>
                  <span>✓</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* Contextual Real Estate Interlinking Hub */}
    <nav class="p-8 bg-obsidian-card border border-white/10 space-y-6" aria-label="Related Real Estate Pages">
      <div class="text-xs font-mono uppercase tracking-widest text-champagne">
        EXPLORE RELATED CORRIDORS & TYPOLOGIES
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/balewadi/" class="px-3 py-1.5 bg-obsidian-surface border border-white/10 text-xs text-concrete hover:text-champagne hover:border-champagne transition-colors">
          Balewadi Real Estate
        </a>
        <a href="/baner/" class="px-3 py-1.5 bg-obsidian-surface border border-white/10 text-xs text-concrete hover:text-champagne hover:border-champagne transition-colors">
          Baner Luxury Flats
        </a>
        <a href="/west-pune/" class="px-3 py-1.5 bg-obsidian-surface border border-white/10 text-xs text-concrete hover:text-champagne hover:border-champagne transition-colors">
          West Pune Guide
        </a>
        <a href="/hinjewadi/" class="px-3 py-1.5 bg-obsidian-surface border border-white/10 text-xs text-concrete hover:text-champagne hover:border-champagne transition-colors">
          Hinjewadi Tech Corridor
        </a>
        <a href="/duplex/" class="px-3 py-1.5 bg-obsidian-surface border border-white/10 text-xs text-concrete hover:text-champagne hover:border-champagne transition-colors">
          3 BHK Sky Duplex
        </a>
        <a href="/penthouse/" class="px-3 py-1.5 bg-obsidian-surface border border-white/10 text-xs text-concrete hover:text-champagne hover:border-champagne transition-colors">
          Penthouse Collection
        </a>
        <a href="/mantra-meridian-riverside/price/" class="px-3 py-1.5 bg-obsidian-surface border border-white/10 text-xs text-concrete hover:text-champagne hover:border-champagne transition-colors">
          Official Pricing 2026
        </a>
        <a href="/pune-real-estate/" class="px-3 py-1.5 bg-obsidian-surface border border-white/10 text-xs text-concrete hover:text-champagne hover:border-champagne transition-colors">
          Pune Real Estate Report
        </a>
      </div>
    </nav>

  </div>
</BaseLayout>
