---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Navigation/Breadcrumbs.astro';
import FAQAccordion from '../components/FAQ/FAQAccordion.astro';
import ReraVerificationCard from '../components/Trust/ReraVerificationCard.astro';
import { duplexKeywordsList } from '../data/keywords';
import { residencesData } from '../data/residences';

export const prerender = true;

const duplexResidence = residencesData.find(r => r.slug === '3-bhk-duplex')!;

const architecturalFeatures = [
  {
    title: "20-Foot Double-Height Void",
    spec: "Dramatic Volumetric Space",
    description: "The central living room expands skyward with an unprecedented 20-foot vertical ceiling void, creating villa-scale grandeur in an elevated high-rise format."
  },
  {
    title: "Floor-to-Ceiling Riverfront Glazing",
    spec: "Acoustic Double-Glazed System",
    description: "Expansive high-performance acoustic glass panels maximize unhindered views of the Mula River corridor, bathing both lower and upper tiers in natural daylight."
  },
  {
    title: "Internal Floating Staircase",
    spec: "Sculptural Architectural Centerpiece",
    description: "A cantilevered floating staircase serves as the living area’s sculptural anchor, seamlessly connecting the social entertaining realm with the private upper mezzanine suites."
  },
  {
    title: "Private Upper Master Sanctuary",
    spec: "Complete Acoustic Isolation",
    description: "The entire upper level is dedicated to an expansive primary suite with walk-in wardrobe, spa-inspired five-fixture bathroom, and private balcony overlooking the water."
  }
];

const duplexFaqs = [
  {
    question: "What is the configuration and carpet area of the Sky Duplex at Mantra Meridian?",
    answer: "The Signature 3 BHK Sky Duplex at Mantra Meridian Riverside offers a generous 1,660 sq.ft. carpet area arranged across two meticulously zoned vertical tiers, featuring 3 bedrooms, 3 en-suite bathrooms, double-height living hall, private family lounge, and river-facing sundecks."
  },
  {
    question: "What is the price of a 3 BHK Sky Duplex at Mantra Meridian Riverside Balewadi?",
    answer: "The 3 BHK Signature Sky Duplex starts at ₹1.85 Cr* (base consideration). With floor rise and statutory levies (7% Maharashtra Stamp Duty, 5% GST, and ₹30,000 registration), the all-inclusive estimate ranges between ₹2.08 Cr* and ₹2.15 Cr*, depending on floor height and riverfront orientation."
  },
  {
    question: "How does a Sky Duplex differ from a standard single-floor 3 BHK apartment?",
    answer: "Unlike conventional single-level apartments, a Sky Duplex replicates the spatial luxury and multi-level privacy of an independent villa. With a dramatic 20-foot ceiling in the living lounge, clear acoustic separation between entertainment spaces below and restful bedrooms above, and panoramic elevated riverfront vistas, it represents the pinnacle of high-rise architectural design."
  },
  {
    question: "What is the possession date for the Sky Duplex towers at Mantra Meridian?",
    answer: "As sanctioned by MahaRERA under registration number P52100045688, project possession and handover are targeted for June 2028."
  }
];

const duplexSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "RealEstateListing",
      "@id": "https://mantrameridianriverside.com/duplex/#listing",
      "name": "3 BHK Signature Sky Duplex — Mantra Meridian Riverside Balewadi",
      "description": "Exclusive two-tier luxury sky villa featuring 20-foot double-height ceilings, 1,660 sq.ft. carpet area, and permanent Mula riverfront views.",
      "url": "https://mantrameridianriverside.com/duplex/",
      "offers": {
        "@type": "Offer",
        "price": "18500000",
        "priceCurrency": "INR",
        "availability": "https://schema.org/InStock",
        "validFrom": "2026-01-01"
      }
    }
  ]
};
---

<BaseLayout
  title="3 BHK Sky Duplex in Balewadi Pune | Mantra Meridian Riverside Volumetric Residences"
  description="Exclusive 3 BHK Signature Sky Duplexes at Mantra Meridian Riverside Balewadi. 1,660 sq.ft. carpet, 20-ft double height living ceilings, riverfront vistas from ₹1.85 Cr*."
  keywords={duplexKeywordsList}
  customSchema={duplexSchema}
>
  <div class="pt-32 pb-24 px-6 md:px-12 max-w-7xl mx-auto space-y-16">
    
    <Breadcrumbs items={[{ name: "Signature Sky Duplexes" }]} />

    {/* Hero Section */}
    <div class="max-w-3xl space-y-4">
      <span class="label-architectural text-xs text-champagne">ARCHITECTURAL SHOWCASE • VOLUMETRIC LIVING</span>
      <h1 class="font-serif text-5xl sm:text-7xl text-architectural-white font-normal leading-tight">
        The Sky Duplex.<br />
        <span class="text-champagne font-light italic font-serif">Villa Living in the Clouds.</span>
      </h1>
      <p class="text-xs sm:text-sm text-concrete leading-relaxed">
        Conceived for connoisseurs of spatial grandeur, the Signature 3 BHK Sky Duplex pairs the unconfined vertical volume of an independent bungalow with the commanding panoramic riverfront views of an elevated high-rise sanctuary.
      </p>
    </div>

    {/* Key Architectural Metrics */}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="p-6 bg-obsidian-card border border-champagne/25 space-y-1">
        <span class="font-serif text-3xl md:text-4xl text-champagne">20 FT</span>
        <span class="text-xs uppercase tracking-widest text-architectural-white block font-mono">Ceiling Void</span>
        <p class="text-[11px] text-concrete/70">Monumental living room vertical expanse.</p>
      </div>
      <div class="p-6 bg-obsidian-card border border-champagne/25 space-y-1">
        <span class="font-serif text-3xl md:text-4xl text-architectural-white">1,660</span>
        <span class="text-xs uppercase tracking-widest text-champagne block font-mono">Sq.Ft. Carpet</span>
        <p class="text-[11px] text-concrete/70">Zoned across two expansive living levels.</p>
      </div>
      <div class="p-6 bg-obsidian-card border border-champagne/25 space-y-1">
        <span class="font-serif text-3xl md:text-4xl text-architectural-white">2 TIERS</span>
        <span class="text-xs uppercase tracking-widest text-champagne block font-mono">Vertical Layout</span>
        <p class="text-[11px] text-concrete/70">Lower social salon &amp; upper private suites.</p>
      </div>
      <div class="p-6 bg-obsidian-card border border-champagne/25 space-y-1">
        <span class="font-serif text-3xl md:text-4xl text-champagne">₹1.85 CR*</span>
        <span class="text-xs uppercase tracking-widest text-architectural-white block font-mono">Base Starting</span>
        <p class="text-[11px] text-concrete/70">Exceptional value for volumetric sky villa.</p>
      </div>
    </div>

    {/* Feature Image & Architectural Highlights */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 rounded overflow-hidden border border-white/10 relative group aspect-[16/10]">
        <img
          src={duplexResidence.renderImage}
          alt="3 BHK Signature Sky Duplex Interior Living Room"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-obsidian-deep/80 via-transparent to-transparent pointer-events-none" />
        <div class="absolute bottom-6 left-6 right-6 flex justify-between items-end">
          <div>
            <span class="label-architectural text-[10px] text-champagne">ARTIST'S IMPRESSION</span>
            <p class="font-serif text-xl text-architectural-white">Double-Height Living Salon Facing Mula River</p>
          </div>
          <a
            href="/mantra-meridian-riverside/3-bhk-duplex/"
            class="btn-luxury text-xs px-4 py-2"
          >
            SPECIFICATION SHEET →
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 space-y-6">
        <div class="border-b border-white/10 pb-4">
          <span class="label-architectural text-xs text-champagne">DESIGN ANATOMY</span>
          <h2 class="font-serif text-3xl text-architectural-white mt-1">Spatial Architecture</h2>
        </div>

        <div class="space-y-4">
          {architecturalFeatures.map((feat) => (
            <div class="p-4 bg-obsidian-card border border-white/10 space-y-1 hover:border-champagne/40 transition-colors">
              <div class="flex justify-between items-center">
                <h3 class="font-serif text-base text-architectural-white">{feat.title}</h3>
                <span class="text-[10px] font-mono text-champagne">{feat.spec}</span>
              </div>
              <p class="text-xs text-concrete/70 leading-relaxed">{feat.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    {/* Section: Floor Plan and Cost Sheet CTA */}
    <div class="p-8 md:p-12 bg-gradient-to-r from-obsidian-card via-obsidian-deep to-obsidian-card border border-champagne/30 flex flex-col lg:flex-row items-center justify-between gap-8">
      <div class="space-y-3 max-w-2xl">
        <span class="label-architectural text-xs text-champagne">TRANSPARENT VALUATION</span>
        <h3 class="font-serif text-2xl md:text-3xl text-architectural-white">
          Compute Full On-Road Cost for Sky Duplex
        </h3>
        <p class="text-xs text-concrete/80 leading-relaxed">
          Access the interactive cost sheet estimator to view complete breakups for stamp duty, registration, GST, and floor rise for the 3 BHK Sky Duplex.
        </p>
      </div>
      <div class="shrink-0 flex flex-col sm:flex-row gap-4">
        <a href="/mantra-meridian-riverside/price/" class="btn-luxury text-xs px-6 py-3 whitespace-nowrap">
          CALCULATE COST SHEET →
        </a>
        <a href="/mantra-meridian-riverside/floor-plans/" class="btn-luxury-outline text-xs px-6 py-3 whitespace-nowrap">
          VIEW DUPLEX BLUEPRINT
        </a>
      </div>
    </div>

    {/* Frequently Asked Questions */}
    <div class="space-y-6 pt-6">
      <div class="border-b border-white/10 pb-4">
        <span class="label-architectural text-xs text-champagne">FREQUENTLY ASKED QUESTIONS</span>
        <h2 class="font-serif text-3xl text-architectural-white mt-1">Sky Duplex Inquiries</h2>
      </div>
      <FAQAccordion customFaqs={duplexFaqs} />
    </div>

    {/* MahaRERA Compliance */}
    <ReraVerificationCard />

  </div>
</BaseLayout>
