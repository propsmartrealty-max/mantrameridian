];

// Head-to-Head Competitive Benchmark Matrix (Balewadi Micro-Market)
const competitiveBenchmark = [
  {
    feature: "Contiguous Land Estate",
    mantraMeridian: "8.0 Continuous Acres",
    altura24k: "3.2 Acres",
    balmoralRiverside: "3.5 Acres",
