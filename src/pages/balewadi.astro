---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationIntelligence from '../components/Location/LocationIntelligence';
import InfrastructureGrowthRadar from '../components/Location/InfrastructureGrowthRadar.astro';
import FAQAccordion from '../components/FAQ/FAQAccordion.astro';
import Breadcrumbs from '../components/Navigation/Breadcrumbs.astro';
import ReraVerificationCard from '../components/Trust/ReraVerificationCard.astro';
import { balewadiKeywordsList } from '../data/keywords';

export const prerender = true;

// 6-Year Historical Capital Growth & Price Forecast Data for Balewadi (2020 - 2028)
const priceTrends = [
  { year: "2020", avgPrice: "₹6,800", yoy: "Baseline", catalyst: "Smart City arterial road widening & underground utilities" },
  { year: "2021", avgPrice: "₹7,500", yoy: "+10.3%", catalyst: "Post-pandemic surge in demand for spacious 3 & 4 BHK residences" },
  { year: "2022", avgPrice: "₹8,300", yoy: "+10.7%", catalyst: "Balewadi High Street emergence as West Pune's premier dining hub" },
  { year: "2023", avgPrice: "₹9,200", yoy: "+10.8%", catalyst: "PMRDA Metro Line 3 viaduct execution & Hinjewadi commute optimism" },
  { year: "2024", avgPrice: "₹10,400", yoy: "+13.0%", catalyst: "Approval of the 45m Balewadi-Wakad Mula River Bridge connection" },
  { year: "2025", avgPrice: "₹11,600", yoy: "+11.5%", catalyst: "Rapid price spillover from land-exhausted Baner into Balewadi" },
  { year: "2026 (Current)", avgPrice: "₹12,800", yoy: "+10.3%", catalyst: "Pre-launch of 8-acre continuous riverfront estates at Mantra Meridian" },
  { year: "2028 (Projected)", avgPrice: "₹15,500 - ₹17,000", yoy: "+25%+", catalyst: "Commissioning of Metro Line 3, Wakad Bridge & PMC Riverfront Promenade" }
];

// Rental Yield & Executive Housing Demand Matrix
const rentalYields = [
  {
    typology: "2 BHK Contemporary",
    carpetArea: "810 - 875 sq.ft.",
