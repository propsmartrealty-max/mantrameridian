// Social & Institutional Proximity Radar
const institutionalRadar = [
  {
    category: "Elite Education",
    items: [
      { name: "Bharati Vidyapeeth English Medium School", distance: "1.1 km", time: "3 mins" },
      { name: "The Orchid School (CBSE)", distance: "1.8 km", time: "5 mins" },
      { name: "Vibgyor High School Balewadi", distance: "2.4 km", time: "6 mins" },
      { name: "CM International School", distance: "2.6 km", time: "7 mins" }
    ]
  },
  {
    category: "Multi-Specialty Healthcare",
    items: [
      { name: "Jupiter Hospital Baner", distance: "3.2 km", time: "8 mins" },
      { name: "Manipal Hospital Baner-Balewadi", distance: "3.8 km", time: "9 mins" },
      { name: "Surya Mother & Child Super Specialty", distance: "4.1 km", time: "10 mins" },
