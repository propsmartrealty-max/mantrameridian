---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Navigation/Breadcrumbs.astro';
import FAQAccordion from '../components/FAQ/FAQAccordion.astro';
import ReraVerificationCard from '../components/Trust/ReraVerificationCard.astro';
import { residencesData } from '../data/residences';
import { aggregateRatingData, verifiedReviews } from '../data/reviews';

export const prerender = true;

const penthouseCollection = [
  {
    title: "4 BHK Grand Riverside Estate",
    category: "The Riverfront Sky Villa",
    carpet: "1,920 - 2,180 sq.ft.",
    price: "₹2.85 Cr* onwards",
    heroImage: residencesData.find(r => r.slug === '4-bhk')?.renderImage || "/assets/mantra-meridian-hero.webp",
    detailUrl: "/mantra-meridian-riverside/4-bhk/",
    highlights: [
      "Private elevator access opening into an exclusive private foyer",
      "Expansive wrap-around sky sundeck offering unhindered 270° Mula river vistas",
      "Dual primary master suites with dedicated dressing salons and 5-fixture luxury baths",
      "Dedicated domestic staff suite with independent service ingress"
    ]
  },
  {
    title: "3 BHK Signature Sky Duplex",
    category: "The Two-Tier Volumetric Penthouse",
    carpet: "1,660 sq.ft.",
    price: "₹2.25 Cr* onwards",
    heroImage: residencesData.find(r => r.slug === '3-bhk-duplex')?.renderImage || "/assets/mantra-meridian-hero.webp",
    detailUrl: "/duplex/",
    highlights: [
      "Monumental 20-foot vertical ceiling void in the central living and dining salon",
      "Sculptural floating staircase separating social entertaining from family suites",
      "Private upper mezzanine master sanctuary with private riverfront viewing deck",
      "Double-glazed acoustic curtain wall system bathing both tiers in soft natural light"
    ]
  }
];

const penthouseSpecs = [
  {
    feature: "Private Foyer & Elevator Access",
    detail: "Direct, secure elevator access with biometric authorization opening into your personalized entrance lobby."
  },
  {
    feature: "Acoustic Double-Glazed Fenestration",
    detail: "Heavy-duty extruded aluminum double-glazed windows providing sound isolation and superior thermal efficiency."
  },
  {
    feature: "Designer Sanitaryware & Brassware",
    detail: "Fitted with imported German sanitary fittings (Grohe/Kohler), concealed cisterns, and thermostatic diverters."
  },
  {
    feature: "Smart Home & Climate Automation",
    detail: "Integrated smart control modules for lighting scenes, automated curtain tracks, and HVAC zoning."
  }
];

const penthouseFaqs = [
  {
    question: "What is the starting price for penthouses and sky villas at Mantra Meridian Balewadi?",
    answer: "The penthouse and sky villa collection starts at ₹2.25 Cr* for the 3 BHK Signature Sky Duplex (1,660 sq.ft. carpet) and ₹2.85 Cr* for the 4 BHK Grand Riverside Estate (up to 2,180 sq.ft. carpet). All prices are subject to floor rise and statutory taxes."
  },
  {
    question: "Do the penthouses offer private river views?",
    answer: "Yes. Positioned on the topmost floors directly along the Mula River corridor, these residences offer permanent, unblockable 270-degree views of the river and the western hill horizons."
  },
  {
    question: "Can buyers customize interior floor layouts during construction?",
    answer: "Subject to structural RCC approval and plumbing shaft constraints, Mantra Properties provides bespoke interior consultation for penthouse owners wishing to combine suites or customize living layouts."
  },
  {
    question: "What is the possession timeline for the penthouse towers?",
    answer: "The sanctioned completion date under MahaRERA registration number P52100045688 is June 2028."
  }
];

const penthouseSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Product", "SingleFamilyResidence", "Apartment", "RealEstateListing"],
      "@id": "https://mantrameridianriverside.com/penthouse/#product",
      "name": "Penthouse & Sky Villa Collection — Mantra Meridian Riverside Balewadi",
      "description": "Ultra-luxury 3 BHK Sky Duplexes and 4 BHK Grand Riverside Estates featuring 20ft ceilings, private elevator foyers, wrap-around terraces, and unhindered Mula river views. MahaRERA No. P52100045688.",
      "url": "https://mantrameridianriverside.com/penthouse/",
      "image": [
        "https://mantrameridianriverside.com/assets/images/properties/mantra-meridian-slider-1322045233.webp",
        "https://mantrameridianriverside.com/assets/mantra-meridian-hero.webp"
      ],
      "sku": "MMR-PENTHOUSE-2026",
      "mpn": "MMR-RES-PENTHOUSE",
      "brand": {
        "@type": "Brand",
        "name": "Mantra Properties"
      },
      "category": "Real Estate > Residential Apartments > Penthouses & Sky Villas",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": aggregateRatingData.ratingValue,
        "bestRating": aggregateRatingData.bestRating,
        "worstRating": aggregateRatingData.worstRating,
        "ratingCount": aggregateRatingData.ratingCount,
        "reviewCount": aggregateRatingData.reviewCount
      },
      "review": verifiedReviews.slice(0, 3).map((rev) => ({
        "@type": "Review",
        "author": { "@type": "Person", "name": rev.author },
        "datePublished": rev.date,
        "reviewRating": {
          "@type": "Rating",
          "ratingValue": rev.rating,
          "bestRating": 5,
          "worstRating": 1
        },
        "reviewBody": rev.body
      })),
      "offers": {
        "@type": "AggregateOffer",
        "url": "https://mantrameridianriverside.com/penthouse/",
        "lowPrice": 22500000,
        "highPrice": 35000000,
        "priceCurrency": "INR",
        "offerCount": 2,
        "availability": "https://schema.org/InStock",
        "itemCondition": "https://schema.org/NewCondition",
        "priceValidUntil": "2028-06-30",
        "seller": {
          "@type": "RealEstateAgent",
          "name": "Mantra Meridian Riverside",
          "url": "https://mantrameridianriverside.com/"
        },
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": "IN",
          "returnPolicyCategory": "https://schema.org/MerchantReturnNotPermitted",
          "merchantReturnLink": "https://mantrameridianriverside.com/terms/"
        },
        "shippingDetails": {
          "@type": "OfferShippingDetails",
          "shippingRate": { "@type": "MonetaryAmount", "value": "0", "currency": "INR" },
          "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "IN" }
        }
      }
    }
  ]
};
---

<BaseLayout
  title="Luxury Riverfront Penthouses in Balewadi Pune | Mantra Meridian Sky Villas"
  description="Ultra-luxury riverfront penthouses and 4 BHK Sky Villas at Mantra Meridian Riverside Balewadi. Wrap-around terraces, private elevators, 20-ft ceiling voids from ₹1.85 Cr*."
  keywords="Penthouse in Balewadi Pune, luxury penthouses West Pune, Mantra Meridian penthouse price, 4 BHK sky villa Balewadi, duplex penthouse Pune Mula River"
  customSchema={penthouseSchema}
>
  <div class="pt-32 pb-24 px-6 md:px-12 max-w-7xl mx-auto space-y-16">
    
    <Breadcrumbs items={[{ name: "Penthouse & Sky Villa Collection" }]} />

    {/* Hero Section */}
    <div class="max-w-3xl space-y-4">
      <span class="label-architectural text-xs text-champagne">ULTRA-LUXURY RESIDENCES • PINNACLE COLLECTION</span>
      <h1 class="font-serif text-5xl sm:text-7xl text-architectural-white font-normal leading-tight">
        The Penthouses.<br />
        <span class="text-champagne font-light italic font-serif">Commanding the Skyline.</span>
      </h1>
      <p class="text-xs sm:text-sm text-concrete leading-relaxed">
        Perched atop Mantra Meridian’s contemporary residential towers, the Penthouse Collection pairs volumetric vertical architecture with endless horizons over the gentle waters of the Mula River.
      </p>
    </div>

    {/* Penthouse Showcase Cards */}
    <div class="space-y-12">
      {penthouseCollection.map((pen, idx) => (
        <div class={`p-8 md:p-12 bg-obsidian-card border border-champagne/30 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center ${idx % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}>
          <div class="lg:col-span-7 rounded overflow-hidden relative group aspect-[16/10]">
            <img
              src={pen.heroImage}
              alt={pen.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-obsidian-deep/80 via-transparent to-transparent pointer-events-none" />
            <div class="absolute top-4 left-4 badge-beige">
              <span class="text-[9px] text-beige-warm font-mono">{pen.category}</span>
            </div>
            <div class="absolute bottom-4 right-4 text-xs font-mono text-champagne bg-obsidian-deep/90 px-3 py-1 border border-champagne/30">
              {pen.carpet}
            </div>
          </div>

          <div class="lg:col-span-5 space-y-6">
            <div>
              <span class="text-[10px] font-mono text-champagne uppercase tracking-widest">{pen.category}</span>
              <h2 class="font-serif text-3xl text-architectural-white mt-1">{pen.title}</h2>
              <p class="font-mono text-lg text-champagne font-semibold mt-2">{pen.price}</p>
            </div>

            <ul class="space-y-2.5 text-xs text-concrete/80">
              {pen.highlights.map((point) => (
                <li class="flex items-start gap-2">
                  <span class="text-champagne font-bold">✓</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>

            <div class="pt-2 flex flex-wrap gap-4">
              <a href={pen.detailUrl} class="btn-luxury text-xs px-5 py-2.5">
                VIEW FULL BLUEPRINT →
              </a>
              <a href="/mantra-meridian-riverside/price/" class="btn-luxury-outline text-xs px-5 py-2.5">
                ITEMIZED COST SHEET
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    {/* Architectural Specifications Grid */}
    <div class="space-y-8">
      <div class="border-b border-white/10 pb-4">
        <span class="label-architectural text-xs text-champagne">EXCLUSIVE SPECIFICATIONS</span>
        <h2 class="font-serif text-3xl text-architectural-white mt-1">Penthouse Craftsmanship</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {penthouseSpecs.map((spec) => (
          <div class="p-6 bg-obsidian-card border border-white/10 space-y-3 hover:border-champagne/40 transition-colors">
            <h3 class="font-serif text-lg text-architectural-white">{spec.feature}</h3>
            <p class="text-xs text-concrete/70 leading-relaxed">{spec.detail}</p>
          </div>
        ))}
      </div>
    </div>

    {/* VIP Presentation CTA */}
    <div class="p-8 md:p-12 bg-gradient-to-r from-obsidian-card via-obsidian-deep to-obsidian-card border border-champagne/30 flex flex-col lg:flex-row items-center justify-between gap-8">
      <div class="space-y-3 max-w-2xl">
        <span class="label-architectural text-xs text-champagne">BESPOKE PREVIEW</span>
        <h3 class="font-serif text-2xl md:text-3xl text-architectural-white">
          Reserve a Private Penthouse Architectural Briefing
        </h3>
        <p class="text-xs text-concrete/80 leading-relaxed">
          Schedule a one-on-one session with our senior project architects to review structural plans, MEP layouts, and sunrise-to-sunset riparian view orientations.
        </p>
      </div>
      <div class="shrink-0 flex flex-col sm:flex-row gap-4">
        <a
          href="https://wa.me/912067082699?text=Hello%20Mantra%20Meridian%2C%20I%20am%20interested%20in%20the%20Penthouse%20%26%20Sky%20Villa%20collection%20and%20would%20like%20to%20schedule%20a%20private%20briefing."
          target="_blank"
          rel="noopener noreferrer"
          class="btn-luxury text-xs px-6 py-3 whitespace-nowrap flex items-center gap-2"
        >
          <span>WHATSAPP VIP DESK</span>
          <span>↗</span>
        </a>
        <a href="/mantra-meridian-riverside/documents/" class="btn-luxury-outline text-xs px-6 py-3 whitespace-nowrap">
          DOWNLOAD PENTHOUSE BROCHURE
        </a>
      </div>
    </div>

    {/* Frequently Asked Questions */}
    <div class="space-y-6 pt-6">
      <div class="border-b border-white/10 pb-4">
        <span class="label-architectural text-xs text-champagne">PENTHOUSE INQUIRIES</span>
        <h2 class="font-serif text-3xl text-architectural-white mt-1">Penthouse FAQs</h2>
      </div>
      <FAQAccordion customFaqs={penthouseFaqs} />
    </div>

    {/* MahaRERA Compliance */}
    <ReraVerificationCard />

  </div>
</BaseLayout>
