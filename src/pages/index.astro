---
import BaseLayout from '../layouts/BaseLayout.astro';
import CinematicHero from '../components/Hero/CinematicHero.astro';
import RiversideManifesto from '../components/Story/RiversideManifesto.astro';
import ArchitecturalDataStrip from '../components/Stats/ArchitecturalDataStrip.astro';
import RiversideExperience from '../components/Riverside/RiversideExperience.astro';
import DesignPhilosophy from '../components/Architecture/DesignPhilosophy.astro';
import FloorPlanViewer from '../components/FloorPlan/FloorPlanViewer';
import AmenityAtlas from '../components/Amenity/AmenityAtlas';
import MasterplanExplorer from '../components/Masterplan/MasterplanExplorer';
import LocationIntelligence from '../components/Location/LocationIntelligence';
import VisualArchive from '../components/Gallery/VisualArchive';
import DocumentCentre from '../components/Documents/DocumentCentre.astro';
import ReraVerificationCard from '../components/Trust/ReraVerificationCard.astro';
import FAQAccordion from '../components/FAQ/FAQAccordion.astro';
import AIKnowledgeOverview from '../components/AI/AIKnowledgeOverview.astro';
import VirtualWalkthrough from '../components/VirtualTour/VirtualWalkthrough';
import EMICalculator from '../components/Finance/EMICalculator';
import ConstructionTracker from '../components/Construction/ConstructionTracker.astro';
import InfrastructureGrowthRadar from '../components/Location/InfrastructureGrowthRadar.astro';
import ClientReviews from '../components/Reviews/ClientReviews.astro';
import { residencesData } from '../data/residences';
import { journalArticles } from '../data/journal';
import { projectData } from '../data/project';
import { defaultMetaKeywords } from '../data/keywords';

export const prerender = true;
---

<BaseLayout
  title="Mantra Meridian Riverside Balewadi | Luxury 2, 3, 4 BHK & Duplexes Pune"
  description="Official portal of Mantra Meridian Riverside in Balewadi, Pune by Mantra Properties. 8-acre development along Mula River offering 2, 3, 4 BHK flats & Duplexes. MahaRERA P52100045688."
  keywords={defaultMetaKeywords}
>
  
  {/* 01. 100vh Cinematic Hero */}
  <CinematicHero />

  {/* 02. Architectural Data Strip */}
  <ArchitecturalDataStrip />

  {/* 03. Emotional Manifesto & Project Story */}
  <RiversideManifesto />

  {/* 04. Residence Explorer */}
  <section id="residences" class="w-full relative py-24 md:py-32 border-b border-white/10 overflow-hidden">
    {/* Ambient Section Glow */}
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-champagne/5 rounded-full blur-3xl pointer-events-none -z-10" />

    <div class="max-w-7xl mx-auto px-6 md:px-12 space-y-16">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="max-w-2xl space-y-3">
          <span class="label-architectural text-xs text-champagne">CURATED LIVING FORMATS</span>
          <h2 class="font-display text-4xl sm:text-6xl text-gradient-pearl font-normal leading-[1.05]">
            Designed for Elegance,<br />
            <span class="text-champagne font-light italic font-serif">Built for Comfort.</span>
          </h2>
          <p class="text-xs sm:text-sm text-concrete leading-relaxed">
            Spacious 2, 3 &amp; 4 BHK riverside residences and exclusive 3 BHK sky duplexes nestled steps from the Mula river in Balewadi.
          </p>
        </div>

        <a
          href="/mantra-meridian-riverside/residences/"
          class="btn-luxury-outline text-xs whitespace-nowrap self-start md:self-auto glass-sheen"
        >
          EXPLORE ALL CONFIGURATIONS →
        </a>
      </div>

      {/* Grid of Residence Cards */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {residencesData.map((res) => (
          <div class="group card-beige-luxury border-animated-beam glass-sheen flex flex-col justify-between overflow-hidden">
            
            {/* Card Image */}
            <div class="relative aspect-[16/10] overflow-hidden">
              <img
                src={res.renderImage}
                alt={`${res.name} - Mantra Meridian Riverside`}
                class="w-full h-full object-cover object-center filter brightness-95 group-hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-obsidian-deep via-obsidian-deep/30 to-transparent" />
              
              <div class="absolute top-4 left-4 badge-beige">
                <span class="text-[9px] text-beige-warm font-mono">{res.type}</span>
              </div>

              <div class="absolute bottom-4 right-4 badge-beige text-xs font-mono text-beige-warm">
                {res.carpetAreaRange}
              </div>
            </div>

            {/* Card Body */}
            <div class="p-6 md:p-8 space-y-4 flex-grow flex flex-col justify-between">
              <div>
                <h3 class="font-serif text-2xl sm:text-3xl text-architectural-white group-hover:text-champagne transition-colors">
                  {res.name}
                </h3>
                <p class="text-xs text-champagne font-mono mt-1 tracking-wide">
                  {res.balconyType}
                </p>
                <p class="text-xs text-concrete leading-relaxed mt-3 font-sans">
                  {res.subtitle}
                </p>

                {/* Micro specs */}
                <div class="pt-4 border-t border-beige-border mt-4 grid grid-cols-2 gap-3 text-[11px] text-concrete">
                  <div class="p-2.5 bg-obsidian-surface/90 border border-beige-border">
                    <span class="text-beige-stone block text-[9px] uppercase font-mono">Bathrooms</span>
                    <span class="text-beige-warm font-medium">{res.bathrooms} Luxury Baths</span>
                  </div>
                  <div class="p-2.5 bg-obsidian-surface/90 border border-beige-border">
                    <span class="text-beige-stone block text-[9px] uppercase font-mono">Levels</span>
                    <span class="text-beige-warm font-medium">{res.levels === 2 ? 'Two Tiers (Duplex)' : 'Single Level'}</span>
                  </div>
                </div>
              </div>

              <div class="pt-6 border-t border-white/5 flex items-center justify-between">
                <a
                  href={`/mantra-meridian-riverside/${res.slug}/`}
                  class="btn-luxury text-xs w-full text-center"
                >
                  EXPLORE {res.type} RESIDENCE →
                </a>
              </div>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  {/* 05. The Riverside Experience */}
  <RiversideExperience />

  {/* 06. Interactive Floor Plan Experience Island */}
  <section id="floor-plans" class="w-full bg-obsidian py-24 md:py-32 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12 space-y-12">
      
      <div class="max-w-2xl space-y-3">
        <span class="label-architectural text-xs text-champagne">SPATIAL PRECISION</span>
        <h2 class="font-serif text-4xl sm:text-6xl text-architectural-white font-normal leading-[1.05]">
          Interactive<br />
          <span class="text-champagne font-light italic">Floor Plan Suite.</span>
        </h2>
        <p class="text-xs sm:text-sm text-concrete leading-relaxed">
          Switch between architectural 2D blueprints and spatial volumes. Inspect individual chambers, dimensions, and riverfront orientations.
        </p>
      </div>

      <FloorPlanViewer client:visible defaultResidenceId="3bhk" />

    </div>
  </section>

  {/* 06B. Financial & Investment Estimator */}
  <section id="mortgage-planner" class="w-full relative py-16 px-6 md:px-12 border-b border-white/10">
    <div class="max-w-7xl mx-auto">
      <EMICalculator client:visible />
    </div>
  </section>

  {/* 07. Architecture In Dialogue With Nature */}
  <DesignPhilosophy />

  {/* 08. Virtual Walkthrough & 3D Immersion Island */}
  <section id="virtual-tour" class="w-full bg-obsidian-deep py-24 md:py-32 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12 space-y-12">
      <div class="max-w-3xl space-y-3">
        <span class="label-architectural text-xs text-champagne">3D SPATIAL IMMERSION</span>
        <h2 class="font-serif text-4xl sm:text-6xl text-architectural-white font-normal leading-[1.05]">
          Virtual Walkthrough.<br />
          <span class="text-champagne font-light italic">Experience Meridian in 3D.</span>
        </h2>
        <p class="text-xs sm:text-sm text-concrete leading-relaxed">
          Step inside the official Matterport 3D digital twin or watch high-definition video walkthroughs of the living towers and sky duplexes.
        </p>
      </div>

      <VirtualWalkthrough client:visible />
    </div>
  </section>

  {/* 09. Amenity Atlas Island */}
  <section id="amenities" class="w-full bg-obsidian py-24 md:py-32 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12 space-y-12">
      
      <div class="max-w-3xl space-y-3">
        <span class="label-architectural text-xs text-champagne">A LIFE WELL CURATED</span>
        <h2 class="font-serif text-4xl sm:text-6xl text-architectural-white font-normal leading-[1.05]">
          The Amenity Atlas.<br />
          <span class="text-champagne font-light italic">Over 30 Curated Spaces.</span>
        </h2>
        <p class="text-xs sm:text-sm text-concrete leading-relaxed">
          Forget generic amenity checklists. Discover eight visual chapters dedicated to restorative wellness, private entertaining, competitive sport, and riverside nature.
        </p>
      </div>

      <AmenityAtlas client:visible />

    </div>
  </section>

  {/* 09. Masterplan Explorer Island */}
  <section id="masterplan" class="w-full bg-obsidian-deep py-24 md:py-32 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12 space-y-12">
      
      <div class="max-w-3xl space-y-3">
        <span class="label-architectural text-xs text-champagne">ESTATE ARCHITECTURE</span>
        <h2 class="font-serif text-4xl sm:text-6xl text-architectural-white font-normal leading-[1.05]">
          An 8-Acre Sanctuary<br />
          <span class="text-champagne font-light italic">Designed as a Whole.</span>
        </h2>
        <p class="text-xs sm:text-sm text-concrete leading-relaxed">
          Explore the master zoning of living towers, open landscaped spaces, the central clubhouse, and the 500-metre Mula riverfront boardwalk.
        </p>
      </div>

      <MasterplanExplorer client:visible />

    </div>
  </section>

  {/* 10. Location Intelligence Island */}
  <section id="location" class="w-full bg-obsidian py-24 md:py-32 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12 space-y-12">
      
      <div class="max-w-3xl space-y-3">
        <span class="label-architectural text-xs text-champagne">BALEWADI • WEST PUNE</span>
        <h2 class="font-serif text-4xl sm:text-6xl text-architectural-white font-normal leading-[1.05]">
          At the Crossroads of<br />
          <span class="text-champagne font-light italic">Nature &amp; Connectivity.</span>
        </h2>
        <p class="text-xs sm:text-sm text-concrete leading-relaxed">
          Situated along the Mula river on Balewadi Village Road, just 5 minutes from Balewadi High Street, close to the proposed metro, and seamlessly linked to Wakad via a planned bridge.
        </p>
      </div>

      <LocationIntelligence client:visible />

    </div>
  </section>

  {/* 10B. Transformational Infrastructure Radar */}
  <InfrastructureGrowthRadar />

  {/* 10C. Pune Real Estate Benchmark & Citywide Dominance Section */}
  <section id="pune-benchmark" class="w-full bg-obsidian py-20 px-6 md:px-12 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-7xl mx-auto space-y-12">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="max-w-2xl space-y-3">
          <span class="label-architectural text-xs text-champagne">CITYWIDE LUXURY BENCHMARK (2026–2030)</span>
          <h2 class="font-serif text-3xl sm:text-5xl text-architectural-white font-normal leading-[1.1]">
            Why Balewadi Leads<br />
            <span class="text-champagne font-light italic">Pune's Real Estate Landscape.</span>
          </h2>
          <p class="text-xs sm:text-sm text-concrete leading-relaxed">
            From 4.4% rental yields to the Mula riverfront promenade, see how Mantra Meridian Riverside outclasses conventional developments in Baner, Kharadi, and Koregaon Park.
          </p>
        </div>
        <a
          href="/pune-real-estate/"
          class="btn-luxury-outline text-xs whitespace-nowrap self-start md:self-auto glass-sheen"
        >
          EXPLORE PUNE MARKET INDEX →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="glass-card-luxury p-6 border border-white/10 space-y-2">
          <span class="text-[10px] font-mono uppercase text-champagne block">CAPITAL APPRECIATION</span>
          <div class="text-2xl font-serif text-architectural-white font-medium">11.8% CAGR</div>
          <p class="text-xs text-concrete/70 leading-relaxed">Forecasted 5-year growth accelerated by Hinjewadi-Shivajinagar Metro Line 3.</p>
        </div>
        <div class="glass-card-luxury p-6 border border-white/10 space-y-2">
          <span class="text-[10px] font-mono uppercase text-champagne block">PRIME RENTAL YIELD</span>
          <div class="text-2xl font-serif text-architectural-white font-medium">4.0% – 4.4%</div>
          <p class="text-xs text-concrete/70 leading-relaxed">Top-quartile Pune rental yield driven by corporate and IT senior leadership tenancy.</p>
        </div>
        <div class="glass-card-luxury p-6 border border-white/10 space-y-2">
          <span class="text-[10px] font-mono uppercase text-champagne block">OPEN SPACE DENSITY</span>
          <div class="text-2xl font-serif text-architectural-white font-medium">75%+ Green Area</div>
          <p class="text-xs text-concrete/70 leading-relaxed">8-acre contiguous riparian masterplan versus fragmented 1-2 acre city infill plots.</p>
        </div>
        <div class="glass-card-luxury p-6 border border-white/10 space-y-2">
          <span class="text-[10px] font-mono uppercase text-champagne block">PRICE-TO-SPACE VALUE</span>
          <div class="text-2xl font-serif text-architectural-white font-medium">₹ 85L* to ₹ 2.40 Cr*</div>
          <p class="text-xs text-concrete/70 leading-relaxed">Luxury 2, 3, 4 BHK &amp; Sky Duplexes delivering 2x the space of East Pune at identical pricing.</p>
        </div>
      </div>
    </div>
  </section>

  {/* 11. Visual Archive Island */}
  <section id="gallery" class="w-full bg-obsidian-deep py-24 md:py-32 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12 space-y-12">
      
      <div class="max-w-3xl space-y-3">
        <span class="label-architectural text-xs text-champagne">VISUAL CURATION</span>
        <h2 class="font-serif text-4xl sm:text-6xl text-architectural-white font-normal leading-[1.05]">
          The Meridian Archive.<br />
          <span class="text-champagne font-light italic">A Photographic Monograph.</span>
        </h2>
        <p class="text-xs sm:text-sm text-concrete leading-relaxed">
          Immerse yourself in architectural dusk elevations, double-height interior void perspectives, and peaceful riverside vistas.
        </p>
      </div>

      <VisualArchive client:visible />

    </div>
  </section>

  {/* 12. Document Centre */}
  <section id="documents" class="w-full bg-obsidian py-20 px-6 md:px-12 border-b border-white/10">
    <div class="max-w-7xl mx-auto">
      <DocumentCentre />
    </div>
  </section>

  {/* 12B. Construction Milestones & Sanctioned Progress */}
  <ConstructionTracker />

  {/* 13. RERA Card Verification */}
  <section id="rera" class="w-full bg-obsidian-deep py-16 px-6 md:px-12 border-b border-white/10">
    <div class="max-w-7xl mx-auto">
      <ReraVerificationCard />
    </div>
  </section>

  {/* 14. The Meridian Journal Editorial Teaser */}
  <section id="journal" class="w-full bg-obsidian py-24 md:py-32 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-6 md:px-12 space-y-16">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="max-w-2xl space-y-3">
          <span class="label-architectural text-xs text-champagne">INTELLIGENCE &amp; PERSPECTIVE</span>
          <h2 class="font-serif text-4xl sm:text-6xl text-architectural-white font-normal leading-[1.05]">
            The Meridian Journal.<br />
            <span class="text-champagne font-light italic">Essays on Architecture &amp; Living.</span>
          </h2>
          <p class="text-xs sm:text-sm text-concrete leading-relaxed">
            Thought leadership exploring West Pune urban mobility, biophilic riverside design, and comparative micro-market analyses.
          </p>
        </div>

        <a
          href="/mantra-meridian-riverside/journal/"
          class="btn-luxury-outline text-xs whitespace-nowrap self-start md:self-auto"
        >
          VIEW ALL ESSAYS →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {journalArticles.slice(0, 3).map((art) => (
          <a
            href={`/mantra-meridian-riverside/journal/${art.slug}/`}
            class="group glass-card-luxury glass-sheen flex flex-col justify-between overflow-hidden"
          >
            <div class="aspect-[16/10] overflow-hidden relative">
              <img
                src={art.heroImage}
                alt={art.title}
                class="w-full h-full object-cover object-center filter brightness-90 group-hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute top-3 left-3 text-[9px] font-mono text-champagne px-2.5 py-1 glass-pill border border-champagne/30">
                {art.category.toUpperCase()}
              </div>
            </div>

            <div class="p-6 space-y-3 flex-grow flex flex-col justify-between">
              <div>
                <div class="text-[10px] text-concrete/70 font-mono">{art.publishDate} • {art.readTime}</div>
                <h3 class="font-serif text-xl text-architectural-white group-hover:text-champagne transition-colors mt-1 leading-snug">
                  {art.title}
                </h3>
                <p class="text-xs text-concrete/80 leading-relaxed mt-2 line-clamp-2">
                  {art.summary}
                </p>
              </div>

              <div class="pt-4 border-t border-white/5 flex items-center gap-1.5 text-xs text-champagne font-medium">
                <span>READ ARTICLE</span>
                <span>→</span>
              </div>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  {/* 14B. Verified Resident & Investor Reviews (Google 5-Star Snippet Source) */}
  <ClientReviews />

  {/* 15. Contextual FAQ Section with Schema */}
  <section class="w-full bg-obsidian-deep py-24 md:py-32 border-b border-white/10">
    <div class="max-w-4xl mx-auto px-6 md:px-12 space-y-12">
      
      <div class="text-center space-y-3">
        <span class="label-architectural text-xs text-champagne">FREQUENTLY ASKED QUESTIONS</span>
        <h2 class="font-serif text-4xl sm:text-5xl text-architectural-white font-normal">
          Answers &amp; Verification.
        </h2>
        <p class="text-xs text-concrete max-w-lg mx-auto">
          Clear, factual answers regarding project status, configurations, MahaRERA registration, and Balewadi connectivity.
        </p>
      </div>

      <FAQAccordion limit={6} />

      {/* 15B. AI Search Knowledge Matrix & Fact Sheet (GEO / AEO Optimization) */}
      <AIKnowledgeOverview />

    </div>
  </section>

  {/* 16. Final Call to Action */}
  <section class="relative w-full py-32 px-6 md:px-12 text-center overflow-hidden">
    {/* Ambient Glows */}
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] bg-champagne/8 rounded-full blur-3xl pointer-events-none -z-10" />

    <div class="max-w-4xl mx-auto p-8 sm:p-14 glass-card-luxury relative z-10 border border-champagne/25 shadow-luxury-gold">
      <div class="max-w-2xl mx-auto space-y-6">
        <span class="label-architectural text-xs tracking-luxury text-champagne">PRIVATE RESERVATIONS</span>
        <h2 class="font-display text-4xl sm:text-6xl md:text-7xl text-gradient-pearl font-normal leading-tight">
          Life, Reimagined<br />
          <span class="text-champagne font-light italic font-serif">by the Riverside.</span>
        </h2>
        <p class="text-xs sm:text-sm text-concrete max-w-xl mx-auto leading-relaxed">
          Experience the serenity of the Mula river and contemporary architectural luxury in Balewadi. Schedule an exclusive private tour with our senior relationship director.
        </p>

        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
          <button
            id="final-presentation-trigger"
            class="btn-luxury w-full sm:w-auto text-xs glass-sheen"
          >
            <span>REQUEST A PRIVATE PRESENTATION</span>
            <span>→</span>
          </button>
          <a
            href={`tel:${projectData.contact.phone.replace(/\s+/g, '')}`}
            class="btn-luxury-outline w-full sm:w-auto text-xs glass-sheen"
          >
            CALL DIRECT CONCIERGE DESK
          </a>
        </div>

        <div class="pt-6">
          <div class="glass-pill inline-flex items-center gap-2 px-3 py-1.5 text-[10px] font-mono text-concrete/70 border border-white/10">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span>MahaRERA: <strong class="text-champagne font-semibold">{projectData.reraNumber}</strong> • Balewadi, Pune</span>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const finalBtn = document.getElementById('final-presentation-trigger');
  finalBtn?.addEventListener('click', () => {
    window.dispatchEvent(
      new CustomEvent('open-private-presentation', {
        detail: { config: 'All Configurations', intent: 'FINAL CTA PRESENTATION' }
      })
    );
  });
</script>
