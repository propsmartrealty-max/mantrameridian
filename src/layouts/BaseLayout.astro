      }
    },
    {
      "@type": "WebPage",
      "@id": `${computedCanonical}#webpage`,
      "url": computedCanonical,
      "name": title,
      "description": description,
      "keywords": keywords,
      "isPartOf": {
        "@id": "https://mantrameridianriverside.com/#website"
      },
