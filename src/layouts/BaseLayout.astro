// Seamlessly merge page-specific schemas (e.g. SingleFamilyResidence, Offer, Article, FAQPage)
if (customSchema) {
  if (Array.isArray((customSchema as any)['@graph'])) {
    coreGraph.push(...(customSchema as any)['@graph']);
  } else {
    const { '@context': _context, ...schemaObj } = customSchema as any;
    coreGraph.push(schemaObj);
  }
}

const unifiedSchema = {
  "@context": "https://schema.org",
  "@graph": coreGraph
};

// Normalize ogImage to ensure absolute URL for social scrapers
const absoluteOgImage = ogImage.startsWith('http')
  ? ogImage
  : `https://mantrameridianriverside.com${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;
// Support dynamic Google Search Console verification token from environment variables
const googleSiteVerification = (import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || import.meta.env.GOOGLE_SITE_VERIFICATION || "G-VERIFY-MANTRA-MERIDIAN").trim();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    {/* Authoritative Domain Normalization: Instantly Heal www to Apex */}
    <script is:inline>
      if (window.location.hostname === 'www.mantrameridianriverside.com') {
        window.location.replace('https://mantrameridianriverside.com' + window.location.pathname + window.location.search + window.location.hash);
      }
    </script>
    <meta name="theme-color" content="#07080A" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Mantra Meridian" />
    <meta name="application-name" content="Mantra Meridian Riverside Balewadi" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" sizes="any" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    {/* Primary SEO Meta Tags */}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="brand-aliases" content="Mantra Meridian, Mantra Balewadi, Mantra Riverside, Mantra Riverside Balewadi, Mantra Meridian Balewadi" />
    <meta name="search-authority" content="Mantra Meridian Balewadi | Mantra Riverside Balewadi" />
    <link rel="canonical" href={computedCanonical} />
    <link rel="alternate" hreflang="en-IN" href={computedCanonical} />
    <link rel="alternate" hreflang="x-default" href={computedCanonical} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot-image" content="index, follow" />
    <meta name="googlebot-news" content="index, follow" />

    {/* AI Search & Generative Engine Optimization (GEO / AEO) Signals */}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="AI Search & LLM Context Monograph" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Complete AI Search Monograph" />
    <meta name="ai-content-declaration" content="factual-monograph" />
    <meta name="chatgpt-search:enable" content="true" />
    <meta name="perplexity:enable" content="true" />

    {/* Google Search Central & Console Verification */}
    <meta name="google-site-verification" content={googleSiteVerification} />

    {/* Local SEO Geo Tags for Balewadi, Pune */}
    <meta name="geo.region" content="IN-MH" />
    <meta name="geo.placename" content="Balewadi, Pune" />
    <meta name="geo.position" content={`${projectData.coordinates.latitude};${projectData.coordinates.longitude}`} />
    <meta name="ICBM" content={`${projectData.coordinates.latitude}, ${projectData.coordinates.longitude}`} />

    {/* Open Graph / Facebook */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={computedCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:secure_url" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mantra Meridian Riverside Balewadi Architecture" />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content="Mantra Meridian Riverside Balewadi" />
    <meta property="og:locality" content="Balewadi" />
    <meta property="og:region" content="Maharashtra" />
    <meta property="og:postal-code" content="411045" />
    <meta property="og:country-name" content="India" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content="Mantra Meridian Riverside Balewadi Architecture" />

    {/* Structured Data Schema */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(unifiedSchema)} />

    {/* DNS Prefetching & Preconnect for Core Web Vitals */}
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    {/* Preload High-Priority LCP Hero Image for Instant Rendering */}
    <link rel="preload" as="image" href="/assets/mantra-meridian-hero.webp" fetchpriority="high" type="image/webp" />

    {/* Google Analytics & Tag Manager Foundation Layer */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());

      // Forward architectural presentation inquiries into dataLayer
      window.addEventListener('open-private-presentation', function(e) {
        window.dataLayer.push({
          event: 'private_presentation_open',
          presentation_config: e.detail?.config || 'All',
          presentation_intent: e.detail?.intent || 'Discovery'
        });
      });
    </script>

    {/* Advanced Google Chrome & Cloudflare Flagship Speculation Rules API: Predictive Instant Prerender */}
    <script type="speculationrules" is:inline>
      {
        "prerender": [
          {
            "source": "document",
            "where": {
              "and": [
                { "href_matches": "/*" },
                { "not": { "href_matches": "/api/*" } },
                { "not": { "href_matches": "/*\\?*" } },
                { "not": { "selector_matches": "[data-no-prerender]" } }
              ]
            },
            "eagerness": "moderate"
          }
        ],
        "prefetch": [
          {
            "source": "document",
            "where": {
              "and": [
                { "href_matches": "/*" },
                { "not": { "href_matches": "/api/*" } }
              ]
            },
            "eagerness": "conservative"
          }
        ]
      }
    </script>

    {/* Progressive Web App Service Worker Registration (Zero impact on web bots) */}
    <script is:inline>
      if ('serviceWorker' in navigator && !/bot|crawl|spider|slurp/i.test(navigator.userAgent)) {
        window.addEventListener('load', function() {
          navigator.serviceWorker.register('/sw.js').catch(function() {});
        });
      }
