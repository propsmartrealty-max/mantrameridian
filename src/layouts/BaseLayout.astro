import FloatingWhatsApp from '../components/Navigation/FloatingWhatsApp.astro';
import PrivatePresentationDrawer from '../components/Enquiry/PrivatePresentationDrawer';
import { projectData } from '../data/project';
import { defaultMetaKeywords, meridianKeywordEcosystem } from '../data/keywords';
import { aggregateRatingData, verifiedReviews } from '../data/reviews';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  canonicalUrl?: string;
  schemaType?: string;
  customSchema?: object;
}

const {
  title = "Mantra Meridian Balewadi | Mantra Riverside Balewadi | Luxury 2, 3, 4 BHK & Duplexes Pune",
  description = "Official portal of Mantra Meridian Balewadi and Mantra Riverside Balewadi by Mantra Properties. 8-acre luxury riverside development offering 2, 3, 4 BHK homes & 3 BHK Duplexes along the Mula River. MahaRERA P52100045688.",
  keywords = defaultMetaKeywords,
  ogImage = projectData.ogImage,
  canonicalUrl,
  customSchema
} = Astro.props;

// Authoritative canonical URL normalization strictly matching trailing-slash routing
const siteOrigin = "https://mantrameridianriverside.com";
const rawPath = Astro.url.pathname.replace(/\/+$/, '');
const normalizedPath = rawPath === '' ? '/' : `${rawPath}/`;
const computedCanonical = canonicalUrl 
  ? (canonicalUrl.endsWith('/') ? canonicalUrl : `${canonicalUrl}/`)
  : `${siteOrigin}${normalizedPath}`;

// Prepare Google Search Central compliant Review objects with explicit itemReviewed
const structuredReviews = verifiedReviews.map((rev) => ({
  "@type": "Review",
  "itemReviewed": {
    "@type": "RealEstateAgent",
    "@id": "https://mantrameridianriverside.com/#organization",
    "name": "Mantra Meridian Riverside",
    "image": "https://mantrameridianriverside.com/assets/mantra-meridian-hero.webp",
    "telephone": projectData.contact.phone,
    "priceRange": "₹ 85 Lakhs - ₹ 3.50 Cr",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": projectData.contact.siteAddress,
      "addressLocality": "Balewadi",
      "addressRegion": "Maharashtra",
      "postalCode": "411045",
      "addressCountry": "IN"
    }
  },
  "author": {
    "@type": "Person",
    "name": rev.author
  },
  "datePublished": rev.date,
  "name": rev.title,
  "reviewBody": rev.body,
  "reviewRating": {
    "@type": "Rating",
    "bestRating": 5,
    "ratingValue": rev.rating,
    "worstRating": 1
  }
}));

// Global Organization, ApartmentComplex & RealEstateAgent Core Graph
