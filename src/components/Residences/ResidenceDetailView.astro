---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FloorPlanViewer from '../FloorPlan/FloorPlanViewer';
import ReraVerificationCard from '../Trust/ReraVerificationCard.astro';
import FAQAccordion from '../FAQ/FAQAccordion.astro';
import Breadcrumbs from '../Navigation/Breadcrumbs.astro';
import type { ResidenceConfig } from '../../data/residences';
import { residencesData } from '../../data/residences';
import { getConfigurationKeywords } from '../../data/keywords';
import { projectData } from '../../data/project';

interface Props {
  residence: ResidenceConfig;
}

const { residence } = Astro.props;

const otherResidences = residencesData.filter(r => r.id !== residence.id);

// SEO Schema for this Residence with Offer & Apartment specs
const numericPrice = residence.id === '2bhk' ? 8500000 : residence.id === '3bhk' ? 12800000 : residence.id === '3bhk-duplex' ? 18500000 : 24000000;

const residenceSchema = {
  "@context": "https://schema.org",
  "@type": ["SingleFamilyResidence", "Apartment"],
  "name": `${residence.name} - Mantra Meridian Riverside`,
  "description": residence.overview,
  "numberOfBedrooms": residence.type,
  "numberOfBathroomsTotal": residence.bathrooms,
  "floorSize": {
    "@type": "QuantitativeValue",
    "value": residence.carpetAreaRange
  },
  "offers": {
    "@type": "Offer",
    "priceCurrency": "INR",
    "price": numericPrice,
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": numericPrice,
      "priceCurrency": "INR",
      "name": "Starting Base Consideration"
    },
    "availability": "https://schema.org/InStock",
    "validFrom": "2026-01-01"
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Sr. No.: 45, 13, Balewadi Village Rd, nr. Mamta Dining Hall, Balewadi",
    "addressLocality": "Balewadi, Pune",
    "addressRegion": "Maharashtra",
    "postalCode": "411045",
    "addressCountry": "IN"
  }
};

const residenceKeywords = getConfigurationKeywords(residence.slug, residence.name);
---

<BaseLayout
  title={`${residence.type} Flats in Balewadi | ${residence.name} | Mantra Meridian Riverside Balewadi`}
  description={`${residence.name} at Mantra Meridian Riverside, Balewadi (${residence.carpetAreaRange}). ${residence.subtitle} MahaRERA P52100045688.`}
  keywords={residenceKeywords}
  ogImage={residence.renderImage}
  customSchema={residenceSchema}
>
  <div class="pt-32 pb-24 px-6 md:px-12 max-w-7xl mx-auto space-y-16">
    
    <Breadcrumbs items={[
      { name: "Residences", url: "/mantra-meridian-riverside/residences" },
      { name: residence.name }
    ]} />

    {/* Hero Presentation */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-end">
      <div class="lg:col-span-8 space-y-4">
        <div class="glass-pill inline-flex items-center gap-2 px-3.5 py-1.5 border border-champagne/35 text-champagne text-xs uppercase tracking-widest font-mono">
          <span>{residence.type} CONFIGURATION</span>
          <span class="text-white/20">•</span>
          <span>{residence.carpetAreaRange} CARPET</span>
        </div>
        <h1 class="font-display text-5xl sm:text-6xl md:text-7xl text-gradient-pearl leading-tight font-normal">
          {residence.name}
        </h1>
        <p class="text-xs sm:text-sm text-champagne font-mono">
          {residence.balconyType} • {residence.aspect}
        </p>
        <p class="text-xs sm:text-sm text-concrete leading-relaxed max-w-2xl pt-2">
          {residence.overview}
        </p>
      </div>

      <div class="lg:col-span-4 glass-card-luxury p-6 sm:p-8 space-y-5 border border-champagne/35 shadow-luxury-gold">
        <div class="flex items-center justify-between text-xs">
          <span class="text-concrete/70 uppercase font-mono">Starting Price</span>
          <span class="text-champagne font-mono font-semibold">Price On Request</span>
        </div>
        <div class="flex items-center justify-between text-xs">
          <span class="text-concrete/70 uppercase font-mono">MahaRERA Status</span>
          <span class="text-emerald-400 font-mono font-medium flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>P52100045688</span>
          </span>
        </div>
        <button
          class="residence-cta-btn btn-luxury w-full text-xs glass-sheen"
          data-config={residence.name}
        >
          REQUEST PRICING &amp; AVAILABILITY →
        </button>
        <a
          href={`https://wa.me/${projectData.contact.whatsapp.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(`Hello Meridian Concierge, I would like to receive pricing, floor plans, and availability for ${residence.name} (${residence.type}) at Mantra Meridian Riverside Balewadi.`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-luxury-outline w-full text-xs glass-sheen text-center flex items-center justify-center gap-2 border-emerald-500/40 text-emerald-400 hover:bg-emerald-500/10 min-h-[44px]"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
          <span>WHATSAPP CONCIERGE</span>
          <span>↗</span>
        </a>
      </div>
    </div>

    {/* Authentic Residence Render Banner */}
    <div class="relative w-full aspect-[16/9] sm:aspect-[21/9] min-h-[280px] sm:min-h-[400px] overflow-hidden border border-white/10 group shadow-luxury">
      <img
        src={residence.renderImage}
        alt={`${residence.name} Architectural Render`}
        class="w-full h-full object-cover filter brightness-95 group-hover:scale-105 transition-transform duration-700"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-obsidian/30 to-transparent opacity-80" />
      
      <div class="absolute bottom-6 left-6 sm:bottom-8 sm:left-8 flex flex-wrap items-center gap-3">
        <div class="glass-dark px-4 py-2 border border-champagne/30">
          <span class="label-architectural text-[10px] text-champagne">
            ARCHITECTURAL RENDER • {residence.type.toUpperCase()}
          </span>
        </div>
        {residence.virtualTourUrl && (
          <a
            href={residence.virtualTourUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-luxury text-xs inline-flex items-center gap-2"
          >
            <span>LAUNCH 3D / VIDEO TOUR</span>
            <span>↗</span>
          </a>
        )}
      </div>
    </div>

    {/* Architectural Floor Plan Viewer */}
    <div class="space-y-6">
      <div class="border-b border-white/10 pb-4 flex items-center justify-between">
        <div>
          <span class="label-architectural text-xs text-champagne">VERIFIED BLUEPRINT</span>
          <h2 class="font-serif text-3xl text-architectural-white mt-1">Interactive Floor Plan</h2>
        </div>
        <button
          class="residence-download-btn btn-luxury-outline text-xs hidden sm:inline-flex"
          data-config={residence.name}
        >
          DOWNLOAD BLUEPRINT PDF ↓
        </button>
      </div>

      <FloorPlanViewer client:load defaultResidenceId={residence.id} />
    </div>

    {/* Room by Room Dimensions Table */}
    <div class="space-y-6">
      <div>
        <span class="label-architectural text-xs text-champagne">CHAMBER SCHEDULE</span>
        <h2 class="font-serif text-3xl text-architectural-white mt-1">Measured Room Dimensions</h2>
      </div>

      <div class="overflow-x-auto border border-white/10 bg-obsidian-card">
        <table class="w-full text-left text-xs">
          <thead class="bg-obsidian-surface border-b border-white/10 text-concrete/70 uppercase font-mono text-[10px]">
            <tr>
              <th class="p-4">Chamber</th>
              <th class="p-4">Dimensions</th>
              <th class="p-4">Area (Sq.Ft.)</th>
              <th class="p-4">Spatial Character</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 text-concrete">
            {residence.rooms.map((room) => (
              <tr class="hover:bg-white/5 transition-colors">
                <td class="p-4 font-medium text-architectural-white">{room.name}</td>
                <td class="p-4 font-mono text-champagne">{room.dimensions}</td>
                <td class="p-4 font-mono">{room.areaSqFt} sq.ft.</td>
                <td class="p-4 text-concrete/80">{room.description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    {/* Technical Specifications Schedule */}
    <div class="space-y-6">
      <div>
        <span class="label-architectural text-xs text-champagne">MATERIALS &amp; FIXTURES</span>
        <h2 class="font-serif text-3xl text-architectural-white mt-1">Technical Specifications</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-6 glass-card-luxury space-y-2">
          <span class="text-[10px] uppercase font-mono text-champagne tracking-wider">Flooring &amp; Deck Finishes</span>
          <p class="text-xs text-concrete leading-relaxed">{residence.specifications.flooring}</p>
        </div>
        <div class="p-6 glass-card-luxury space-y-2">
          <span class="text-[10px] uppercase font-mono text-champagne tracking-wider">Doors &amp; Fenestration</span>
          <p class="text-xs text-concrete leading-relaxed">{residence.specifications.doorsWindows}</p>
        </div>
        <div class="p-6 glass-card-luxury space-y-2">
          <span class="text-[10px] uppercase font-mono text-champagne tracking-wider">Kitchen &amp; Utility</span>
          <p class="text-xs text-concrete leading-relaxed">{residence.specifications.kitchen}</p>
        </div>
        <div class="p-6 glass-card-luxury space-y-2">
          <span class="text-[10px] uppercase font-mono text-champagne tracking-wider">Bathrooms &amp; Sanitaries</span>
          <p class="text-xs text-concrete leading-relaxed">{residence.specifications.bathrooms}</p>
        </div>
        <div class="p-6 glass-card-luxury space-y-2">
          <span class="text-[10px] uppercase font-mono text-champagne tracking-wider">Electrical &amp; EV Provision</span>
          <p class="text-xs text-concrete leading-relaxed">{residence.specifications.electrical}</p>
        </div>
        <div class="p-6 glass-card-luxury space-y-2">
          <span class="text-[10px] uppercase font-mono text-champagne tracking-wider">Home Automation &amp; Biometrics</span>
          <p class="text-xs text-concrete leading-relaxed">{residence.specifications.homeAutomation}</p>
        </div>
      </div>
    </div>

    {/* RERA Card */}
    <ReraVerificationCard />

    {/* Contextual FAQs */}
    <div class="space-y-6">
      <div>
        <span class="label-architectural text-xs text-champagne">RESIDENCE QUESTIONS</span>
        <h2 class="font-serif text-3xl text-architectural-white mt-1">Frequently Asked Questions</h2>
      </div>
      <FAQAccordion category="configurations" />
    </div>

    {/* Other Configurations Navigation */}
    <div class="space-y-6 pt-12 border-t border-white/10">
      <div class="flex justify-between items-end">
        <div>
          <span class="label-architectural text-xs text-champagne">PORTFOLIO EXPLORATION</span>
          <h2 class="font-serif text-3xl text-architectural-white mt-1">Other Available Residences</h2>
        </div>
        <a href="/mantra-meridian-riverside/residences" class="text-xs text-champagne hover:underline uppercase tracking-wider font-mono">
          All Configurations →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {otherResidences.map((other) => (
          <a
            href={`/mantra-meridian-riverside/${other.slug}`}
            class="group p-6 bg-obsidian-card border border-white/10 hover:border-champagne/40 transition-all flex flex-col justify-between"
          >
            <div>
              <span class="label-architectural text-[9px] text-champagne">{other.type}</span>
              <h3 class="font-serif text-xl text-architectural-white group-hover:text-champagne-light transition-colors mt-1">
                {other.name}
              </h3>
              <p class="text-xs text-concrete/70 mt-2 line-clamp-2">{other.subtitle}</p>
            </div>
            <div class="pt-4 border-t border-white/5 mt-4 flex justify-between items-center text-xs">
              <span class="font-mono text-concrete/60">{other.carpetAreaRange}</span>
              <span class="text-champagne font-medium">Explore →</span>
            </div>
          </a>
        ))}
      </div>
    </div>

  </div>
</BaseLayout>

<script>
  const handlePresentation = (e: Event) => {
    const target = e.currentTarget as HTMLElement;
    const config = target.getAttribute('data-config') || 'Residence';
    window.dispatchEvent(
      new CustomEvent('open-private-presentation', {
        detail: { config, intent: 'RESIDENCE PAGE ENQUIRY' }
      })
    );
  };

  document.querySelectorAll('.residence-cta-btn').forEach(btn => btn.addEventListener('click', handlePresentation));
  document.querySelectorAll('.residence-download-btn').forEach(btn => btn.addEventListener('click', handlePresentation));
</script>
