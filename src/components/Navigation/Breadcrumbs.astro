---
export interface BreadcrumbItem {
  name: string;
  url?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const allItems: BreadcrumbItem[] = [
  { name: "Home", url: "/" },
  ...items
];

const siteOrigin = "https://mantrameridianriverside.com";
const rawPath = Astro.url.pathname.replace(/\/+$/, '');
const normalizedPath = rawPath === '' ? '/' : `${rawPath}/`;
const currentCanonical = `${siteOrigin}${normalizedPath}`;

// Schema.org BreadcrumbList for Google SERP Rich Results (Google Search Central compliant)
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": allItems.map((item, index) => {
    let itemUrl = currentCanonical;
    if (item.url) {
      const cleanItemPath = item.url.replace(/\/+$/, '');
      const normItemPath = cleanItemPath === '' ? '/' : `${cleanItemPath}/`;
      itemUrl = `${siteOrigin}${normItemPath}`;
    }
    return {
      "@type": "ListItem",
      "position": index + 1,
      "name": item.name,
      "item": itemUrl
    };
  })
};
---

<nav aria-label="Breadcrumb Navigation" class="w-full text-xs text-concrete/70 font-mono py-2">
  <ol class="flex flex-wrap items-center gap-2">
    {allItems.map((item, idx) => {
      const isLast = idx === allItems.length - 1;
      const formattedUrl = item.url ? (item.url.endsWith('/') ? item.url : `${item.url.replace(/\/+$/, '')}/`) : undefined;
      return (
        <li class="flex items-center gap-2">
          {formattedUrl && !isLast ? (
            <a 
              href={formattedUrl} 
              class="hover:text-champagne transition-colors"
            >
              {item.name}
            </a>
          ) : (
            <span class="text-champagne font-medium" aria-current="page">
              {item.name}
            </span>
          )}
          {!isLast && <span class="text-concrete/40">/</span>}
        </li>
      );
    })}
  </ol>
</nav>

<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
