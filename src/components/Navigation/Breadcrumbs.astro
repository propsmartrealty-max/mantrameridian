---
export interface BreadcrumbItem {
  name: string;
  url?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const allItems: BreadcrumbItem[] = [
  { name: "Home", url: "/" },
  ...items
];

// Schema.org BreadcrumbList for Google SERP Rich Results
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": allItems.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    ...(item.url ? { "item": `https://mantrameridianriverside.com${item.url.startsWith('/') ? item.url : `/${item.url}`}` } : {})
  }))
};
---

<nav aria-label="Breadcrumb" class="w-full text-xs text-concrete/70 font-mono py-2">
  <ol class="flex flex-wrap items-center gap-2">
    {allItems.map((item, idx) => {
      const isLast = idx === allItems.length - 1;
      return (
        <li class="flex items-center gap-2">
          {item.url && !isLast ? (
            <a 
              href={item.url} 
              class="hover:text-champagne transition-colors"
            >
              {item.name}
            </a>
          ) : (
            <span class="text-champagne" aria-current="page">
              {item.name}
            </span>
          )}
          {!isLast && <span class="text-concrete/40">/</span>}
        </li>
      );
    })}
  </ol>
</nav>

<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
