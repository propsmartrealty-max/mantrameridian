---
import { projectData } from '../../data/project';
import { getWhatsAppUrl } from '../../utils/whatsapp';

interface Props {
  customText?: string;
}

const { customText } = Astro.props;
const cleanPhone = projectData.contact.whatsapp.replace(/[^0-9]/g, '');
const whatsappHref = customText 
  ? `https://wa.me/${cleanPhone}?text=${encodeURIComponent(customText)}`
  : getWhatsAppUrl(Astro.url.pathname);
---

{/* Desktop Floating WhatsApp Concierge Widget */}
<div class="hidden lg:flex fixed bottom-8 right-8 z-40 items-center group">
  <a
    href={whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat with Mantra Meridian Riverside Concierge on WhatsApp"
    class="relative flex items-center gap-3 apple-glass-pill glass-caustic-sheen fluid-spring fluid-press border border-emerald-600/35 hover:border-emerald-500 p-2.5 pr-5 rounded-full shadow-[0_15px_40px_rgba(40,30,20,0.12),0_0_25px_rgba(16,185,129,0.18)] hover:shadow-[0_20px_50px_rgba(40,30,20,0.16),0_0_35px_rgba(16,185,129,0.28)]"
  >
    {/* WhatsApp Green Icon Circle with Ambient Ripple */}
    <div class="relative w-10 h-10 rounded-full bg-emerald-600 text-white flex items-center justify-center shrink-0 shadow-md">
      <div class="absolute -inset-1 rounded-full bg-emerald-500/25 animate-pulse pointer-events-none"></div>
      <svg class="w-5 h-5 fill-current relative z-10" viewBox="0 0 24 24">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
      </svg>
    </div>

    {/* Text Label */}
    <div class="text-left">
      <div class="text-[10px] uppercase font-mono tracking-widest text-emerald-800 font-semibold">
        WhatsApp Concierge
      </div>
      <div class="text-xs font-mono text-[#161412] font-semibold flex items-center gap-1.5">
        <span>Connect Instantly</span>
        <span class="text-emerald-700 group-hover:translate-x-0.5 transition-transform">↗</span>
      </div>
    </div>
  </a>
</div>
