---
import { projectData } from '../../data/project';

interface Props {
  customText?: string;
}

const { customText } = Astro.props;
const enquiryText = customText || projectData.contact.whatsappEnquiryText;
const whatsappHref = `https://wa.me/${projectData.contact.whatsapp.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(enquiryText)}`;
---

{/* Desktop Floating WhatsApp Concierge Widget */}
<div class="hidden lg:flex fixed bottom-8 right-8 z-40 items-center group">
  <a
    href={whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat with Mantra Meridian Riverside Concierge on WhatsApp"
    class="flex items-center gap-3 bg-obsidian-deep/95 border border-emerald-500/40 hover:border-emerald-400 p-2.5 pr-5 rounded-full backdrop-blur-xl shadow-[0_10px_30px_rgba(0,0,0,0.8),0_0_20px_rgba(16,185,129,0.2)] hover:shadow-[0_10px_35px_rgba(0,0,0,0.9),0_0_25px_rgba(16,185,129,0.35)] transition-all duration-300 transform hover:-translate-y-0.5"
  >
    {/* WhatsApp Green Icon Circle */}
    <div class="w-10 h-10 rounded-full bg-emerald-500 text-obsidian flex items-center justify-center shrink-0 shadow-md">
      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
      </svg>
    </div>

    {/* Text Label */}
    <div class="text-left">
      <div class="text-[10px] uppercase font-mono tracking-widest text-emerald-400/90 font-medium">
        WhatsApp Concierge
      </div>
      <div class="text-xs font-mono text-architectural-white font-semibold flex items-center gap-1.5">
        <span>+91 77440 09295</span>
        <span class="text-emerald-400 group-hover:translate-x-0.5 transition-transform">↗</span>
      </div>
    </div>
  </a>
</div>
