---
interface Props {
  variant?: 'navbar' | 'hero' | 'footer';
  showSubtitle?: boolean;
}

const { variant = 'navbar', showSubtitle = true } = Astro.props;
---

<div class={`flex items-center gap-3 sm:gap-4 select-none transition-all duration-300 group ${
  variant === 'hero' ? 'justify-center py-1' : ''
}`}>
  
  {/* Developer Brand: Mantra Properties Logo */}
  <a
    href="https://www.mantraproperties.in"
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center shrink-0 text-architectural-white hover:text-champagne transition-opacity duration-300 hover:opacity-90"
    title="Mantra Properties — 17+ Years of Continuous Innovation"
  >
    <div class={`relative flex items-center justify-center ${
      variant === 'hero' ? 'h-8 sm:h-9 w-auto' : 'h-6 sm:h-7 w-auto'
    }`}>
      <img
        src="/assets/mantra-logo.svg"
        alt="Mantra Properties"
        class="h-full w-auto object-contain brightness-100"
      />
    </div>
  </a>

  {/* Slender Architectural Hairline Divider */}
  <div class="h-5 sm:h-6 w-[1px] bg-champagne/35 shrink-0" aria-hidden="true" />

  {/* Project Signature Brand: Meridian Riverside */}
  <a
    href="/"
    class="flex flex-col justify-center text-left text-architectural-white group-hover:text-champagne-light transition-colors duration-300"
    title="Mantra Meridian Riverside, Balewadi"
  >
    <div class="flex items-center gap-1.5 leading-none">
      <span class="font-serif text-sm sm:text-base tracking-[0.24em] font-medium text-architectural-white group-hover:text-champagne transition-colors">
        MERIDIAN
      </span>
      <span class="hidden sm:inline-block text-[10px] tracking-[0.2em] font-serif italic text-champagne/80 font-light">
        Riverside
      </span>
    </div>
    {showSubtitle && (
      <span class="text-[7.5px] sm:text-[8px] uppercase tracking-[0.28em] text-champagne/70 font-mono mt-1 leading-none">
        BALEWADI • PUNE
      </span>
    )}
  </a>

</div>
