---
interface Props {
  variant?: 'navbar' | 'hero' | 'footer';
  showSubtitle?: boolean;
}

const { variant = 'navbar', showSubtitle = true } = Astro.props;
---

<div class={`flex items-center gap-3 sm:gap-4 select-none transition-all duration-300 group ${
  variant === 'hero' ? 'justify-center py-1' : ''
}`}>
  
  {/* Developer Brand: Mantra Properties Logo */}
  <a
    href="https://www.mantraproperties.in"
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center shrink-0 text-architectural-white hover:text-champagne transition-opacity duration-300 hover:opacity-90"
    title="Mantra Properties — 17+ Years of Continuous Innovation"
  >
    <div class={`relative flex items-center justify-center ${
      variant === 'hero' ? 'h-9 sm:h-10 md:h-11 w-auto' : 'h-8 sm:h-9 w-auto'
    }`}>
      <img
        src="/assets/mantra-logo.svg"
        alt="Mantra Properties"
        class="h-full w-auto object-contain brightness-0 invert drop-shadow-[0_0_8px_rgba(255,255,255,0.5)]"
      />
    </div>
  </a>

  {/* Slender Architectural Hairline Divider with High Gold Contrast */}
  <div class="h-6 sm:h-7 w-[1.5px] bg-champagne/60 shrink-0" aria-hidden="true" />

  {/* Project Signature Brand: Meridian Riverside */}
  <a
    href="/"
    class="flex flex-col justify-center text-left text-white group-hover:text-champagne-light transition-colors duration-300"
    title="Mantra Meridian Riverside, Balewadi"
  >
    <div class="flex items-center gap-2 leading-none">
      <span class="font-serif text-base sm:text-xl tracking-[0.2em] font-bold text-white group-hover:text-champagne transition-colors">
        MERIDIAN
      </span>
      <span class="inline-block text-xs sm:text-sm tracking-[0.18em] font-serif italic text-champagne-light font-medium">
        Riverside
      </span>
    </div>
    {showSubtitle && (
      <span class="text-[10px] sm:text-[11px] uppercase tracking-[0.24em] text-champagne font-mono font-semibold mt-1 leading-none">
        BALEWADI • PUNE
      </span>
    )}
  </a>

</div>
