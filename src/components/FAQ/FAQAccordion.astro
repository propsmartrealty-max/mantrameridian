---
import { faqsData, type FAQItem } from '../../data/faqs';

interface Props {
  category?: string;
  limit?: number;
  customFaqs?: { question: string; answer: string; category?: string }[];
}

const { category, limit, customFaqs } = Astro.props;

let displayFaqs: (FAQItem | { question: string; answer: string; category?: string })[] = customFaqs
  ? customFaqs
  : (category ? faqsData.filter((f) => f.category === category) : faqsData);

if (limit) {
  displayFaqs = displayFaqs.slice(0, limit);
}

// JSON-LD Schema for FAQPage
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": displayFaqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section class="w-full space-y-6">
  {/* Inject JSON-LD Schema */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

  <div class="space-y-4">
    {displayFaqs.map((faq, idx) => (
      <details 
        class={`group glass-card-luxury glass-spotlight reveal-glass ${idx % 2 === 0 ? 'reveal-delay-1' : 'reveal-delay-2'} border border-champagne/25 hover:border-champagne/60 transition-all duration-300 rounded overflow-hidden`}
        itemscope 
        itemprop="mainEntity" 
        itemtype="https://schema.org/Question"
        data-ai-question={faq.question}
      >
        <summary class="flex items-center justify-between p-5 md:p-6 cursor-pointer list-none select-none text-architectural-white group-hover:text-champagne transition-colors">
          <span class="font-serif text-lg md:text-xl pr-4" itemprop="name">
            {faq.question}
          </span>
          <span class="w-8 h-8 rounded-full border border-champagne/30 flex items-center justify-center text-champagne group-open:rotate-45 group-open:border-champagne group-open:bg-champagne/10 transition-all duration-300 text-xl font-light shrink-0" aria-hidden="true">
            +
          </span>
        </summary>
        <div 
          class="px-5 pb-6 md:px-6 md:pb-6 text-xs sm:text-sm text-concrete leading-relaxed border-t border-champagne/15 pt-4 bg-obsidian-deep/40"
          itemscope 
          itemprop="acceptedAnswer" 
          itemtype="https://schema.org/Answer"
          data-ai-answer="true"
        >
          <p itemprop="text">{faq.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>
