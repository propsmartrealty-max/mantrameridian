---
import { projectData } from '../../data/project';
---

<aside class="fixed bottom-0 left-0 right-0 z-40 lg:hidden bg-obsidian-deep/95 backdrop-blur-xl border-t border-champagne/20 px-3 py-2.5 shadow-luxury">
  <div class="grid grid-cols-3 gap-2">
    
    {/* Call Direct */}
    <a
      href={`tel:${projectData.contact.phone.replace(/[^0-9+]/g, '')}`}
      class="flex flex-col items-center justify-center py-2 px-1 text-center bg-obsidian-card border border-white/10 text-architectural-white hover:border-champagne transition-all"
    >
      <svg class="w-4 h-4 text-champagne mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      <span class="text-[10px] font-medium tracking-widest uppercase">CALL</span>
    </a>

    {/* WhatsApp Concierge */}
    <a
      href={`https://wa.me/${projectData.contact.whatsapp.replace(/[^0-9]/g, '')}?text=Hello%20Meridian%20Concierge,%20I%20would%20like%20to%20receive%20details%20for%20Mantra%20Meridian%20Riverside%20Balewadi.`}
      target="_blank"
      rel="noopener noreferrer"
      class="flex flex-col items-center justify-center py-2 px-1 text-center bg-obsidian-card border border-white/10 text-architectural-white hover:border-champagne transition-all"
    >
      <svg class="w-4 h-4 text-emerald-400 mb-1" viewBox="0 0 24 24" fill="currentColor">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
      </svg>
      <span class="text-[10px] font-medium tracking-widest uppercase">WHATSAPP</span>
    </a>

    {/* Enquire Modal Trigger */}
    <button
      id="mobile-persistent-enquire"
      class="flex flex-col items-center justify-center py-2 px-1 text-center bg-champagne text-obsidian font-semibold hover:bg-champagne-light transition-all shadow-glow"
    >
      <svg class="w-4 h-4 text-obsidian mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
      </svg>
      <span class="text-[10px] tracking-widest uppercase">ENQUIRE</span>
    </button>

  </div>
</aside>

<script>
  const mobileBarBtn = document.getElementById('mobile-persistent-enquire');
  mobileBarBtn?.addEventListener('click', () => {
    window.dispatchEvent(
      new CustomEvent('open-private-presentation', {
        detail: { config: 'Mobile User', intent: 'MOBILE QUICK ENQUIRY' }
      })
    );
  });
</script>
