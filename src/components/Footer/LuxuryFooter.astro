---
import { projectData } from '../../data/project';
import DualBrandLockup from '../Brand/DualBrandLockup.astro';
---

<footer class="bg-obsidian-deep border-t border-white/10 pt-20 pb-32 lg:pb-20 text-concrete">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    
    {/* Upper Brand Section */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 pb-16 border-b border-white/10">
      
      {/* Brand Column (Cols 1-5) */}
      <div class="lg:col-span-5 space-y-6">
        <div>
          <DualBrandLockup variant="footer" showSubtitle={true} />
        </div>

        <p class="text-xs text-concrete/80 leading-relaxed max-w-md">
          A rare 8-acre contemporary residential sanctuary conceived along the tranquil banks of the Mula river. Curated for those who seek space, light, and architectural stillness in West Pune.
        </p>

        <div class="pt-2">
          <button
            id="footer-presentation-trigger"
            class="px-5 py-2.5 text-xs tracking-[0.14em] uppercase font-medium bg-architectural-white text-obsidian hover:bg-champagne transition-all duration-300 inline-flex items-center gap-2 shadow-sm"
          >
            <span>REQUEST A PRIVATE PRESENTATION</span>
            <span>→</span>
          </button>
        </div>
      </div>

      {/* Nav Cluster 1: Residences & Spaces (Cols 5-6) */}
      <div class="lg:col-span-2 space-y-4">
        <p class="text-xs uppercase tracking-[0.2em] text-architectural-white font-semibold">Residences</p>
        <ul class="space-y-2.5 text-xs text-concrete/70">
          <li><a href="/mantra-meridian-riverside/2-bhk/" class="hover:text-champagne transition-colors">2 BHK Contemporary</a></li>
          <li><a href="/mantra-meridian-riverside/3-bhk/" class="hover:text-champagne transition-colors">3 BHK Riverside</a></li>
          <li><a href="/duplex/" class="hover:text-champagne transition-colors">3 BHK Sky Duplexes</a></li>
          <li><a href="/mantra-meridian-riverside/4-bhk/" class="hover:text-champagne transition-colors">4 BHK Grand Estates</a></li>
          <li><a href="/mantra-meridian-riverside/price/" class="hover:text-champagne transition-colors">Price &amp; Cost Sheet</a></li>
          <li><a href="/mantra-meridian-riverside/floor-plans/" class="hover:text-champagne transition-colors">Floor Plan Portfolio</a></li>
          <li><a href="/mantra-meridian-riverside/masterplan/" class="hover:text-champagne transition-colors">8-Acre Masterplan</a></li>
        </ul>
      </div>

      {/* Nav Cluster 2: Corridors & Advisory (Cols 7-9) */}
      <div class="lg:col-span-3 space-y-4">
        <p class="text-xs uppercase tracking-[0.2em] text-architectural-white font-semibold">Corridors &amp; Advisory</p>
        <ul class="space-y-2.5 text-xs text-concrete/70">
          <li><a href="/balewadi/" class="hover:text-champagne transition-colors">Balewadi Real Estate Hub</a></li>
          <li><a href="/hinjewadi/" class="hover:text-champagne transition-colors">Hinjewadi Tech Corridor</a></li>
          <li><a href="/baner/" class="hover:text-champagne transition-colors">Baner Luxury Corridor</a></li>
          <li><a href="/mahalunge/" class="hover:text-champagne transition-colors">Mahalunge Hi-Tech Hub</a></li>
          <li><a href="/nri-desk/" class="hover:text-champagne transition-colors">Global NRI Investment Desk</a></li>
          <li><a href="/compare/" class="hover:text-champagne transition-colors">Project Comparison Hub</a></li>
          <li><a href="/home-loan/" class="hover:text-champagne transition-colors">Home Loan &amp; Bank APF</a></li>
          <li><a href="/construction-status/" class="hover:text-champagne transition-colors">Construction Status &amp; RERA</a></li>
        </ul>
      </div>

      {/* Nav Cluster 3: Discovery & Compliance (Cols 10-12) */}
      <div class="lg:col-span-3 space-y-4">
        <p class="text-xs uppercase tracking-[0.2em] text-architectural-white font-semibold">Discovery &amp; Legal</p>
        <ul class="space-y-2.5 text-xs text-concrete/70">
          <li><a href="/mantra-meridian-riverside/riverside/" class="hover:text-champagne transition-colors">The Riverside Story</a></li>
          <li><a href="/mantra-meridian-riverside/amenities/" class="hover:text-champagne transition-colors">Amenity Atlas (30+ Spaces)</a></li>
          <li><a href="/mantra-meridian-riverside/location/" class="hover:text-champagne transition-colors">Location Intelligence</a></li>
          <li><a href="/pune-real-estate/" class="hover:text-champagne transition-colors">Pune Real Estate Index</a></li>
          <li><a href="/mantra-meridian-riverside/rera/" class="hover:text-champagne transition-colors">MahaRERA: {projectData.reraNumber}</a></li>
          <li><a href="/mantra-meridian-riverside/documents/" class="hover:text-champagne transition-colors">Document Library</a></li>
          <li><a href={`tel:${projectData.contact.phone.replace(/\s+/g, '')}`} class="hover:text-champagne transition-colors">VIP Concierge Telephone Desk</a></li>
          <li>
            <a
              href={`https://wa.me/${projectData.contact.whatsapp.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(projectData.contact.whatsappEnquiryText)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-emerald-400 text-emerald-400/90 transition-colors flex items-center gap-1.5"
            >
              <span>WhatsApp Concierge</span>
              <span>↗</span>
            </a>
          </li>
        </ul>
      </div>

    </div>

    {/* Verified RERA & Legal Compliance Strip with Official QR Code */}
    <div class="py-10 border-b border-white/10 space-y-6 text-xs text-concrete/60 leading-relaxed">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6 p-6 bg-obsidian-surface/60 border border-champagne/20">
        
        <div class="flex items-center gap-5">
          {/* Official MahaRERA QR Code */}
          <div class="w-20 h-20 bg-white p-1.5 shrink-0 border border-champagne/40 flex items-center justify-center">
            <img
              src="/assets/mantra-meridian-rera-qr.webp"
              alt={`MahaRERA QR ${projectData.reraNumber}`}
              class="w-full h-full object-contain"
            />
          </div>

          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <div class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse" />
              <span class="text-architectural-white font-semibold tracking-wider font-mono uppercase text-sm">
                MAHARERA: {projectData.reraNumber}
              </span>
            </div>
            <p class="text-xs text-concrete/80">Scan QR or verify project details on the Maharashtra Real Estate Regulatory Authority portal.</p>
          </div>
        </div>

        <a 
          href={projectData.reraRegistrationUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-luxury-outline text-xs whitespace-nowrap"
        >
          <span>VERIFY AT MAHARERA PORTAL</span>
          <span>↗</span>
        </a>
      </div>

      {/* Corporate Offices Address Grid */}
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
        {projectData.offices.map((office) => (
          <div class="p-4 bg-obsidian-card/40 border border-white/5 space-y-1">
            <span class="text-[10px] font-mono text-champagne uppercase block">{office.city}</span>
            <div class="text-xs text-architectural-white font-medium">{office.name}</div>
            <p class="text-[11px] text-concrete/70 leading-snug">{office.address}</p>
          </div>
        ))}
      </div>

      {/* Comprehensive Google Search & Keyword Permutation Directory */}
      <nav aria-label="Search & Keyword Directory" class="pt-6 border-t border-white/10 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <p class="text-xs uppercase font-mono tracking-wider text-champagne/90 font-semibold">
            Mantra Meridian Riverside Balewadi • Pune Real Estate Ecosystem Directory
          </p>
          <span class="text-[10px] font-mono text-concrete/50">MahaRERA: {projectData.reraNumber} • June 2028 Possession</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6 text-[11px] text-concrete/65 font-sans leading-relaxed">
          
          {/* Column 1: Core Brand & Voice Searches */}
          <div class="space-y-2">
            <p class="text-[10.5px] uppercase font-mono text-architectural-white font-medium tracking-wide">Brand &amp; Voice Queries</p>
            <ul class="space-y-1.5 text-concrete/70">
              <li><a href="/mantra-meridian/" class="hover:text-champagne transition-colors font-medium text-architectural-white/90">Mantra Meridian</a></li>
              <li><a href="/mantra-balewadi/" class="hover:text-champagne transition-colors font-medium text-architectural-white/90">Mantra Balewadi</a></li>
              <li><a href="/mantra-riverside/" class="hover:text-champagne transition-colors font-medium text-architectural-white/90">Mantra Riverside</a></li>
              <li><a href="/mantra-riverside-balewadi/" class="hover:text-champagne transition-colors font-medium text-architectural-white/90">Mantra Riverside Balewadi</a></li>
              <li><a href="/mantra-meridian-balewadi/" class="hover:text-champagne transition-colors font-medium text-architectural-white/90">Mantra Meridian Balewadi</a></li>
              <li><a href="/" class="hover:text-champagne transition-colors font-medium text-architectural-white/90">Mantra Meridian Riverside Balewadi</a></li>
              <li><a href="/mantra-riverside-balewadi/" class="hover:text-champagne transition-colors text-concrete/60" title="Mantra Riverride Balewadi Phonetic Search Alias">Mantra Riverride Balewadi</a></li>
              <li><a href="/" class="hover:text-champagne transition-colors">Mantra Properties Balewadi Pune</a></li>
              <li><a href="/" class="hover:text-champagne transition-colors">Mantra Meridian Official Portal</a></li>
            </ul>
          </div>

          {/* Column 2: Typologies & Sky Duplexes */}
          <div class="space-y-2">
            <p class="text-[10.5px] uppercase font-mono text-architectural-white font-medium tracking-wide">Typologies &amp; Duplexes</p>
            <ul class="space-y-1.5 text-concrete/70">
              <li><a href="/mantra-meridian-riverside/2-bhk/" class="hover:text-champagne transition-colors">2 BHK Flats in Balewadi Mantra Meridian</a></li>
              <li><a href="/mantra-meridian-riverside/3-bhk/" class="hover:text-champagne transition-colors">3 BHK Flats in Balewadi Mantra Meridian</a></li>
              <li><a href="/mantra-meridian-riverside/3-bhk-duplex/" class="hover:text-champagne transition-colors">3 BHK Duplex in Balewadi Mantra Meridian</a></li>
              <li><a href="/mantra-meridian-riverside/4-bhk/" class="hover:text-champagne transition-colors">4 BHK Luxury Apartments Balewadi</a></li>
              <li><a href="/mantra-meridian-riverside/3-bhk-duplex/" class="hover:text-champagne transition-colors">Sky Duplex Apartments Pune</a></li>
              <li><a href="/mantra-meridian-riverside/journal/sky-duplex-vs-penthouse-luxury-living-pune/" class="hover:text-champagne transition-colors">Sky Duplex vs Penthouse Guide</a></li>
              <li><a href="/mantra-meridian-riverside/riverside/" class="hover:text-champagne transition-colors">River Facing Apartments Pune</a></li>
              <li><a href="/mantra-meridian-riverside/residences/" class="hover:text-champagne transition-colors">Double Height Ceiling Residences</a></li>
            </ul>
          </div>

          {/* Column 3: Micro-Markets & IT Corridors */}
          <div class="space-y-2">
            <p class="text-[10.5px] uppercase font-mono text-architectural-white font-medium tracking-wide">Micro-Markets &amp; IT Hubs</p>
            <ul class="space-y-1.5 text-concrete/70">
              <li><a href="/balewadi/" class="hover:text-champagne transition-colors">Balewadi Real Estate Hub 2026</a></li>
              <li><a href="/west-pune/" class="hover:text-champagne transition-colors">West Pune Luxury Corridor</a></li>
              <li><a href="/mantra-meridian-riverside/journal/hinjewadi-it-corridor-balewadi-luxury-housing-guide/" class="hover:text-champagne transition-colors">Flats Near Hinjewadi IT Park Phase 1</a></li>
              <li><a href="/mantra-meridian-riverside/journal/hinjewadi-balewadi-connectivity-corridor/" class="hover:text-champagne transition-colors">Hinjewadi–Balewadi Transit Axis</a></li>
              <li><a href="/mantra-meridian-riverside/journal/baner-vs-balewadi-vs-mahalunge-real-estate-investment-2026/" class="hover:text-champagne transition-colors">Baner vs Balewadi vs Mahalunge</a></li>
              <li><a href="/mantra-meridian-riverside/location/" class="hover:text-champagne transition-colors">Flats Near Balewadi High Street</a></li>
              <li><a href="/mantra-meridian-riverside/location/" class="hover:text-champagne transition-colors">Balewadi-Wakad River Bridge Link</a></li>
              <li><a href="/pune-real-estate/" class="hover:text-champagne transition-colors">Pune Real Estate Market Outlook</a></li>
            </ul>
          </div>

          {/* Column 4: Commercial, Blueprints & Approvals */}
          <div class="space-y-2">
            <p class="text-[10.5px] uppercase font-mono text-architectural-white font-medium tracking-wide">Pricing, Plans &amp; RERA</p>
            <ul class="space-y-1.5 text-concrete/70">
              <li><a href="/mantra-meridian-riverside/price/" class="hover:text-champagne transition-colors">Mantra Meridian Price List 2026</a></li>
              <li><a href="/mantra-meridian-riverside/price/" class="hover:text-champagne transition-colors">Cost Sheet &amp; Payment Schedules</a></li>
              <li><a href="/mantra-meridian-riverside/floor-plans/" class="hover:text-champagne transition-colors">Floor Plans PDF &amp; Carpet Areas</a></li>
              <li><a href="/mantra-meridian-riverside/masterplan/" class="hover:text-champagne transition-colors">8-Acre Riverfront Masterplan</a></li>
              <li><a href="/mantra-meridian-riverside/amenities/" class="hover:text-champagne transition-colors">30+ Resort Amenities &amp; Clubhouse</a></li>
              <li><a href="/mantra-meridian-riverside/rera/" class="hover:text-champagne transition-colors">MahaRERA P52100045688 Certificate</a></li>
              <li><a href="/mantra-meridian-riverside/rera/" class="hover:text-champagne transition-colors">Possession Timeline: June 2028</a></li>
              <li><a href="/mantra-meridian-riverside/documents/" class="hover:text-champagne transition-colors">Sanctioned Plans &amp; Official Brochure</a></li>
            </ul>
          </div>

          {/* Column 5: Comparative Intelligence & Infrastructure */}
          <div class="space-y-2">
            <p class="text-[10.5px] uppercase font-mono text-architectural-white font-medium tracking-wide">Comparisons &amp; Landmarks</p>
            <ul class="space-y-1.5 text-concrete/70">
              <li><a href="/mantra-meridian-riverside/journal/kumar-magnacity-vs-mantra-meridian-riverside-comparison/" class="hover:text-champagne transition-colors">Mantra Meridian vs Competing Projects</a></li>
              <li><a href="/mantra-meridian-riverside/journal/balewadi-vs-baner-real-estate-comparison/" class="hover:text-champagne transition-colors">Balewadi vs Baner Comparison</a></li>
              <li><a href="/mantra-meridian-riverside/location/" class="hover:text-champagne transition-colors">PMRDA Metro Line 3 Connectivity</a></li>
              <li><a href="/mantra-meridian-riverside/riverside/" class="hover:text-champagne transition-colors">Mula Riverfront Development (RFD)</a></li>
              <li><a href="/mantra-meridian-riverside/location/" class="hover:text-champagne transition-colors">Near Cummins India Campus Balewadi</a></li>
              <li><a href="/mantra-meridian-riverside/location/" class="hover:text-champagne transition-colors">Near Jupiter Hospital Baner</a></li>
              <li><a href="/mantra-meridian-riverside/price/" class="hover:text-champagne transition-colors">Verified Buyer Reviews 4.9★</a></li>
              <li><a href={`https://wa.me/${projectData.contact.whatsapp.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(projectData.contact.whatsappEnquiryText)}`} target="_blank" rel="noopener noreferrer" class="hover:text-champagne transition-colors">Official WhatsApp Concierge Desk</a></li>
            </ul>
          </div>

        </div>
      </nav>

      <p class="text-[11px] pt-2 leading-relaxed text-concrete/70 legal-disclaimer" data-nosnippet>
        <strong class="text-concrete/90">Statutory Legal Disclaimer:</strong> {projectData.disclaimer}
      </p>
    </div>

    {/* Bottom Copyright & Colophon */}
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-[11px] text-concrete/50">
      <div>
        © {new Date().getFullYear()} Mantra Properties. All Rights Reserved. Mantra Meridian Riverside (`MMR-BL-001`).
      </div>
      <nav aria-label="Legal and Compliance Links" class="flex flex-wrap items-center gap-6">
        <a href="/privacy-policy/" class="hover:text-champagne transition-colors">Privacy Policy</a>
        <a href="/terms/" class="hover:text-champagne transition-colors">Terms of Use</a>
        <a href="/disclaimer/" class="hover:text-champagne transition-colors">Statutory Disclaimer</a>
        <a href="/mantra-meridian-riverside/rera/" class="hover:text-champagne transition-colors">MahaRERA Compliance</a>
      </nav>
    </div>

  </div>
</footer>

<script>
  const footerBtn = document.getElementById('footer-presentation-trigger');
  footerBtn?.addEventListener('click', () => {
    window.dispatchEvent(
      new CustomEvent('open-private-presentation', {
        detail: { config: 'General Inquiries', intent: 'PRIVATE PRESENTATION' }
      })
    );
  });
</script>
