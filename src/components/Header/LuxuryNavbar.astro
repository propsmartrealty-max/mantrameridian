---
import DualBrandLockup from '../Brand/DualBrandLockup.astro';
import { projectData } from '../../data/project';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

// Curated 6 primary links for clean, spacious desktop breathing room
const primaryNavLinks = [
  { label: 'RESIDENCES', href: '/mantra-meridian-riverside/residences' },
  { label: 'FLOOR PLANS', href: '/mantra-meridian-riverside/floor-plans' },
  { label: 'PRICING', href: '/mantra-meridian-riverside/price' },
  { label: 'AMENITIES', href: '/mantra-meridian-riverside/amenities' },
  { label: 'LOCATION', href: '/mantra-meridian-riverside/location' },
  { label: 'GALLERY', href: '/mantra-meridian-riverside/gallery' },
];

// Secondary exploration links housed in an elegant luxury dropdown
const exploreDropdownLinks = [
  { label: 'The Riverside Story', href: '/mantra-meridian-riverside/riverside', desc: '500m river boardwalk & biophilic calm' },
  { label: '8-Acre Masterplan', href: '/mantra-meridian-riverside/masterplan', desc: 'Podium layout & tower zoning' },
  { label: 'Pune Real Estate Index', href: '/pune-real-estate', desc: 'Citywide luxury benchmark & yields' },
  { label: 'Balewadi Real Estate Hub', href: '/balewadi', desc: 'Micromarket guide & High Street' },
  { label: 'West Pune Luxury Guide', href: '/west-pune', desc: 'Baner & Hinjewadi corridor analysis' },
  { label: 'The Meridian Journal', href: '/mantra-meridian-riverside/journal', desc: 'Architectural essays & market insights' },
  { label: 'MahaRERA Compliance', href: '/mantra-meridian-riverside/rera', desc: 'Registration P52100045688 & filings' },
  { label: 'Document Library', href: '/mantra-meridian-riverside/documents', desc: 'Download official brochure PDF' },
];
---

<header id="luxury-navbar" class="fixed top-0 left-0 right-0 z-40 transition-all duration-500 py-4 sm:py-5 px-5 sm:px-8 md:px-12">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    
    {/* Intelligent Dual Brand Lockup: Mantra Properties & Meridian Riverside */}
    <DualBrandLockup variant="navbar" />

    {/* Center Navigation Links (Google Standard Font Sizes: text-[13px]) */}
    <nav class="hidden lg:flex items-center gap-6 xl:gap-8 text-[13px] font-mono tracking-[0.12em] text-concrete font-medium">
      {primaryNavLinks.map((link) => (
        <a
          href={link.href}
          class={`transition-colors duration-300 hover:text-champagne relative py-1.5 ${
            currentPath.startsWith(link.href) ? 'text-champagne font-semibold' : ''
          }`}
        >
          {link.label}
          {currentPath.startsWith(link.href) && (
            <span class="absolute bottom-0 left-0 right-0 h-[2px] bg-champagne shadow-glow" />
          )}
        </a>
      ))}

      {/* Discover Dropdown */}
      <div class="relative group py-1.5">
        <button
          id="discover-menu-trigger"
          class="flex items-center gap-1.5 text-concrete hover:text-champagne transition-colors duration-300 uppercase focus:outline-none text-[13px] font-medium"
          aria-haspopup="true"
          aria-expanded="false"
        >
          <span>EXPLORE</span>
          <span class="text-xs text-champagne transition-transform duration-300 group-hover:rotate-180">▾</span>
        </button>

        {/* Dropdown Menu Glass Panel */}
        <div class="absolute top-full right-0 mt-2 w-80 bg-obsidian-deep/98 border border-champagne/30 shadow-2xl backdrop-blur-2xl p-3.5 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
          <div class="text-[10px] uppercase tracking-[0.22em] text-champagne font-mono px-3 py-1.5 border-b border-white/10 font-semibold">
            ESTATE DIRECTORY
          </div>
          <div class="py-1.5 space-y-1">
            {exploreDropdownLinks.map((item) => (
              <a
                href={item.href}
                class="block px-3 py-2.5 hover:bg-white/5 transition-colors group/item"
              >
                <div class="text-sm text-architectural-white group-hover/item:text-champagne transition-colors font-medium flex items-center justify-between">
                  <span>{item.label}</span>
                  <span class="text-xs text-champagne opacity-0 group-hover/item:opacity-100 transition-opacity">→</span>
                </div>
                <div class="text-xs text-concrete/70 font-sans line-clamp-1 mt-0.5">
                  {item.desc}
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </nav>

    {/* Right Action CTA & Mobile Menu Toggle */}
    <div class="flex items-center gap-3 sm:gap-4">
      <a
        href={`https://wa.me/${projectData.contact.whatsapp.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(projectData.contact.whatsappEnquiryText)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-2 px-3.5 py-2 text-xs font-mono tracking-[0.12em] uppercase border border-emerald-500/40 bg-obsidian-surface/90 text-emerald-400 hover:bg-emerald-500 hover:text-obsidian transition-all duration-300 shadow-sm min-h-[42px]"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
        </svg>
        <span>WHATSAPP</span>
        <span>↗</span>
      </a>

      <button
        id="desktop-enquire-btn"
        class="hidden sm:inline-flex items-center gap-2 px-4 py-2 text-xs font-mono tracking-[0.14em] uppercase border border-champagne/40 bg-obsidian-surface/90 text-architectural-white hover:bg-champagne hover:text-obsidian transition-all duration-300 shadow-sm min-h-[42px]"
      >
        <span>PRIVATE PRESENTATION</span>
        <span class="text-champagne group-hover:text-obsidian text-sm font-semibold">↗</span>
      </button>

      {/* Mobile Hamburger (Google Standard 48x48px Touch Target) */}
      <button
        id="mobile-menu-toggle"
        class="lg:hidden min-w-[48px] min-h-[48px] flex items-center justify-center p-3 text-architectural-white border border-white/15 bg-obsidian-card/90 hover:border-champagne/50 transition-colors"
        aria-label="Toggle navigation menu"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

  </div>

  {/* Mobile Menu Slide-down Overlay (Google Standard Typography & Touch Targets) */}
  <div id="mobile-menu" class="hidden fixed inset-0 top-[72px] sm:top-[76px] bg-obsidian-deep/98 backdrop-blur-2xl z-30 p-5 sm:p-8 border-t border-white/10 overflow-y-auto pb-36">
    <div class="space-y-8 max-w-lg mx-auto py-2">
      
      {/* Group 1: Residences & Blueprints */}
      <div class="space-y-3">
        <span class="text-xs tracking-[0.2em] text-champagne uppercase font-mono font-semibold block">RESIDENCES &amp; PRICING</span>
        <div class="grid grid-cols-2 gap-2.5">
          <a href="/mantra-meridian-riverside/residences" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>All Formats</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/mantra-meridian-riverside/price" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>Price List</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/mantra-meridian-riverside/floor-plans" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>Floor Plans</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/mantra-meridian-riverside/3-bhk-duplex" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>Sky Duplex</span>
            <span class="text-champagne text-xs">→</span>
          </a>
        </div>
      </div>

      {/* Group 2: The Estate & Lifestyle */}
      <div class="space-y-3">
        <span class="text-xs tracking-[0.2em] text-champagne uppercase font-mono font-semibold block">THE ESTATE &amp; LIFESTYLE</span>
        <div class="grid grid-cols-2 gap-2.5">
          <a href="/mantra-meridian-riverside/amenities" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>30+ Amenities</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/mantra-meridian-riverside/riverside" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>Riverside Life</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/mantra-meridian-riverside/masterplan" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>8-Acres Plan</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/mantra-meridian-riverside/gallery" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>Photo Archive</span>
            <span class="text-champagne text-xs">→</span>
          </a>
        </div>
      </div>

      {/* Group 3: Location & Verification */}
      <div class="space-y-3">
        <span class="text-xs tracking-[0.2em] text-champagne uppercase font-mono font-semibold block">LOCATION &amp; VERIFICATION</span>
        <div class="grid grid-cols-2 gap-2.5">
          <a href="/mantra-meridian-riverside/location" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>Location Radar</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/balewadi" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>Balewadi Hub</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/mantra-meridian-riverside/rera" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>MahaRERA Doc</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/mantra-meridian-riverside/journal" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>The Journal</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/pune-real-estate" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between col-span-2 border-champagne/30 bg-champagne/5">
            <span>Pune Real Estate Index (2026–2030)</span>
            <span class="text-champagne text-xs font-semibold">→</span>
          </a>
        </div>
      </div>

      {/* Action Buttons (Full Width 50px Touch Targets) */}
      <div class="pt-4 space-y-3 border-t border-white/10">
        <button
          id="mobile-enquire-trigger"
          class="btn-luxury w-full min-h-[50px] text-xs font-mono tracking-[0.14em]"
        >
          REQUEST PRIVATE PRESENTATION ↗
        </button>
        <a
          href={`https://wa.me/${projectData.contact.whatsapp.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(projectData.contact.whatsappEnquiryText)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-luxury-outline w-full min-h-[50px] text-xs font-mono tracking-[0.14em] text-center flex items-center justify-center gap-2 border-emerald-500/40 text-emerald-400 hover:bg-emerald-500/10"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
          <span>WHATSAPP CONCIERGE: {projectData.contact.whatsapp}</span>
          <span>↗</span>
        </a>
        <a
          href={`tel:${projectData.contact.phone.replace(/\s+/g, '')}`}
          class="btn-luxury-outline w-full min-h-[50px] text-xs font-mono tracking-[0.14em] text-center flex items-center justify-center"
        >
          CALL CONCIERGE: {projectData.contact.phone}
        </a>
      </div>

      {/* Statutory Footer Badge */}
      <div class="pt-2 text-center text-xs text-concrete font-mono">
        MahaRERA: <span class="text-champagne font-semibold">{projectData.reraNumber}</span> • Balewadi, Pune
      </div>

    </div>
  </div>
</header>

<script>
  // Dynamic scroll glassmorphism
  const navbar = document.getElementById('luxury-navbar');
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const desktopEnquire = document.getElementById('desktop-enquire-btn');
  const mobileEnquire = document.getElementById('mobile-enquire-trigger');

  const onScroll = () => {
    if (window.scrollY > 30) {
      navbar?.classList.add('bg-obsidian/95', 'backdrop-blur-xl', 'py-3', 'border-b', 'border-champagne/20', 'shadow-luxury');
      navbar?.classList.remove('py-4', 'sm:py-5');
    } else {
      navbar?.classList.remove('bg-obsidian/95', 'backdrop-blur-xl', 'py-3', 'border-b', 'border-champagne/20', 'shadow-luxury');
      navbar?.classList.add('py-4', 'sm:py-5');
    }
  };

  window.addEventListener('scroll', onScroll);
  onScroll();

  // Mobile menu toggle with body scroll locking
  mobileToggle?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.toggle('hidden');
    if (!isHidden) {
      document.body.style.overflow = 'hidden';
    } else {
      document.body.style.overflow = '';
    }
  });

  // Open presentation drawer event triggers
  const triggerPresentation = () => {
    mobileMenu?.classList.add('hidden');
    document.body.style.overflow = '';
    window.dispatchEvent(
      new CustomEvent('open-private-presentation', {
        detail: { config: 'All Configurations', intent: 'PRIVATE PRESENTATION' }
      })
    );
  };

  desktopEnquire?.addEventListener('click', triggerPresentation);
  mobileEnquire?.addEventListener('click', triggerPresentation);
</script>
