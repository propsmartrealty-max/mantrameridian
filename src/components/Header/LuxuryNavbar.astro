</header>

<script>
  // Dynamic scroll glassmorphism & subtle elevation without dark background collision
  const navbar = document.getElementById('luxury-navbar');
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const desktopEnquire = document.getElementById('desktop-enquire-btn');
  const mobileEnquire = document.getElementById('mobile-enquire-trigger');

  const onScroll = () => {
    if (window.scrollY > 20) {
      navbar?.classList.add('shadow-[0_12px_40px_rgba(40,30,20,0.12)]', 'border-[#D9CFC1]', 'bg-[#FAF7F2]/98');
      navbar?.classList.remove('bg-[#FAF7F2]/95');
    } else {
      navbar?.classList.remove('shadow-[0_12px_40px_rgba(40,30,20,0.12)]', 'border-[#D9CFC1]', 'bg-[#FAF7F2]/98');
      navbar?.classList.add('bg-[#FAF7F2]/95');
    }
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Robust Explore Mega Dropdown Interactive Controller (Hover + Click Toggle + Outside Click)
  const discoverContainer = document.getElementById('discover-menu-container');
  const discoverTrigger = document.getElementById('discover-menu-trigger');
  const discoverDropdown = document.getElementById('discover-menu-dropdown');
  const discoverChevron = document.getElementById('discover-chevron');

  let isDropdownOpen = false;

  const setDropdownState = (open: boolean) => {
    isDropdownOpen = open;
    discoverTrigger?.setAttribute('aria-expanded', String(open));
    if (open) {
      discoverDropdown?.classList.remove('opacity-0', 'invisible', 'pointer-events-none');
      discoverDropdown?.classList.add('opacity-100', 'visible', 'pointer-events-auto');
      discoverChevron?.classList.add('rotate-180');
      discoverTrigger?.classList.add('text-champagne', 'bg-black/[0.04]');
    } else {
      discoverDropdown?.classList.add('opacity-0', 'invisible', 'pointer-events-none');
      discoverDropdown?.classList.remove('opacity-100', 'visible', 'pointer-events-auto');
      discoverChevron?.classList.remove('rotate-180');
      discoverTrigger?.classList.remove('text-champagne', 'bg-black/[0.04]');
    }
  };

  discoverTrigger?.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    setDropdownState(!isDropdownOpen);
  });

  discoverContainer?.addEventListener('mouseenter', () => {
    setDropdownState(true);
  });

  discoverContainer?.addEventListener('mouseleave', () => {
    setDropdownState(false);
  });

  document.addEventListener('click', (e) => {
    if (isDropdownOpen && discoverContainer && !discoverContainer.contains(e.target as Node)) {
      setDropdownState(false);
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isDropdownOpen) {
      setDropdownState(false);
      discoverTrigger?.focus();
    }
  });

  // Mobile menu toggle with body scroll locking
  mobileToggle?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.toggle('hidden');
    if (!isHidden) {
      document.body.style.overflow = 'hidden';
    } else {
      document.body.style.overflow = '';
    }
  });

  // Open presentation drawer event triggers
  const triggerPresentation = () => {
    mobileMenu?.classList.add('hidden');
    document.body.style.overflow = '';
    window.dispatchEvent(
      new CustomEvent('open-private-presentation', {
        detail: { config: 'All Configurations', intent: 'PRIVATE PRESENTATION' }
      })
    );
  };

  desktopEnquire?.addEventListener('click', triggerPresentation);
  mobileEnquire?.addEventListener('click', triggerPresentation);
</script>
