---
import DualBrandLockup from '../Brand/DualBrandLockup.astro';
import { projectData } from '../../data/project';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

// Secondary exploration links organized into 2 curated luxury columns (Living Spaces vs Corridors & Due Diligence)
const exploreColLiving = [
  { label: 'Explore Master Directory', href: '/explore/', desc: 'Master programmatic topic & knowledge graph' },
  { label: 'Balewadi Real Estate Hub', href: '/balewadi/', desc: 'Micromarket price trends, yields & High Street' },
  { label: 'Signature Sky Duplexes', href: '/duplex/', desc: '20-ft ceiling living salon from ₹2.25 Cr*' },
  { label: 'Penthouse & Sky Villas', href: '/penthouse/', desc: '4 BHK Grand Estates with wrap-around decks' },
  { label: 'Sanctioned Floor Plans', href: '/mantra-meridian-riverside/floor-plans/', desc: '2, 3, 3 Duplex & 4 BHK layouts' },
  { label: '8-Acre Masterplan', href: '/mantra-meridian-riverside/masterplan/', desc: 'Podium layout, towers & 500m promenade' },
  { label: 'The Riverside Story', href: '/mantra-meridian-riverside/riverside/', desc: '500m river boardwalk & biophilic calm' },
];

const exploreColCorridors = [
  { label: 'GPS Driving Directions', href: '/directions/', desc: 'Turn-by-turn routes & in-car GPS links' },
  { label: 'Project Comparison Hub', href: '/compare/', desc: 'Mantra Meridian vs 24K Altura & Balmoral' },
  { label: 'Construction Milestones', href: '/construction-status/', desc: 'June 2028 RERA Mivan progress tracker' },
  { label: 'Home Loan & Bank APF', href: '/home-loan/', desc: 'SBI & HDFC APF & instant EMI calculator' },
  { label: 'Global NRI Desk', href: '/nri-desk/', desc: 'Multi-currency converter & FEMA guide' },
  { label: 'Hinjewadi Tech Corridor', href: '/hinjewadi/', desc: '12 mins to Phase 1 & Metro Line 3' },
  { label: 'Baner Luxury Corridor', href: '/baner/', desc: 'Upgrade to 8-acre estate from Baner' },
];
---

<header id="luxury-navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-[#FAF7F2]/95 backdrop-blur-xl border-b border-[#E5DACB] shadow-[0_4px_25px_rgba(40,30,20,0.06)] px-4 sm:px-6 lg:px-8 group">
  <div class="max-w-7xl mx-auto h-20 transition-[height] duration-300 flex items-center justify-between gap-4 navbar-inner">
    
    {/* Intelligent Dual Brand Lockup: Mantra Properties & Meridian Riverside */}
    <div class="shrink-0 flex items-center">
      <DualBrandLockup variant="navbar" />
    </div>

    {/* Center Navigation Links (High-Contrast Pearl & Gold typography with Apple Glass Capsules) */}
    <nav aria-label="Main Navigation" class="hidden lg:flex items-center gap-1 xl:gap-2 text-[13px] font-mono tracking-[0.12em] font-semibold shrink-0">
      <a
        href="/mantra-meridian-riverside/residences/"
        class={`transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:text-champagne hover:bg-black/[0.04] active:scale-95 px-3 py-1.5 rounded-full relative whitespace-nowrap ${
          currentPath.startsWith('/mantra-meridian-riverside/residences') ? 'text-champagne font-bold bg-champagne/10' : 'text-[#161412]'
        }`}
      >
        RESIDENCES
        {currentPath.startsWith('/mantra-meridian-riverside/residences') && (
          <span class="absolute bottom-1 left-3 right-3 h-[2px] bg-gradient-to-r from-transparent via-champagne to-transparent shadow-glow" />
        )}
      </a>
      <a
        href="/mantra-meridian-riverside/floor-plans/"
        class={`transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:text-champagne hover:bg-black/[0.04] active:scale-95 px-3 py-1.5 rounded-full relative whitespace-nowrap ${
          currentPath.startsWith('/mantra-meridian-riverside/floor-plans') ? 'text-champagne font-bold bg-champagne/10' : 'text-[#161412]'
        }`}
      >
        FLOOR PLANS
        {currentPath.startsWith('/mantra-meridian-riverside/floor-plans') && (
          <span class="absolute bottom-1 left-3 right-3 h-[2px] bg-gradient-to-r from-transparent via-champagne to-transparent shadow-glow" />
        )}
      </a>
      <a
        href="/mantra-meridian-riverside/price/"
        class={`transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:text-champagne hover:bg-black/[0.04] active:scale-95 px-3 py-1.5 rounded-full relative whitespace-nowrap ${
          currentPath.startsWith('/mantra-meridian-riverside/price') ? 'text-champagne font-bold bg-champagne/10' : 'text-[#161412]'
        }`}
      >
        PRICING
        {currentPath.startsWith('/mantra-meridian-riverside/price') && (
          <span class="absolute bottom-1 left-3 right-3 h-[2px] bg-gradient-to-r from-transparent via-champagne to-transparent shadow-glow" />
        )}
      </a>
      <a
        href="/mantra-meridian-riverside/amenities/"
        class={`hidden xl:block transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:text-champagne hover:bg-black/[0.04] active:scale-95 px-3 py-1.5 rounded-full relative whitespace-nowrap ${
          currentPath.startsWith('/mantra-meridian-riverside/amenities') ? 'text-champagne font-bold bg-champagne/10' : 'text-[#161412]'
        }`}
      >
        AMENITIES
        {currentPath.startsWith('/mantra-meridian-riverside/amenities') && (
          <span class="absolute bottom-1 left-3 right-3 h-[2px] bg-gradient-to-r from-transparent via-champagne to-transparent shadow-glow" />
        )}
      </a>
      <a
        href="/mantra-meridian-riverside/location/"
        class={`transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:text-champagne hover:bg-black/[0.04] active:scale-95 px-3 py-1.5 rounded-full relative whitespace-nowrap ${
          currentPath.startsWith('/mantra-meridian-riverside/location') ? 'text-champagne font-bold bg-champagne/10' : 'text-[#161412]'
        }`}
      >
        LOCATION
        {currentPath.startsWith('/mantra-meridian-riverside/location') && (
          <span class="absolute bottom-1 left-3 right-3 h-[2px] bg-gradient-to-r from-transparent via-champagne to-transparent shadow-glow" />
        )}
      </a>
      <a
        href="/mantra-meridian-riverside/gallery/"
        class={`hidden xl:block transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:text-champagne hover:bg-black/[0.04] active:scale-95 px-3 py-1.5 rounded-full relative whitespace-nowrap ${
          currentPath.startsWith('/mantra-meridian-riverside/gallery') ? 'text-champagne font-bold bg-champagne/10' : 'text-[#161412]'
        }`}
      >
        GALLERY
        {currentPath.startsWith('/mantra-meridian-riverside/gallery') && (
          <span class="absolute bottom-1 left-3 right-3 h-[2px] bg-gradient-to-r from-transparent via-champagne to-transparent shadow-glow" />
        )}
      </a>

      {/* Discover Dropdown */}
      <div id="discover-menu-container" class="relative group py-1.5">
        <button
          id="discover-menu-trigger"
          class="flex items-center gap-1.5 text-[#161412] hover:text-champagne hover:bg-black/[0.04] active:scale-95 px-3 py-1.5 rounded-full transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] uppercase focus:outline-none text-[13px] font-semibold whitespace-nowrap cursor-pointer select-none"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="discover-menu-dropdown"
        >
          <span>EXPLORE</span>
          <span id="discover-chevron" class="text-xs text-champagne transition-transform duration-300 group-hover:rotate-180">▾</span>
        </button>

        {/* Dropdown Menu - 100% Solid Opaque White Panel, Zero Hover Gap Bridge, 2-Column Luxury Directory */}
        <div
          id="discover-menu-dropdown"
          class="absolute top-full right-0 pt-2 w-[620px] max-w-[94vw] opacity-0 invisible pointer-events-none group-hover:opacity-100 group-hover:visible group-hover:pointer-events-auto transition-all duration-200 ease-out z-[100] before:content-[''] before:absolute before:-top-3 before:left-0 before:right-0 before:h-4 before:block"
        >
          <div
            class="bg-white border border-[#DDD2C2] shadow-[0_25px_70px_rgba(30,20,10,0.22),0_4px_16px_rgba(0,0,0,0.06)] rounded-2xl p-4 sm:p-5 text-[#161412]"
            style="background-color: #FFFFFF !important;"
          >
            {/* Header */}
            <div class="text-[11px] uppercase tracking-[0.2em] text-champagne font-mono pb-3 border-b border-[#EADFCF] font-bold flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>ESTATE DIRECTORY &amp; KNOWLEDGE GRAPH</span>
              </div>
              <span class="text-[10px] text-[#6B6155] font-normal font-sans">MahaRERA P52100045688</span>
            </div>

            {/* 2-Column Luxury Directory Grid */}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1.5 py-3 max-h-[62vh] overflow-y-auto custom-scrollbar">
              {/* Column 1: Living Formats & Master Architecture */}
              <div class="space-y-1">
                <span class="text-[10px] font-mono tracking-wider uppercase text-[#8A7A68] px-2.5 font-bold block pb-1">Residences &amp; Architecture</span>
                {exploreColLiving.map((item) => (
                  <a
                    href={item.href}
                    class="block px-2.5 py-2 rounded-xl hover:bg-[#F5EFE6] transition-all duration-200 group/item active:scale-[0.98]"
                  >
                    <div class="text-[13px] text-[#161412] group-hover/item:text-champagne transition-colors font-medium flex items-center justify-between">
                      <span>{item.label}</span>
                      <span class="text-xs text-champagne opacity-0 group-hover/item:opacity-100 group-hover/item:translate-x-0.5 transition-all">→</span>
                    </div>
                    <div class="text-[11px] text-[#6B6155] font-sans mt-0.5 leading-snug">
                      {item.desc}
                    </div>
                  </a>
                ))}
              </div>

              {/* Column 2: Corridors, Advisory & Legal */}
              <div class="space-y-1">
                <span class="text-[10px] font-mono tracking-wider uppercase text-[#8A7A68] px-2.5 font-bold block pb-1">Corridors &amp; Due Diligence</span>
                {exploreColCorridors.map((item) => (
                  <a
                    href={item.href}
                    class="block px-2.5 py-2 rounded-xl hover:bg-[#F5EFE6] transition-all duration-200 group/item active:scale-[0.98]"
                  >
                    <div class="text-[13px] text-[#161412] group-hover/item:text-champagne transition-colors font-medium flex items-center justify-between">
                      <span>{item.label}</span>
                      <span class="text-xs text-champagne opacity-0 group-hover/item:opacity-100 group-hover/item:translate-x-0.5 transition-all">→</span>
                    </div>
                    <div class="text-[11px] text-[#6B6155] font-sans mt-0.5 leading-snug">
                      {item.desc}
                    </div>
                  </a>
                ))}
              </div>
            </div>

            {/* Footer Quick Links */}
            <div class="pt-3 border-t border-[#EADFCF] flex items-center justify-between text-xs text-[#6B6155] font-mono">
              <a href="/mantra-meridian-riverside/rera/" class="hover:text-champagne transition-colors flex items-center gap-1 text-[11px]">
                <span>Verified MahaRERA Docs</span>
                <span>→</span>
              </a>
              <a href="/mantra-meridian-riverside/documents/" class="hover:text-champagne transition-colors text-champagne font-semibold flex items-center gap-1 text-[11px]">
                <span>Official Brochure PDF</span>
                <span>↗</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </nav>

    {/* Right Action CTA & Mobile Menu Toggle */}
    <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">
      <a
        href={`https://wa.me/${projectData.contact.whatsapp.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(projectData.contact.whatsappEnquiryText)}`}
        target="_blank"
        rel="noopener noreferrer"
        title="Chat with Concierge on WhatsApp"
        class="hidden md:inline-flex items-center gap-2 px-3.5 py-2 text-xs font-mono tracking-[0.12em] uppercase border border-emerald-600/30 bg-emerald-50/80 hover:bg-emerald-600 hover:text-white text-emerald-800 font-semibold transition-all duration-300 shadow-sm min-h-[42px] shrink-0 rounded glass-pill"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
        </svg>
        <span class="hidden 2xl:inline">WHATSAPP</span>
      </a>

      <button
        id="desktop-enquire-btn"
        class="hidden sm:inline-flex items-center gap-2 px-5 py-2 text-xs font-mono tracking-[0.14em] uppercase btn-luxury shadow-glow min-h-[42px] shrink-0 glass-sheen"
      >
        <span>PRESENTATION</span>
        <span class="text-sm font-bold">↗</span>
      </button>

      {/* Mobile Hamburger (Google Standard 48x48px Touch Target) */}
      <button
        id="mobile-menu-toggle"
        class="lg:hidden min-w-[44px] min-h-[44px] flex items-center justify-center p-2.5 text-[#161412] border border-[#DDD2C2] bg-white hover:border-champagne transition-colors shrink-0"
        aria-label="Toggle navigation menu"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

  </div>

  {/* Mobile Menu Slide-down Overlay (Google Standard Typography & Touch Targets) */}
  <div id="mobile-menu" class="hidden fixed inset-0 top-[80px] bg-[#FAF7F2] z-50 p-5 sm:p-8 border-t border-[#E5DACB] overflow-y-auto pb-36">
    <nav aria-label="Mobile Navigation" class="space-y-8 max-w-lg mx-auto py-2">
      
      {/* Group 1: Residences & Blueprints */}
      <div class="space-y-3">
        <span class="text-xs tracking-[0.2em] text-champagne uppercase font-mono font-semibold block">RESIDENCES &amp; PRICING</span>
        <div class="grid grid-cols-2 gap-2.5">
          <a href="/mantra-meridian-riverside/residences/" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>All Formats</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/mantra-meridian-riverside/price/" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>Price List</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/mantra-meridian-riverside/floor-plans/" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>Floor Plans</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/mantra-meridian-riverside/3-bhk-duplex/" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>Sky Duplex</span>
            <span class="text-champagne text-xs">→</span>
          </a>
        </div>
      </div>

      {/* Group 2: The Estate & Lifestyle */}
      <div class="space-y-3">
        <span class="text-xs tracking-[0.2em] text-champagne uppercase font-mono font-semibold block">THE ESTATE &amp; LIFESTYLE</span>
        <div class="grid grid-cols-2 gap-2.5">
          <a href="/mantra-meridian-riverside/amenities/" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>30+ Amenities</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/mantra-meridian-riverside/riverside/" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>Riverside Life</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/mantra-meridian-riverside/masterplan/" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>8-Acres Plan</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/mantra-meridian-riverside/gallery/" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>Photo Archive</span>
            <span class="text-champagne text-xs">→</span>
          </a>
        </div>
      </div>

      {/* Group 3: Location & Verification */}
      <div class="space-y-3">
        <span class="text-xs tracking-[0.2em] text-champagne uppercase font-mono font-semibold block">LOCATION &amp; VERIFICATION</span>
        <div class="grid grid-cols-2 gap-2.5">
          <a href="/mantra-meridian-riverside/location/" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>Location Radar</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/balewadi/" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>Balewadi Hub</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/mantra-meridian-riverside/rera/" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>MahaRERA Doc</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/mantra-meridian-riverside/journal/" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>The Journal</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/pune-real-estate/" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between col-span-2 border-champagne/30 bg-champagne/5">
            <span>Pune Real Estate Index (2026–2030)</span>
            <span class="text-champagne text-xs font-semibold">→</span>
          </a>
        </div>
      </div>

      {/* Group 4: Regional Corridors & Financial Advisory */}
      <div class="space-y-3">
        <span class="text-xs tracking-[0.2em] text-champagne uppercase font-mono font-semibold block">CORRIDORS &amp; ADVISORY</span>
        <div class="grid grid-cols-2 gap-2.5">
          <a href="/hinjewadi/" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>Hinjewadi Hub</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/baner/" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>Baner Upgrade</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/mahalunge/" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>Mahalunge Hub</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/nri-desk/" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>Global NRI Desk</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/duplex/" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>Sky Duplexes</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/penthouse/" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>Penthouses</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/directions/" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>GPS Directions</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/compare/" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>Compare Projects</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/construction-status/" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>Construction</span>
            <span class="text-champagne text-xs">→</span>
          </a>
          <a href="/home-loan/" class="p-4 min-h-[54px] glass-card-luxury text-sm text-architectural-white font-medium hover:text-champagne transition-colors flex items-center justify-between">
            <span>Home Loan &amp; APF</span>
            <span class="text-champagne text-xs">→</span>
          </a>
        </div>
      </div>

      {/* Action Buttons (Full Width 50px Touch Targets) */}
      <div class="pt-4 space-y-3 border-t border-white/10">
        <button
          id="mobile-enquire-trigger"
          class="btn-luxury w-full min-h-[50px] text-xs font-mono tracking-[0.14em]"
        >
          REQUEST PRIVATE PRESENTATION ↗
        </button>
        <a
          href={`https://wa.me/${projectData.contact.whatsapp.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(projectData.contact.whatsappEnquiryText)}`}
          target="_blank"
          rel="noopener noreferrer"
