---
import { projectData } from '../../data/project';
---

<section class="relative w-full h-screen min-h-[700px] flex items-center justify-center overflow-hidden bg-obsidian-deep">
  
  {/* Cinematic Ambient Background Image / Video Backdrop */}
  <div class="absolute inset-0 z-0 select-none">
    <img
      src={projectData.heroSliderImages[0]}
      alt="Mantra Meridian Riverside Balewadi Architecture"
      class="w-full h-full object-cover object-center filter brightness-[0.70] contrast-[1.05] scale-105"
    />
    {/* Cinematic Multi-layered Vignette & Dark Veil */}
    <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-obsidian/30 to-obsidian/70" />
    <div class="absolute inset-0 bg-radial-vignette" />
  </div>

  {/* Hero Content Container */}
  <div class="relative z-10 max-w-5xl mx-auto px-6 text-center flex flex-col items-center justify-center space-y-6 md:space-y-8 pt-20">
    
    {/* Architectural Location & Accreditation Tag */}
    <div class="glass-pill inline-flex items-center gap-3 px-5 py-2 border border-champagne/35 text-champagne shadow-glow">
      <span class="w-2 h-2 rounded-full bg-champagne animate-pulse" />
      <span class="label-architectural text-[10px] sm:text-xs tracking-[0.24em] text-champagne">
        MANTRA PROPERTIES • RIVERSIDE SANCTUARY • BALEWADI
      </span>
    </div>

    {/* Monumental Typography with Ambient Backglow */}
    <div class="relative space-y-3">
      {/* Ambient Gold Radial Bloom behind heading */}
      <div class="absolute -inset-x-20 -inset-y-10 bg-radial-dusk opacity-70 blur-2xl pointer-events-none -z-10" />

      <h1 class="font-display text-5xl sm:text-7xl md:text-8xl lg:text-9xl tracking-[0.12em] leading-none text-gradient-pearl font-normal drop-shadow-2xl">
        MERIDIAN
      </h1>
      <div class="flex items-center justify-center gap-3 text-champagne font-mono text-[11px] sm:text-xs tracking-[0.35em] uppercase">
        <span class="h-[1px] w-8 sm:w-16 bg-gradient-to-r from-transparent via-champagne to-transparent" />
        <span class="font-medium tracking-[0.28em]">RIVERSIDE RESIDENCES</span>
        <span class="h-[1px] w-8 sm:w-16 bg-gradient-to-r from-transparent via-champagne to-transparent" />
      </div>
      <p class="font-serif text-2xl sm:text-3xl md:text-4xl text-champagne-light italic font-light tracking-wide pt-2">
        Life, Reimagined by the Living Waters.
      </p>
    </div>

    {/* Restrained Project Subtitle */}
    <p class="max-w-2xl text-xs sm:text-sm text-concrete leading-relaxed font-normal">
      An 8-acre contemporary architectural address in Balewadi. Offering 2, 3, 4 BHK luxury residences and signature 3 BHK sky duplexes beside the permanent serenity of the Mula river.
    </p>

    {/* Hero Actions with Glassmorphism */}
    <div class="flex flex-col sm:flex-row items-center gap-4 pt-4 w-full sm:w-auto">
      <a
        href="#experience-manifesto"
        class="btn-luxury w-full sm:w-auto text-xs glass-sheen"
      >
        <span>DISCOVER MERIDIAN</span>
        <span>↓</span>
      </a>

      <button
        id="hero-presentation-btn"
        class="btn-luxury-outline w-full sm:w-auto text-xs glass-sheen"
      >
        <span>PRIVATE PRESENTATION</span>
        <span class="text-champagne">↗</span>
      </button>
    </div>

    {/* MahaRERA Statutory Pill */}
    <div class="pt-6 flex justify-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-obsidian-card/70 border border-white/10 backdrop-blur-md text-xs text-concrete/80 font-sans">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="text-[11px] tracking-wider uppercase text-concrete/70">MahaRERA:</span>
        <a 
          href={projectData.reraRegistrationUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="font-mono text-champagne tracking-[0.14em] font-semibold text-xs hover:underline"
        >
          {projectData.reraNumber}
        </a>
        <span class="text-white/20 mx-1">•</span>
        <span class="text-[11px] tracking-wider uppercase text-concrete/70">8-Acre Riverside Estate</span>
      </div>
    </div>

  </div>

  {/* Bottom Scroll Indicator */}
  <div class="absolute bottom-8 left-8 hidden md:flex items-center gap-3 text-concrete/50 text-[10px] font-mono tracking-widest uppercase">
    <div class="w-8 h-[1px] bg-champagne/40" />
    <span>SCROLL TO DISCOVER</span>
  </div>

  <div class="absolute bottom-8 right-8 hidden md:flex items-center gap-3 text-concrete/50 text-[10px] font-mono tracking-widest uppercase">
    <a
      href={projectData.googleMapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="hover:text-champagne transition-colors flex items-center gap-1.5"
    >
      <span>LAT 18.5839° N • LONG 73.7747° E</span>
      <span class="text-champagne">↗</span>
    </a>
  </div>

</section>

<script>
  const heroBtn = document.getElementById('hero-presentation-btn');
  heroBtn?.addEventListener('click', () => {
    window.dispatchEvent(
      new CustomEvent('open-private-presentation', {
        detail: { config: 'All Residences', intent: 'HERO DISCOVERY' }
      })
    );
  });
</script>
