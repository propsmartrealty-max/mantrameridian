---
import { projectData } from '../../data/project';
---

<div class="w-full bg-obsidian-card border border-champagne/30 p-6 md:p-10 relative overflow-hidden">
  <div class="absolute -right-16 -top-16 w-48 h-48 rounded-full bg-champagne/5 pointer-events-none" />

  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8">
    
    <div class="space-y-4 max-w-2xl">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse" />
        <span class="label-architectural text-xs text-champagne">OFFICIAL STATUTORY COMPLIANCE</span>
      </div>

      <h2 class="font-serif text-2xl md:text-4xl text-architectural-white">
        MahaRERA Registration: {projectData.reraNumber}
      </h2>

      <p class="text-xs text-concrete leading-relaxed">
        Mantra Meridian Riverside is an ongoing registered project under the Real Estate (Regulation and Development) Act, 2016. Every configuration, sanctioned building layout, environmental clearance, and land title has been verified and registered with the Maharashtra Real Estate Regulatory Authority.
      </p>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-2 text-xs">
        <div class="border-l border-champagne/30 pl-3">
          <span class="text-[10px] uppercase text-concrete/70 block">Project Status</span>
          <span class="text-architectural-white font-medium">Ongoing / Approved</span>
        </div>
        <div class="border-l border-champagne/30 pl-3">
          <span class="text-[10px] uppercase text-concrete/70 block">Registered Land</span>
          <span class="text-architectural-white font-medium">8 Acres Riverside</span>
        </div>
        <div class="border-l border-champagne/30 pl-3">
          <span class="text-[10px] uppercase text-concrete/70 block">Authority</span>
          <span class="text-architectural-white font-medium">MahaRERA, Govt of MH</span>
        </div>
        <div class="border-l border-champagne/30 pl-3">
          <span class="text-[10px] uppercase text-concrete/70 block">Developer</span>
          <span class="text-architectural-white font-medium">Mantra Properties</span>
        </div>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row items-center gap-4 shrink-0">
      <div class="w-24 h-24 bg-white p-1.5 border border-champagne/30 shrink-0 shadow-md">
        <img
          src="/assets/mantra-meridian-rera-qr.webp"
          alt="MahaRERA Official Registration QR Code - Mantra Meridian"
          class="w-full h-full object-contain"
          width="96"
          height="96"
        />
      </div>

      <div class="flex flex-col gap-2.5 w-full sm:w-auto">
        <a
          href={projectData.reraRegistrationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-luxury text-xs text-center"
        >
          <span>VERIFY ON MAHARERA PORTAL</span>
          <span>↗</span>
        </a>

        <a
          href="/mantra-meridian-riverside/rera/"
          class="btn-luxury-outline text-xs text-center"
        >
          <span>VIEW RERA COMPLIANCE DOSSIER</span>
        </a>
      </div>
    </div>

  </div>
</div>
