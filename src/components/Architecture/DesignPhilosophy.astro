---
import { projectData } from '../../data/project';

const architecturalAnnotations = [
  {
    tag: "VERTICAL RHYTHM",
    title: "Staggered Tower Geometry",
    description: "Towers engineered with asymmetric setbacks to guarantee 100% privacy and unbroken diagonal river views without visual crossover."
  },
  {
    tag: "ACOUSTIC ENVELOPE",
    title: "Double-Glazed Curtain Glazing",
    description: "High-performance low-E structural glass damping outdoor sound down to 35 dB while insulating from midday tropical solar heat."
  },
  {
    tag: "DECK CANTILEVER",
    title: "8-Foot Deep Sky Balconies",
    description: "Deep structural overhangs acting as passive solar louvers that cast natural shade across living windows throughout the day."
  },
  {
    tag: "LANDSCAPE EDGE",
    title: "Riparian Buffer & Boardwalk",
    description: "75%+ open green estate with native riverside bio-swales, reflection pools, and 500 metres of private stone promenade."
  }
];
---

<section class="w-full bg-obsidian-deep py-24 md:py-32 border-b border-white/10">
  <div class="max-w-7xl mx-auto px-6 md:px-12 space-y-16">
    
    {/* Header */}
    <div class="max-w-3xl space-y-4">
      <span class="label-architectural text-xs text-champagne">STUDIO MERIDIAN</span>
      <h2 class="font-serif text-4xl sm:text-6xl text-architectural-white font-normal leading-[1.05]">
        Architecture<br />
        <span class="text-champagne font-light italic">in dialogue with nature.</span>
      </h2>
      <p class="text-xs sm:text-sm text-concrete leading-relaxed">
        Engineered with restraint. The elevations at Meridian eschew unnecessary ornamentation in favor of clean horizontal rhythms, noble materials, and profound glass expanses that frame the changing sky.
      </p>
    </div>

    {/* Big Architectural Focal Image with Blueprint Annotations */}
    <div class="relative w-full aspect-[16/9] overflow-hidden border border-champagne/20 shadow-luxury group">
      <img
        src={projectData.introImage}
        alt="Mantra Meridian Riverside Architectural Elevation"
        class="w-full h-full object-cover object-center filter brightness-90 contrast-105 group-hover:scale-105 transition-transform duration-1000"
      />
      
      {/* Blueprint Annotations Overlaid */}
      <div class="absolute inset-0 p-6 md:p-12 flex flex-col justify-between pointer-events-none">
        
        {/* Top Annotation */}
        <div class="self-end glass-dark p-3 border border-champagne/30 max-w-xs pointer-events-auto">
          <div class="text-[9px] font-mono text-champagne tracking-widest uppercase">ELEVATION ANNOTATION</div>
          <div class="font-serif text-sm text-architectural-white mt-0.5">Continuous Sky Terraces</div>
          <div class="text-[10px] text-concrete/80 font-mono mt-1">20ft Double-Height Voids in Sky Duplexes</div>
        </div>

        {/* Bottom Annotation */}
        <div class="self-start glass-dark p-3 border border-champagne/30 max-w-xs pointer-events-auto">
          <div class="text-[9px] font-mono text-champagne tracking-widest uppercase">GROUND MATRIX</div>
          <div class="font-serif text-sm text-architectural-white mt-0.5">Podium Greens &amp; Waterbodies</div>
          <div class="text-[10px] text-concrete/80 font-mono mt-1">Direct Walkway to Mula River Boardwalk</div>
        </div>

      </div>
    </div>

    {/* Four Pillars Grid */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 pt-4">
      {architecturalAnnotations.map((item) => (
        <div class="p-6 bg-obsidian-card border border-white/10 hover:border-champagne/30 transition-all space-y-3">
          <span class="label-architectural text-[9px] text-champagne block font-mono">
            {item.tag}
          </span>
          <h3 class="font-serif text-lg text-architectural-white">
            {item.title}
          </h3>
          <p class="text-xs text-concrete/80 leading-relaxed">
            {item.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
