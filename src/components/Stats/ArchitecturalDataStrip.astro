---
import { projectData } from '../../data/project';
---

<section class="w-full relative py-16 px-6 md:px-12 overflow-hidden bg-obsidian-surface/60 backdrop-blur-2xl">
  {/* Top Animated Luminous Divider Line */}
  <div class="animated-divider-line mb-12" />

  {/* Ambient Lighting Orbs */}
  <div class="absolute top-1/2 left-1/4 -translate-y-1/2 w-96 h-96 bg-beige/10 rounded-full blur-3xl pointer-events-none -z-10" />
  <div class="absolute top-1/2 right-1/4 -translate-y-1/2 w-96 h-96 bg-champagne/10 rounded-full blur-3xl pointer-events-none -z-10" />

  <div class="max-w-7xl mx-auto relative z-10">
    
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8 lg:gap-6 p-6 sm:p-10 card-beige-luxury border-animated-beam divide-y md:divide-y-0 md:divide-x divide-beige-border">
      {projectData.keyHighlights.map((stat, idx) => {
        const isRera = stat.label.includes('RERA') || stat.value.startsWith('P52');
        const isMultiConfig = stat.value.includes('/');

        return (
          <div class={`flex flex-col justify-between ${idx > 0 ? 'pt-6 md:pt-0 md:pl-6' : ''}`}>
            <div>
              {isRera ? (
                <div class="min-h-[44px] sm:min-h-[52px] lg:min-h-[56px] flex flex-col justify-end">
                  <div class="badge-beige mb-1.5 w-fit">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span class="text-[9px] uppercase tracking-[0.16em] text-beige-warm font-mono font-medium">REGISTERED</span>
                  </div>
                  <a
                    href={projectData.reraRegistrationUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-xs sm:text-sm lg:text-[15px] text-beige-warm font-semibold tracking-[0.12em] hover:text-champagne transition-colors block break-all"
                  >
                    {stat.value} ↗
                  </a>
                </div>
              ) : isMultiConfig ? (
                <span class="font-display text-2xl sm:text-3xl lg:text-[36px] text-gradient-beige font-normal tracking-tight block leading-tight">
                  {stat.value}
                </span>
              ) : (
                <span class="font-display text-3xl sm:text-4xl lg:text-5xl text-gradient-beige font-normal tracking-tight block">
                  {stat.value}
                </span>
              )}
              
              <span class="text-xs uppercase tracking-[0.2em] text-champagne font-mono font-medium block mt-2">
                {stat.label}*
              </span>
            </div>
            <p class="text-[11px] text-concrete leading-snug mt-3 font-light">
              {stat.sublabel}
            </p>
          </div>
        );
      })}
    </div>

    {/* Bottom Animated Luminous Divider Line */}
    <div class="animated-divider-line mt-12" />

    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-[11px] text-concrete font-sans">
      <span>*Subject to current project documentation &amp; sanctioned statutory approvals</span>
      <span class="mt-2 sm:mt-0 flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span>Official MahaRERA:</span>
        <a 
          href={projectData.reraRegistrationUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="font-mono text-champagne tracking-[0.12em] hover:underline font-semibold"
        >
          {projectData.reraNumber} ↗
        </a>
      </span>
    </div>

  </div>
</section>
