---
import { projectData } from '../../data/project';
---

<section class="w-full bg-obsidian-deep border-y border-white/10 py-16 px-6 md:px-12">
  <div class="max-w-7xl mx-auto">
    
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8 lg:gap-4 divide-y md:divide-y-0 md:divide-x divide-white/10">
      {projectData.keyHighlights.map((stat, idx) => (
        <div class={`flex flex-col justify-between ${idx > 0 ? 'pt-6 md:pt-0 md:pl-6' : ''}`}>
          <div>
            <span class="font-serif text-3xl sm:text-4xl lg:text-5xl text-architectural-white font-normal tracking-tight block">
              {stat.value}
            </span>
            <span class="text-xs uppercase tracking-[0.25em] text-champagne font-mono font-medium block mt-2">
              {stat.label}*
            </span>
          </div>
          <p class="text-[11px] text-concrete/70 leading-snug mt-3 font-light">
            {stat.sublabel}
          </p>
        </div>
      ))}
    </div>

    <div class="pt-8 mt-8 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between text-[10px] text-concrete/50 font-mono">
      <span>*SUBJECT TO CURRENT PROJECT DOCUMENTATION &amp; SANCTIONED STATUTORY APPROVALS</span>
      <span class="mt-2 sm:mt-0">OFFICIAL MAHARERA REGISTRATION: {projectData.reraNumber}</span>
    </div>

  </div>
</section>
