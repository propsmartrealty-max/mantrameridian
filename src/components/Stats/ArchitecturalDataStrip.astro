---
import { projectData } from '../../data/project';
---

<section class="w-full bg-obsidian-deep border-y border-white/10 py-16 px-6 md:px-12">
  <div class="max-w-7xl mx-auto">
    
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8 lg:gap-6 divide-y md:divide-y-0 md:divide-x divide-white/10">
      {projectData.keyHighlights.map((stat, idx) => {
        const isRera = stat.label.includes('RERA') || stat.value.startsWith('P52');
        const isMultiConfig = stat.value.includes('/');

        return (
          <div class={`flex flex-col justify-between ${idx > 0 ? 'pt-6 md:pt-0 md:pl-6' : ''}`}>
            <div>
              {isRera ? (
                <div class="min-h-[44px] sm:min-h-[52px] lg:min-h-[56px] flex flex-col justify-end">
                  <div class="inline-flex items-center gap-1.5 px-2 py-0.5 bg-champagne/10 border border-champagne/30 w-fit mb-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span class="text-[9px] uppercase tracking-[0.16em] text-champagne font-mono font-medium">REGISTERED</span>
                  </div>
                  <a
                    href={projectData.reraRegistrationUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-xs sm:text-sm lg:text-[15px] text-architectural-white font-semibold tracking-[0.12em] hover:text-champagne transition-colors block break-all"
                  >
                    {stat.value} ↗
                  </a>
                </div>
              ) : isMultiConfig ? (
                <span class="font-serif text-2xl sm:text-3xl lg:text-[38px] text-architectural-white font-normal tracking-tight block leading-tight">
                  {stat.value}
                </span>
              ) : (
                <span class="font-serif text-3xl sm:text-4xl lg:text-5xl text-architectural-white font-normal tracking-tight block">
                  {stat.value}
                </span>
              )}
              
              <span class="text-xs uppercase tracking-[0.2em] text-champagne font-mono font-medium block mt-2">
                {stat.label}*
              </span>
            </div>
            <p class="text-[11px] text-concrete/70 leading-snug mt-3 font-light">
              {stat.sublabel}
            </p>
          </div>
        );
      })}
    </div>

    <div class="pt-8 mt-8 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between text-[11px] text-concrete/60 font-sans">
      <span>*Subject to current project documentation &amp; sanctioned statutory approvals</span>
      <span class="mt-2 sm:mt-0 flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span>Official MahaRERA:</span>
        <a 
          href={projectData.reraRegistrationUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="font-mono text-champagne tracking-[0.12em] hover:underline font-semibold"
        >
          {projectData.reraNumber} ↗
        </a>
      </span>
    </div>

  </div>
</section>
