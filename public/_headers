# Cloudflare Pages — Edge Cache & Compression Headers
# https://developers.cloudflare.com/pages/configuration/headers/

# ============================================================
# STATIC ASSETS — Long-lived cache (1 year, immutable)
# ============================================================
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.woff
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

# ============================================================
# FEEDS & SITEMAPS — Short-lived cache (1 hour)
# ============================================================
/sitemap.xml
  Cache-Control: public, max-age=3600, s-maxage=3600
  Content-Type: application/xml; charset=utf-8

/sitemap-index.xml
  Cache-Control: public, max-age=3600, s-maxage=3600
  Content-Type: application/xml; charset=utf-8

/image-sitemap.xml
  Cache-Control: public, max-age=3600, s-maxage=3600
  Content-Type: application/xml; charset=utf-8

/video-sitemap.xml
  Cache-Control: public, max-age=3600, s-maxage=3600
  Content-Type: application/xml; charset=utf-8

/rss.xml
  Cache-Control: public, max-age=3600, s-maxage=3600
  Content-Type: application/rss+xml; charset=utf-8

/google-realestate.xml
  Cache-Control: public, max-age=3600, s-maxage=3600
  Content-Type: application/xml; charset=utf-8

/google-products.xml
  Cache-Control: public, max-age=3600, s-maxage=3600
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=86400, s-maxage=86400
  Content-Type: text/plain; charset=utf-8

/llms.txt
  Cache-Control: public, max-age=86400, s-maxage=86400
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Cache-Control: public, max-age=86400, s-maxage=86400
  Content-Type: text/plain; charset=utf-8

# ============================================================
# HTML PAGES — Edge-cached, revalidate on change (1 day CDN)
# Cloudflare will serve from edge, revalidate daily
# This converts cf-cache-status: DYNAMIC → HIT
# ============================================================
/
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=3600
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(self), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-DNS-Prefetch-Control: on
  Timing-Allow-Origin: *
  Accept-CH: Sec-CH-UA, Sec-CH-UA-Mobile, Sec-CH-UA-Platform, Sec-CH-DPR, Sec-CH-Width, Sec-CH-Viewport-Width

/mantra-meridian-riverside/
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=3600
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1
  X-Content-Type-Options: nosniff

/mantra-meridian-riverside-balewadi/
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=3600
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1

# All HTML pages — CDN cached for 24h, browser revalidates
/*
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=3600
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Timing-Allow-Origin: *
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Access-Control-Allow-Origin: *
